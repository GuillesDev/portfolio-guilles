<script>
  import { playSound, playRobotHurt } from '../lib/uiSound';

  // ── Scramble text reveal (original implementation) ──
  // Letters flicker through random glyphs before settling — terminal style.
  const GLYPHS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789<>/{}[]=+*#';

  function scrambleReveal(el: HTMLElement) {
    const original = el.dataset.scrambleText ?? el.textContent ?? '';
    el.dataset.scrambleText = original;
    const len = original.length;
    const duration = 700;
    const start = performance.now();

    function frame(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const settled = Math.floor(t * len);
      let out = original.slice(0, settled);
      for (let i = settled; i < len; i++) {
        out += original[i] === ' ' ? ' ' : GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
      }
      el.textContent = out;
      if (t < 1) requestAnimationFrame(frame);
      else el.textContent = original;
    }
    requestAnimationFrame(frame);
  }

  function initScramble() {
    const els = document.querySelectorAll<HTMLElement>('[data-scramble]');
    if (!els.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          scrambleReveal(entry.target as HTMLElement);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.5 });

    els.forEach((el) => io.observe(el));
  }

  // ── Editor typing reveal: lines appear sequentially ──
  function initEditor() {
    const editor = document.getElementById('code-editor');
    const status = document.getElementById('editor-status');
    if (!editor) return;

    const lines = editor.querySelectorAll<HTMLElement>('.editor__line');

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      lines.forEach((l) => l.classList.add('is-visible'));
      if (status) status.innerHTML = '<span class="editor__status-dot editor__status-dot--done" aria-hidden="true"></span>guardado';
      return;
    }

    lines.forEach((l) => l.classList.remove('is-visible'));
    const timers: number[] = [];
    // Al salir, la escritura no debe seguir modificando el editor retirado.
    document.addEventListener('astro:before-swap', () => {
      io.disconnect();
      timers.forEach(clearTimeout);
    }, { once: true });

    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        io.unobserve(entry.target);
        lines.forEach((line, i) => {
          timers.push(window.setTimeout(() => {
            line.classList.add('is-visible');
            // Una pulsación por línea: el editor escribe a golpe de intro.
            playSound('tecla');
            if (i === lines.length - 1 && status) {
              timers.push(window.setTimeout(() => {
                status.innerHTML = '<span class="editor__status-dot editor__status-dot--done" aria-hidden="true"></span>guardado';
                playSound('generado');
              }, 400));
            }
          }, 350 + i * 220));
        });
      });
    }, { threshold: 0.3 });

    io.observe(editor);
  }

  // ── Cursor glow in hero (desktop only) ──
  function initHeroGlow() {
    const glow = document.getElementById('hero-glow');
    if (!glow) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const hero = glow.closest('.dev-hero') as HTMLElement | null;
    if (!hero) return;

    let targetX = 0, targetY = 0, x = 0, y = 0;
    let raf = 0;
    let active = false;

    function loop() {
      x += (targetX - x) * 0.08;
      y += (targetY - y) * 0.08;
      glow!.style.transform = `translate(${x - 300}px, ${y - 300}px)`;
      raf = requestAnimationFrame(loop);
    }

    hero.addEventListener('pointermove', (e) => {
      const rect = hero.getBoundingClientRect();
      targetX = e.clientX - rect.left;
      targetY = e.clientY - rect.top;
      if (!active) {
        active = true;
        glow!.style.opacity = '1';
        x = targetX; y = targetY;
        loop();
      }
    });

    hero.addEventListener('pointerleave', () => {
      glow!.style.opacity = '0';
      active = false;
      cancelAnimationFrame(raf);
    });

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  }

  // ── 3D wireframe (Three.js, lazy-loaded) ──
  function initHero3D() {
    const mount = document.getElementById('hero-3d');
    if (!mount) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.innerWidth < 1025) return;

    const probe = document.createElement('canvas');
    if (!(probe.getContext('webgl2') || probe.getContext('webgl'))) return;

    let cleanup: (() => void) | null = null;
    let cancelled = false;

    const io = new IntersectionObserver(async (entries) => {
      const visible = entries[0]?.isIntersecting;
      if (visible && !cleanup) {
        io.disconnect();
        const dispose = await buildScene(mount, () => cancelled);
        // La importación puede terminar después de retirar esta página.
        if (cancelled) dispose();
        else cleanup = dispose;
      }
    }, { threshold: 0.1 });

    io.observe(mount);

    document.addEventListener('astro:before-swap', () => {
      cancelled = true;
      io.disconnect();
      cleanup?.();
      cleanup = null;
    }, { once: true });
  }

  async function buildScene(mount: HTMLElement, isCancelled: () => boolean): Promise<() => void> {
    const THREE = await import('three');
    if (isCancelled()) return () => {};

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 30);
    camera.position.z = 5.2;

    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    mount.appendChild(renderer.domElement);

    const group = new THREE.Group();
    scene.add(group);

    // Outer icosahedron — blueprint wireframe
    const outerGeo = new THREE.IcosahedronGeometry(1.85, 1);
    const outer = new THREE.LineSegments(
      new THREE.WireframeGeometry(outerGeo),
      new THREE.LineBasicMaterial({ color: 0xf1a93a, transparent: true, opacity: 0.3 })
    );
    group.add(outer);

    // Inner icosahedron — counter-rotating, fainter
    const innerGeo = new THREE.IcosahedronGeometry(1.05, 0);
    const inner = new THREE.LineSegments(
      new THREE.WireframeGeometry(innerGeo),
      new THREE.LineBasicMaterial({ color: 0xc7422e, transparent: true, opacity: 0.22 })
    );
    group.add(inner);

    // Vertex nodes
    const nodes = new THREE.Points(
      outerGeo,
      new THREE.PointsMaterial({ color: 0xf1a93a, size: 0.045, transparent: true, opacity: 0.8 })
    );
    group.add(nodes);

    function resize() {
      const w = mount.clientWidth || 1;
      const h = mount.clientHeight || 1;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(mount);

    // Mouse parallax
    let targetRX = 0, targetRY = 0;
    function onPointer(e: PointerEvent) {
      const nx = (e.clientX / window.innerWidth) * 2 - 1;
      const ny = (e.clientY / window.innerHeight) * 2 - 1;
      targetRY = nx * 0.35;
      targetRX = ny * 0.25;
    }
    window.addEventListener('pointermove', onPointer, { passive: true });

    let raf = 0;
    let running = true;
    const clock = new THREE.Clock();

    function tick() {
      if (!running) return;
      const t = clock.getElapsedTime();
      outer.rotation.y = t * 0.12;
      outer.rotation.x = Math.sin(t * 0.18) * 0.18;
      nodes.rotation.copy(outer.rotation);
      inner.rotation.y = -t * 0.2;
      inner.rotation.z = t * 0.08;
      group.rotation.x += (targetRX - group.rotation.x) * 0.04;
      group.rotation.y += (targetRY - group.rotation.y) * 0.04;
      group.position.y = Math.sin(t * 0.5) * 0.08;
      renderer.render(scene, camera);
      raf = requestAnimationFrame(tick);
    }

    // Pause when hero is off-screen or tab hidden
    const visIO = new IntersectionObserver((entries) => {
      const onScreen = entries[0]?.isIntersecting ?? false;
      if (onScreen && !running) { running = true; tick(); }
      else if (!onScreen) { running = false; cancelAnimationFrame(raf); }
    }, { threshold: 0.05 });
    visIO.observe(mount);

    function onVisibility() {
      if (document.hidden) { running = false; cancelAnimationFrame(raf); }
      else if (!running) { running = true; tick(); }
    }
    document.addEventListener('visibilitychange', onVisibility);

    tick();

    return () => {
      running = false;
      cancelAnimationFrame(raf);
      visIO.disconnect();
      ro.disconnect();
      window.removeEventListener('pointermove', onPointer);
      document.removeEventListener('visibilitychange', onVisibility);
      outerGeo.dispose();
      innerGeo.dispose();
      (outer.material as { dispose(): void }).dispose();
      (inner.material as { dispose(): void }).dispose();
      (nodes.material as { dispose(): void }).dispose();
      renderer.dispose();
      renderer.domElement.remove();
    };
  }

  // ── Robot mascot peeking over the editor ──
  function initEditorBot() {
    const mount = document.getElementById('editor-bot');
    if (!mount) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.innerWidth < 320) return;

    const probe = document.createElement('canvas');
    if (!(probe.getContext('webgl2') || probe.getContext('webgl'))) return;

    let cleanup: (() => void) | null = null;
    let cancelled = false;

    const io = new IntersectionObserver(async (entries) => {
      if (entries[0]?.isIntersecting && !cleanup) {
        io.disconnect();
        const dispose = await buildBot(mount, () => cancelled);
        if (cancelled) dispose();
        else cleanup = dispose;
      }
    }, { threshold: 0.1 });

    io.observe(mount);

    document.addEventListener('astro:before-swap', () => {
      cancelled = true;
      io.disconnect();
      cleanup?.();
      cleanup = null;
    }, { once: true });
  }

  async function buildBot(mount: HTMLElement, isCancelled: () => boolean): Promise<() => void> {
    const THREE = await import('three');
    const { RoundedBoxGeometry } = await import('three/addons/geometries/RoundedBoxGeometry.js');
    const { buildRobotRig } = await import('../lib/robotRig');
    if (isCancelled()) return () => {};

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.1, 20);
    camera.position.set(0, 0.62, 3.4);
    camera.lookAt(0, 0.55, 0);

    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    mount.appendChild(renderer.domElement);

    // Lights — warm Black Gum mood
    scene.add(new THREE.AmbientLight(0xfff4e0, 1.1));
    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(2, 3, 4);
    scene.add(key);
    const rim = new THREE.PointLight(0xf1a93a, 9, 10);
    rim.position.set(-2, 0.8, 2);
    scene.add(rim);

    const rig = buildRobotRig(THREE, RoundedBoxGeometry);
    const { robot, headGroup, eyeL, eyeR, eyesMat, armRPivot, antennaTip } = rig;
    scene.add(robot);

    function resize() {
      const w = mount.clientWidth || 1;
      const h = mount.clientHeight || 1;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(mount);

    // Gaze target from pointer + raycast picking (hit the robot with clicks)
    const raycaster = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    const editorEl = document.getElementById('code-editor');
    const heroEl = mount.closest('.dev-hero') as HTMLElement | null;

    function pickRobot(clientX: number, clientY: number): boolean {
      const rect = renderer.domElement.getBoundingClientRect();
      ndc.x = ((clientX - rect.left) / rect.width) * 2 - 1;
      ndc.y = -((clientY - rect.top) / rect.height) * 2 + 1;
      if (ndc.x < -1 || ndc.x > 1 || ndc.y < -1 || ndc.y > 1) return false;
      raycaster.setFromCamera(ndc, camera);
      return raycaster.intersectObject(robot, true).length > 0;
    }

    let gazeX = 0, gazeY = 0;
    function onPointer(e: PointerEvent) {
      gazeX = (e.clientX / window.innerWidth) * 2 - 1;
      gazeY = (e.clientY / window.innerHeight) * 2 - 1;
      // Pointer cursor when hovering the visible part of the robot
      if (heroEl) {
        const overEditor = !!editorEl && e.target instanceof Node && editorEl.contains(e.target);
        heroEl.style.cursor = !overEditor && pickRobot(e.clientX, e.clientY) ? 'pointer' : '';
      }
    }
    window.addEventListener('pointermove', onPointer, { passive: true });

    let pendingHit = false;
    function onClick(e: MouseEvent) {
      // Ignore clicks that land on the editor window (robot's hidden lower body)
      if (editorEl && e.target instanceof Node && editorEl.contains(e.target)) return;
      if (pickRobot(e.clientX, e.clientY)) pendingHit = true;
    }
    window.addEventListener('click', onClick);

    let raf = 0;
    let running = true;
    let nextBlink = 2.2;
    let blinkUntil = 0;
    // Damped spring driving the knock-back reaction
    let hitRot = 0;
    let hitVel = 0;
    let lastHit = -10;
    const clock = new THREE.Clock();

    function tick() {
      if (!running) return;
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;

      // Hit impulse: knock the robot back with a damped spring
      if (pendingHit) {
        pendingHit = false;
        lastHit = t;
        hitVel = -7;
        // Se queja igual que su gemelo pequeño; comparten el mute del robot.
        playRobotHurt();
      }
      hitVel += (-90 * hitRot - 8 * hitVel) * dt;
      hitRot += hitVel * dt;
      const hurt = t - lastHit < 0.55;

      // Idle float + sway, plus knock-back lean and shift
      robot.position.y = Math.sin(t * 1.4) * 0.04;
      robot.position.z = hitRot * 0.4;
      robot.rotation.x = hitRot;
      robot.rotation.y = Math.sin(t * 0.55) * 0.06;

      // Gaze follows cursor (clamped, smoothed); head snaps back when hit
      headGroup.rotation.y += (gazeX * 0.5 - headGroup.rotation.y) * 0.07;
      headGroup.rotation.x += (gazeY * 0.3 + hitRot * 0.8 - headGroup.rotation.x) * 0.07;

      // Brazo: se abre hacia fuera para saludar y al quejarse, nunca hacia
      // dentro (cruzaba la cara). Ver la convención en robotRig.ts.
      if (hurt) {
        armRPivot.rotation.z += (2.35 - armRPivot.rotation.z) * 0.3;
        armRPivot.rotation.x += (-0.3 - armRPivot.rotation.x) * 0.3;
      } else if (t < 2.4) {
        armRPivot.rotation.z += (2.45 + Math.sin(t * 9) * 0.3 - armRPivot.rotation.z) * 0.25;
        armRPivot.rotation.x += (-0.22 - armRPivot.rotation.x) * 0.25;
      } else {
        armRPivot.rotation.z += (0.1 - armRPivot.rotation.z) * 0.06;
        armRPivot.rotation.x += (0 - armRPivot.rotation.x) * 0.06;
      }
      rig.look(gazeX, -gazeY);
      rig.glows.chest.material.opacity = 0.34 + Math.sin(t * 1.6) * 0.14;

      // Eyes: pained squint + ember flash while hurt, regular blink otherwise
      if (t > nextBlink) {
        blinkUntil = t + 0.13;
        nextBlink = t + 2.4 + Math.random() * 3;
      }
      const blinking = t < blinkUntil;
      eyesMat.color.setHex(hurt ? 0xc7422e : 0xf1a93a);
      eyeL.scale.y = eyeR.scale.y = hurt ? 0.25 : (blinking ? 0.12 : 1);

      // Antenna pulse — races for a moment after a hit
      const recent = t - lastHit < 1.4;
      antennaTip.scale.setScalar(1 + Math.sin(t * (recent ? 16 : 3)) * (recent ? 0.22 : 0.12));

      renderer.render(scene, camera);
      raf = requestAnimationFrame(tick);
    }

    const visIO = new IntersectionObserver((entries) => {
      const onScreen = entries[0]?.isIntersecting ?? false;
      if (onScreen && !running) { running = true; tick(); }
      else if (!onScreen) { running = false; cancelAnimationFrame(raf); }
    }, { threshold: 0.05 });
    visIO.observe(mount);

    function onVisibility() {
      if (document.hidden) { running = false; cancelAnimationFrame(raf); }
      else if (!running) { running = true; tick(); }
    }
    document.addEventListener('visibilitychange', onVisibility);

    tick();

    return () => {
      running = false;
      cancelAnimationFrame(raf);
      visIO.disconnect();
      ro.disconnect();
      window.removeEventListener('pointermove', onPointer);
      window.removeEventListener('click', onClick);
      document.removeEventListener('visibilitychange', onVisibility);
      if (heroEl) heroEl.style.cursor = '';
      rig.dispose();
      renderer.dispose();
      renderer.domElement.remove();
    };
  }

  // ── Editor 3D tilt following cursor ──
  function initEditorTilt() {
    const wrap = document.getElementById('editor-tilt');
    if (!wrap) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.matchMedia('(pointer: coarse)').matches) return;

    const hero = wrap.closest('.dev-hero') as HTMLElement | null;
    if (!hero) return;

    let tx = 0, ty = 0, rx = 0, ry = 0;
    let raf = 0;
    let running = false;

    function loop() {
      rx += (tx - rx) * 0.08;
      ry += (ty - ry) * 0.08;
      wrap!.style.transform = `perspective(1100px) rotateX(${rx}deg) rotateY(${ry}deg)`;
      if (Math.abs(tx - rx) < 0.01 && Math.abs(ty - ry) < 0.01 && tx === 0 && ty === 0) {
        running = false;
        return;
      }
      raf = requestAnimationFrame(loop);
    }

    function start() {
      if (!running) { running = true; loop(); }
    }

    hero.addEventListener('pointermove', (e) => {
      const r = wrap!.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const dx = (e.clientX - cx) / (r.width / 2);
      const dy = (e.clientY - cy) / (r.height / 2);
      const clamp = (v: number) => Math.max(-1.6, Math.min(1.6, v));
      ty = clamp(dx) * 3.2;
      tx = clamp(-dy) * 3.2;
      start();
    }, { passive: true });

    hero.addEventListener('pointerleave', () => {
      tx = 0; ty = 0;
      start();
    });

    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  }

  // ── Vídeo del caso Black Gum: carga y reproduce solo al entrar en pantalla ──
  function initCaseVideo() {
    const video = document.querySelector<HTMLVideoElement>('.casestudy-video');
    if (!video || video.dataset.ready === '1') return;
    video.dataset.ready = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // En pantalla, pero puede salirse mientras aún descarga.
    let wanted = false;
    let waiting = false;

    function start(target: HTMLVideoElement) {
      wanted = true;
      let recienAsignado = false;
      target.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
        if (source.dataset.src && !source.getAttribute('src')) {
          source.setAttribute('src', source.dataset.src);
          recienAsignado = true;
        }
      });
      if (recienAsignado) {
        // preload="none" no descarga nada por su cuenta. Al pedir el vídeo hay
        // que levantarlo o el elemento se queda sin datos que decodificar.
        target.preload = 'auto';
        target.load();
      }

      // play() apaga el póster en el mismo instante en que se llama, aunque no
      // haya todavía ni un frame decodificado. Ese hueco es un destello del
      // fondo. Se espera a tener imagen antes de arrancar.
      if (target.readyState >= 2) {
        target.play().catch(() => {});
        return;
      }
      if (waiting) return;
      waiting = true;
      target.addEventListener('loadeddata', () => {
        waiting = false;
        if (wanted) target.play().catch(() => {});
      }, { once: true });
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        const target = entry.target as HTMLVideoElement;
        if (entry.isIntersecting) {
          start(target);
        } else {
          wanted = false;
          target.pause();
        }
      });
    }, { rootMargin: '200px 0px', threshold: 0.1 });

    observer.observe(video);
  }

  // ── Despiece del robot (caso "Este portfolio") ──
  // El robot se desmonta con el scroll como un plano técnico y se vuelve a
  // montar. El escenario es sticky dentro de una sección alta: lo que se ha
  // avanzado por ella decide cuánto está desmontado.
  type PartKey = 'antenna' | 'head' | 'screen' | 'eyes' | 'ears' | 'arms' | 'chest' | 'body';

  type DespieceEls = {
    section: HTMLElement;
    stage: HTMLElement;
    mount: HTMLElement;
    svg: SVGSVGElement;
    caption: HTMLElement;
    actions: HTMLElement;
    reduced: boolean;
  };

  const DESPIECE_CAPTIONS = [
    'Este robot lo he diseñado yo, pieza a pieza.',
    'Cada pieza tiene su porqué.',
    'Y le he enseñado a hablar de mi trabajo. Pregúntale.',
  ];

  function initDespiece() {
    const section = document.getElementById('este-portfolio');
    const stage = document.getElementById('despiece-stage');
    const mount = document.getElementById('despiece-canvas');
    const svg = document.getElementById('despiece-leaders') as SVGSVGElement | null;
    const caption = document.getElementById('despiece-caption');
    const actions = document.getElementById('despiece-actions');
    const ask = document.getElementById('self-ask');
    if (!section || !stage || !mount || !svg || !caption || !actions || !ask) return;

    // El robot global escucha este evento: abre su chat y se hace la pregunta.
    ask.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('rg:open-chat', {
        detail: { question: '¿Qué hace Guille?' },
      }));
    });

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const probe = document.createElement('canvas');
    if (!(probe.getContext('webgl2') || probe.getContext('webgl'))) {
      // Sin 3D no hay despiece: queda el título, la frase y los botones.
      section.classList.add('despiece--static', 'despiece--no3d');
      caption.textContent = DESPIECE_CAPTIONS[0];
      return;
    }
    if (reduced) section.classList.add('despiece--static');

    let cleanup: (() => void) | null = null;
    let cancelled = false;
    const io = new IntersectionObserver(async (entries) => {
      if (entries[0]?.isIntersecting && !cleanup) {
        io.disconnect();
        const dispose = await buildDespiece({ section, stage, mount, svg, caption, actions, reduced }, () => cancelled);
        if (cancelled) dispose();
        else cleanup = dispose;
      }
    }, { rootMargin: '600px 0px' });
    io.observe(section);

    document.addEventListener('astro:before-swap', () => {
      cancelled = true;
      io.disconnect();
      cleanup?.();
      cleanup = null;
    }, { once: true });
  }

  async function buildDespiece(els: DespieceEls, isCancelled: () => boolean): Promise<() => void> {
    const { section, stage, mount, svg, caption, actions, reduced } = els;
    const THREE = await import('three');
    const { RoundedBoxGeometry } = await import('three/addons/geometries/RoundedBoxGeometry.js');
    const { buildRobotRig } = await import('../lib/robotRig');
    if (isCancelled()) return () => {};

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(32, 1, 0.1, 40);
    const renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, window.innerWidth < 769 ? 1.5 : 2));
    mount.appendChild(renderer.domElement);

    scene.add(new THREE.AmbientLight(0xfff4e0, 1.05));
    const key = new THREE.DirectionalLight(0xffffff, 2.1);
    key.position.set(2.5, 3.5, 4);
    scene.add(key);
    const rim = new THREE.PointLight(0xf1a93a, 10, 12);
    rim.position.set(-2.4, 1.2, 1.5);
    scene.add(rim);

    const rig = buildRobotRig(THREE, RoundedBoxGeometry);
    const { robot, headGroup, eyeL, eyeR, eyesMat, armLPivot, armRPivot, antennaTip, parts } = rig;
    scene.add(robot);

    // Aristas naranjas de plano técnico, que aparecen al separarse las piezas.
    // Las esferas no tienen aristas a este ángulo: no se les pone.
    const edgeMat = new THREE.LineBasicMaterial({ color: 0xf1a93a, transparent: true, opacity: 0 });
    const edgeGeos: { dispose(): void }[] = [];
    [parts.body, parts.neck, parts.head, parts.screen, parts.chest, parts.antenna, parts.armL, parts.armR, parts.earL, parts.earR]
      .forEach((mesh) => {
        const geo = new THREE.EdgesGeometry(mesh.geometry, 28);
        edgeGeos.push(geo);
        mesh.add(new THREE.LineSegments(geo, edgeMat));
      });

    const base = {
      head: headGroup.position.y,
      antenna: parts.antenna.position.y,
      tip: antennaTip.position.y,
      screen: parts.screen.position.z,
      eye: eyeL.position.z,
      earX: parts.earR.position.x,
      chest: parts.chest.position.z,
      armX: armRPivot.position.x,
      armLRot: armLPivot.rotation.z,
      armRRot: armRPivot.rotation.z,
    };

    const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
    const smooth = (a: number, b: number, x: number) => {
      const p = clamp01((x - a) / (b - a));
      return p * p * (3 - 2 * p);
    };
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // Se desmonta de arriba abajo: cada pieza arranca un poco después.
    const DELAY: Record<PartKey, number> = {
      antenna: 0, head: 0.08, screen: 0.18, eyes: 0.26, ears: 0.32, arms: 0.38, chest: 0.44, body: 0.5,
    };
    const partE = (k: PartKey, e: number) => smooth(DELAY[k], DELAY[k] + 0.5, e);

    function pose(e: number) {
      headGroup.position.y = base.head + 0.52 * partE('head', e);
      parts.antenna.position.y = base.antenna + 0.2 * partE('antenna', e);
      antennaTip.position.y = base.tip + 0.44 * partE('antenna', e);
      parts.screen.position.z = base.screen + 0.36 * partE('screen', e);
      const eyeZ = base.eye + 0.66 * partE('eyes', e);
      eyeL.position.z = eyeZ;
      eyeR.position.z = eyeZ;
      const ear = 0.28 * partE('ears', e);
      parts.earL.position.x = -base.earX - ear;
      parts.earR.position.x = base.earX + ear;
      parts.chest.position.z = base.chest + 0.5 * partE('chest', e);
      const arm = 0.44 * partE('arms', e);
      armLPivot.position.x = -base.armX - arm;
      armRPivot.position.x = base.armX + arm;
      armLPivot.rotation.z = base.armLRot * (1 - partE('arms', e));
      edgeMat.opacity = 0.85 * smooth(0.05, 0.5, e);
    }

    // Punto de cada pieza del que sale su línea, en coordenadas de la pieza.
    const ANCHORS: Record<PartKey, [{ localToWorld(v: unknown): unknown }, [number, number, number]]> = {
      antenna: [antennaTip, [0, 0, 0]],
      head: [parts.head, [0.39, 0.12, 0]],
      screen: [parts.screen, [-0.26, 0.1, 0.04]],
      eyes: [eyeL, [0, 0, 0]],
      ears: [parts.earR, [0, 0, 0]],
      arms: [parts.armL, [0, -0.1, 0]],
      chest: [parts.chest, [0, 0, 0]],
      body: [parts.body, [0.31, -0.12, 0]],
    };

    const SVG_NS = 'http://www.w3.org/2000/svg';
    const labels = Array.from(section.querySelectorAll<HTMLElement>('.part')).map((el) => {
      const path = document.createElementNS(SVG_NS, 'path');
      const dot = document.createElementNS(SVG_NS, 'circle');
      dot.setAttribute('r', '3');
      svg.append(path, dot);
      return {
        el,
        key: el.dataset.part as PartKey,
        side: el.dataset.side === 'left' ? 'left' : 'right',
        minor: el.classList.contains('part--minor'),
        path,
        dot,
        width: 0,
        height: 0,
      };
    });

    const head = section.querySelector<HTMLElement>('.despiece__head');
    const foot = section.querySelector<HTMLElement>('.despiece__foot');
    let w = 1;
    let h = 1;
    let narrow = false;
    function resize() {
      w = stage.clientWidth || 1;
      h = stage.clientHeight || 1;
      narrow = w < 700;
      renderer.setSize(w, h);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
      labels.forEach((l) => {
        l.width = l.el.offsetWidth;
        l.height = l.el.offsetHeight;
      });
    }
    resize();
    const ro = new ResizeObserver(resize);
    ro.observe(stage);

    // Encuadre: el robot usa una parte fija del escenario; al desmontarse
    // crece, así que la cámara se aleja para que siga cabiendo con sus
    // etiquetas a los lados.
    let pxPerUnit = 1;
    let halfW = 0.6;
    function frame(e: number) {
      const t = Math.tan(THREE.MathUtils.degToRad(camera.fov / 2));
      const halfH = lerp(0.9, 1.38, e);
      halfW = lerp(0.58, 0.98, e);
      const fillH = narrow ? 0.54 : 0.56;
      const fillW = narrow ? 0.6 : 0.34;
      const d = Math.max(halfH / (t * fillH), halfW / (t * camera.aspect * fillW));
      const cy = lerp(0.5, 0.98, e);
      const viewH = 2 * d * t;
      // El título ocupa arriba: el robot se ve un poco más abajo del centro.
      const lookY = cy + viewH * 0.03;
      camera.position.set(0, lookY, d);
      camera.lookAt(0, lookY, 0);
      pxPerUnit = h / viewH;
    }

    const v = new THREE.Vector3();
    function layoutLabels(e: number) {
      const cx = w / 2;
      const colGap = narrow ? 12 : 40;
      const halfPx = halfW * pxPerUnit * 0.92;
      const minGap = narrow ? 36 : 50;
      const topLimit = (head ? head.offsetTop + head.offsetHeight : 0) + 24;
      const bottomLimit = (foot ? foot.offsetTop : h) - 16;

      const items = labels.map((l) => {
        const visible = !(narrow && l.minor);
        const op = visible ? smooth(0.3, 0.85, partE(l.key, e)) : 0;
        const [obj, off] = ANCHORS[l.key];
        v.set(off[0], off[1], off[2]);
        obj.localToWorld(v);
        v.project(camera);
        return { l, op, ax: (v.x * 0.5 + 0.5) * w, ay: (-v.y * 0.5 + 0.5) * h, y: 0 };
      });

      (['left', 'right'] as const).forEach((side) => {
        const list = items.filter((i) => i.l.side === side && i.op > 0.01).sort((a, b) => a.ay - b.ay);
        // Sin montarse unas encima de otras, y dentro del escenario.
        let last = -Infinity;
        list.forEach((i) => {
          i.y = Math.max(i.ay, last + minGap, topLimit + i.l.height / 2);
          last = i.y;
        });
        let next = Infinity;
        for (let k = list.length - 1; k >= 0; k--) {
          const i = list[k];
          i.y = Math.min(i.y, next - minGap, bottomLimit - i.l.height / 2);
          next = i.y;
        }
      });

      items.forEach(({ l, op, ax, ay, y }) => {
        l.el.style.opacity = String(op);
        l.path.style.opacity = String(op * 0.8);
        l.dot.style.opacity = String(op);
        if (op <= 0.01) return;
        const left = l.side === 'left';
        let x = left ? cx - halfPx - colGap : cx + halfPx + colGap;
        x = left ? Math.max(x, l.width + 10) : Math.min(x, w - l.width - 10);
        const lx = left ? x - l.width : x;
        l.el.style.transform = `translate(${lx.toFixed(1)}px, ${(y - l.height / 2).toFixed(1)}px)`;
        const end = left ? x + 6 : x - 6;
        const knee = left ? end + 14 : end - 14;
        l.path.setAttribute('d', `M${ax.toFixed(1)} ${ay.toFixed(1)} L${knee.toFixed(1)} ${y.toFixed(1)} L${end.toFixed(1)} ${y.toFixed(1)}`);
        l.dot.setAttribute('cx', ax.toFixed(1));
        l.dot.setAttribute('cy', ay.toFixed(1));
      });
    }

    function progress() {
      const r = section.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      return total > 0 ? clamp01(-r.top / total) : 0.5;
    }

    // Pulsarlo le duele, como a su gemelo del editor.
    const raycaster = new THREE.Raycaster();
    const ndc = new THREE.Vector2();
    let pendingHit = false;
    function onClick(e: MouseEvent) {
      const rect = renderer.domElement.getBoundingClientRect();
      ndc.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
      ndc.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
      if (Math.abs(ndc.x) > 1 || Math.abs(ndc.y) > 1) return;
      raycaster.setFromCamera(ndc, camera);
      if (raycaster.intersectObject(robot, true).length > 0) pendingHit = true;
    }
    stage.addEventListener('click', onClick);

    let eCur = reduced ? 0.8 : 0;
    let lastCaption = -1;
    let wasOpen = false;
    let hitRot = 0;
    let hitVel = 0;
    let lastHit = -10;
    let nextBlink = 2;
    let blinkUntil = 0;
    const clock = new THREE.Clock();
    let raf = 0;
    let running = false;

    function tick() {
      if (!running) return;
      const dt = Math.min(clock.getDelta(), 0.05);
      const t = clock.elapsedTime;
      const p = reduced ? 0.5 : progress();

      // Montado → se desmonta → se queda → se vuelve a montar.
      const target = reduced ? 0.8 : smooth(0.1, 0.46, p) * (1 - smooth(0.7, 0.9, p));
      eCur += (target - eCur) * Math.min(1, dt * 7);
      pose(eCur);

      if (!reduced) {
        if (eCur > 0.95 && !wasOpen) { wasOpen = true; playSound('abrir'); }
        if (eCur < 0.05 && wasOpen) { wasOpen = false; playSound('cerrar'); }
      }

      const phase = reduced ? 1 : p < 0.14 ? 0 : p < 0.74 ? 1 : 2;
      if (phase !== lastCaption) {
        lastCaption = phase;
        caption.textContent = DESPIECE_CAPTIONS[phase];
      }
      actions.classList.toggle('is-shown', reduced || p > 0.76);

      if (pendingHit) {
        pendingHit = false;
        if (t - lastHit > 0.5) {
          lastHit = t;
          hitVel = -7;
          playRobotHurt();
        }
      }
      hitVel += (-90 * hitRot - 8 * hitVel) * dt;
      hitRot += hitVel * dt;
      const hurt = t - lastHit < 0.55;

      const sway = reduced ? 0 : Math.sin(t * 0.5) * 0.14 * (1 - eCur * 0.6);
      robot.rotation.y = -0.62 * eCur + sway;
      robot.rotation.x = 0.1 * eCur + hitRot;
      robot.position.y = reduced ? 0 : Math.sin(t * 1.3) * 0.03;
      robot.position.z = hitRot * 0.4;

      // Al volver a montarse, saluda.
      const wave = reduced ? 0 : smooth(0.9, 0.97, p);
      // Se abre hacia fuera, nunca hacia dentro (ver robotRig.ts).
      armRPivot.rotation.z = hurt ? 2.35 : lerp(base.armRRot, 2.45 + Math.sin(t * 9) * 0.3, wave);
      armRPivot.rotation.x = hurt ? -0.3 : lerp(0, -0.22, wave);
      rig.glows.chest.material.opacity = 0.34 + Math.sin(t * 1.6) * 0.14;

      if (t > nextBlink) {
        blinkUntil = t + 0.13;
        nextBlink = t + 2.4 + Math.random() * 3;
      }
      eyesMat.color.setHex(hurt ? 0xc7422e : 0xf1a93a);
      eyeL.scale.y = eyeR.scale.y = hurt ? 0.25 : t < blinkUntil ? 0.12 : 1;

      frame(eCur);
      robot.updateMatrixWorld(true);
      layoutLabels(eCur);
      renderer.render(scene, camera);
      raf = requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      clock.getDelta();
      raf = requestAnimationFrame(tick);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    const visIO = new IntersectionObserver((entries) => {
      if (entries[0]?.isIntersecting && !document.hidden) start();
      else stop();
    });
    visIO.observe(section);
    function onVisibility() {
      if (document.hidden) stop();
      else if (section.getBoundingClientRect().bottom > 0 && section.getBoundingClientRect().top < window.innerHeight) start();
    }
    document.addEventListener('visibilitychange', onVisibility);

    return () => {
      stop();
      visIO.disconnect();
      ro.disconnect();
      stage.removeEventListener('click', onClick);
      document.removeEventListener('visibilitychange', onVisibility);
      edgeGeos.forEach((g) => g.dispose());
      edgeMat.dispose();
      rig.dispose();
      renderer.dispose();
      renderer.domElement.remove();
      labels.forEach((l) => { l.path.remove(); l.dot.remove(); });
    };
  }

  document.addEventListener('astro:page-load', () => {
    initDespiece();
    initScramble();
    initEditor();
    initHeroGlow();
    initHero3D();
    initEditorBot();
    initEditorTilt();
    initCaseVideo();
  });
</script>

