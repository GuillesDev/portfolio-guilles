</style>

<script>
  import { playSound } from '../lib/uiSound';

  let grafismoAbort: AbortController | null = null;

  function initGrafismo() {
    // Clean previous listeners when navigating with Astro View Transitions.
    if (grafismoAbort) grafismoAbort.abort();
    grafismoAbort = new AbortController();
    const { signal } = grafismoAbort;

    /* ── Timecode ── */
    // 25fps PAL clock: tick from elapsed time (not once per rAF) so the DOM
    // only updates 25×/s, and stop the loop when navigating away (the old
    // version leaked one infinite rAF loop per visit).
    const tcEl = document.getElementById('timecode');
    if (tcEl) {
      let tcRaf = 0;
      let lastFrame = -1;
      const tcStart = performance.now();
      const updateTC = () => {
        const frame = Math.floor((performance.now() - tcStart) / 40); // 1000/25
        if (frame !== lastFrame) {
          lastFrame = frame;
          const t = Math.floor(frame / 25);
          const h = String(Math.floor(t / 3600)).padStart(2, '0');
          const m = String(Math.floor((t % 3600) / 60)).padStart(2, '0');
          const s = String(t % 60).padStart(2, '0');
          const f = String(frame % 25).padStart(2, '0');
          tcEl.textContent = `${h}:${m}:${s}:${f}`;
        }
        tcRaf = requestAnimationFrame(updateTC);
      };
      updateTC();
      signal.addEventListener('abort', () => cancelAnimationFrame(tcRaf));
    }

    /* ── Channel switch ── */
    const btns = document.querySelectorAll<HTMLButtonElement>('.channel-switch__btn');
    const glitch = document.getElementById('channel-glitch');
    const gridSinIa = document.getElementById('grid-sin-ia');
    const gridIa = document.getElementById('grid-ia');
    const gridCabeceras = document.getElementById('grid-cabeceras');
    const gridChristmas = document.getElementById('grid-christmas');
    const allGrids = [gridSinIa, gridIa, gridCabeceras, gridChristmas];
    const channelMap: Record<string, number> = { 'sin-ia': 0, 'ia': 1, 'cabeceras': 2, 'christmas': 3 };

    let currentChannel = 'sin-ia';
    let switching = false;

    /* ── El mando en pantalla ── */
    const mando = document.getElementById('canal-mando');
    const chapa = document.getElementById('canal-chapa');
    const chapaNum = document.getElementById('canal-chapa-num');
    const chapaNombre = document.getElementById('canal-chapa-nombre');
    const totalCanales = String(btns.length).padStart(2, '0');
    let cierreMando = 0;
    let mandoDescubierto = false;

    /**
     * El mando vive dentro de la pantalla del canal, y cada canal tiene la
     * suya: los dos monitores ocupan el ancho entero, el reproductor de
     * cabeceras es más estrecho y va centrado, y Corporativo no tiene
     * pantalla porque es material impreso. La capa se mide de la que hay a
     * la vista; el canal que no marca ninguna pasa al modo posado.
     */
    const zona = document.querySelector<HTMLElement>('.canal-zona');
    const capa = document.querySelector<HTMLElement>('.canal-capa');

    function ajustarCapa() {
      if (!zona || !capa) return;
      const canal = document.querySelector<HTMLElement>(
        '.video-showcase:not(.video-showcase--hidden)'
      );
      const pantalla = canal?.querySelector<HTMLElement>('[data-canal-pantalla]');
      zona.classList.toggle('canal-zona--dock', !pantalla);

      if (!pantalla) {
        ['--capa-top', '--capa-left', '--capa-w', '--capa-h'].forEach((v) =>
          capa.style.removeProperty(v)
        );
        return;
      }

      const z = zona.getBoundingClientRect();
      const p = pantalla.getBoundingClientRect();
      // Una pantalla todavía sin medir (canal recién mostrado, imagen sin
      // cargar) dejaría la capa en cero y la chapa fuera de sitio.
      if (!p.width || !p.height) return;
      capa.style.setProperty('--capa-top', `${p.top - z.top}px`);
      capa.style.setProperty('--capa-left', `${p.left - z.left}px`);
      capa.style.setProperty('--capa-w', `${p.width}px`);
      capa.style.setProperty('--capa-h', `${p.height}px`);
    }

    let ajusteRAF = 0;
    function pedirAjuste() {
      cancelAnimationFrame(ajusteRAF);
      ajusteRAF = requestAnimationFrame(ajustarCapa);
    }

    ajustarCapa();
    window.addEventListener('resize', pedirAjuste, { signal });
    // El viewport puede medirse tarde al entrar por navegación interna, y una
    // medida en falso deja la chapa fuera de la imagen hasta el primer resize.
    const reAjuste = window.setTimeout(pedirAjuste, 600);
    signal.addEventListener('abort', () => {
      cancelAnimationFrame(ajusteRAF);
      window.clearTimeout(reAjuste);
    });

    function abrirMando(abierto: boolean) {
      window.clearTimeout(cierreMando);
      mando?.classList.toggle('canal-mando--abierto', abierto);
      chapa?.setAttribute('aria-expanded', String(abierto));
    }

    // La pista (pulso de la flecha) desaparece en cuanto el visitante toca el
    // mando de verdad. La abertura automática del peek no cuenta como gesto,
    // así que no la retira.
    function marcarDescubierto() {
      if (mandoDescubierto) return;
      mandoDescubierto = true;
      mando?.classList.remove('canal-mando--pista');
    }

    // Con ratón basta acercarse; en táctil se pulsa la chapa. El cierre va
    // con un respiro, o cruzar el hueco entre la chapa y la lista lo cierra
    // en la cara.
    mando?.addEventListener('pointerenter', (event) => {
      if ((event as PointerEvent).pointerType !== 'mouse') return;
      marcarDescubierto();
      abrirMando(true);
    }, { signal });
    mando?.addEventListener('pointerleave', (event) => {
      if ((event as PointerEvent).pointerType !== 'mouse') return;
      cierreMando = window.setTimeout(() => abrirMando(false), 260);
    }, { signal });
    chapa?.addEventListener('click', () => {
      marcarDescubierto();
      abrirMando(chapa.getAttribute('aria-expanded') !== 'true');
    }, { signal });
    mando?.addEventListener('focusin', () => { marcarDescubierto(); abrirMando(true); }, { signal });
    mando?.addEventListener('focusout', (event) => {
      if (mando.contains((event as FocusEvent).relatedTarget as Node)) return;
      abrirMando(false);
    }, { signal });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mando?.classList.contains('canal-mando--abierto')) abrirMando(false);
    }, { signal });

    /** El punto rojo de la chapa sigue a lo que de verdad está emitiendo. */
    function pintarChapa() {
      const activa = document.querySelector<HTMLElement>(
        '.video-showcase:not(.video-showcase--hidden) .emision__screen'
      );
      chapa?.classList.toggle('canal-chapa--antena', !!activa?.classList.contains('is-playing'));
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const ch = btn.dataset.channel;
        if (!ch || ch === currentChannel || switching) return;
        switching = true;
        playSound('canal');

        // Update active button
        btns.forEach(b => {
          b.classList.remove('channel-switch__btn--active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('channel-switch__btn--active');
        btn.setAttribute('aria-pressed', 'true');

        // El monitor del canal que se deja atrás se apaga del todo: si no,
        // seguiría reproduciéndose y descargando detrás de una pantalla que
        // ya no se ve.
        document.querySelectorAll<HTMLElement>('[data-emision]').forEach(apagarEmision);

        // Trigger glitch
        if (glitch) {
          glitch.classList.remove('glitch--active');
          void glitch.offsetWidth; // force reflow

          // El rótulo se lee del propio botón, así nunca se desincroniza
          // de los nombres de los canales.
          const chNum = document.getElementById('glitch-channel-num');
          const chName = document.getElementById('glitch-channel-name');
          const num = btn.querySelector('.channel-switch__num')?.textContent?.trim();
          const label = btn.querySelector('.channel-switch__label')?.textContent?.trim();
          if (chNum && num) chNum.textContent = `CH ${num}`;
          if (chName && label) chName.textContent = label;
          if (chapaNum && num) chapaNum.textContent = `CH ${num} / ${totalCanales}`;
          if (chapaNombre && label) chapaNombre.textContent = label;
          abrirMando(false);

          glitch.classList.add('glitch--active');
        }

        // Pause cabecera video if leaving CH 03
        const cabVid = document.getElementById('cabecera-video') as HTMLVideoElement;
        if (cabVid) { cabVid.pause(); cabVid.currentTime = 0; }

        // Switch grids during the glitch peak
        setTimeout(() => {
          allGrids.forEach(g => { if (g) g.classList.add('video-showcase--hidden'); });
          const target = ch === 'ia' ? gridIa : ch === 'cabeceras' ? gridCabeceras : ch === 'christmas' ? gridChristmas : gridSinIa;
          if (target) target.classList.remove('video-showcase--hidden');
          const emision = target?.querySelector<HTMLElement>('[data-emision]');
          if (emision) reanudarEmision(emision);
          pintarChapa();
          // La capa se remide con el canal nuevo ya a la vista: hasta este
          // punto el que se mostraba era el anterior.
          ajustarCapa();
          if (ch === 'cabeceras' && cabVid) ensureVideoSource(cabVid);

          currentChannel = ch!;
          switching = false;
        }, 350);
      }, { signal });
    });

    /* ── Emisión: el monitor de cada canal ── */
    // Solo arranca solo donde hay ratón: en táctil no se descarga un vídeo
    // que nadie ha pedido, y con movimiento reducido no se mueve nada. Ahí
    // el monitor se queda en su póster con el ▶ puesto.
    const autoemision =
      window.matchMedia('(hover: hover) and (pointer: fine)').matches &&
      !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Un token por monitor: sintonizar rápido dejaría varios `loadeddata`
    // pendientes, y el de una pieza ya descartada arrancaría sobre la actual.
    const emisionToken = new WeakMap<HTMLElement, number>();

    // La pieza entra con su sonido puesto si lo tiene. El navegador bloquea
    // el audio hasta que hay un gesto del visitante, así que esto es una
    // intención: si `play()` la rechaza, se cae a silencio con el aviso a la
    // vista y vuelve a intentarse en cuanto toque algo.
    let sonidoEmision = true;

    function ensureVideoSource(vid: HTMLVideoElement) {
      const source = vid.querySelector<HTMLSourceElement>('source[data-src]');
      if (!source?.dataset.src || source.getAttribute('src')) return;
      source.src = source.dataset.src;
      vid.load();
    }

    const monitorDe = (emision: HTMLElement) =>
      emision.querySelector<HTMLVideoElement>('[data-emision-video]');
    const pantallaDe = (emision: HTMLElement) =>
      emision.querySelector<HTMLElement>('[data-emision-screen]');
    const enAntena = (emision: HTMLElement) =>
      emision.querySelector<HTMLButtonElement>('.emision__thumb--on');

    function apagarEmision(emision: HTMLElement) {
      emisionToken.set(emision, (emisionToken.get(emision) ?? 0) + 1);
      pantallaDe(emision)?.classList.remove('is-playing');
      pintarChapa();
      const video = monitorDe(emision);
      if (!video) return;
      video.pause();
      // Sin quitar el src seguiría descargando con el canal ya cambiado.
      video.removeAttribute('src');
      video.load();
    }

    function pausarEmision(emision: HTMLElement) {
      monitorDe(emision)?.pause();
    }

    function reanudarEmision(emision: HTMLElement) {
      if (!autoemision) return;
      const video = monitorDe(emision);
      if (video?.getAttribute('src')) {
        video.play().catch(() => {});
        return;
      }
      arrancarEmision(emision);
    }

    function arrancarEmision(emision: HTMLElement, forzar = false) {
      // `forzar` es para lo que nace de un toque: ahí sí se puede arrancar
      // aunque el monitor no se reproduzca solo en este dispositivo.
      if (!autoemision && !forzar) return;
      const thumb = enAntena(emision);
      const screen = pantallaDe(emision);
      const video = monitorDe(emision);
      if (!thumb?.dataset.src || !screen || !video) return;

      const token = (emisionToken.get(emision) ?? 0) + 1;
      emisionToken.set(emision, token);
      // `preload` tiene que subir a auto al asignar el src o no descarga nada.
      video.preload = 'auto';
      video.src = thumb.dataset.src;
      video.muted = !sonidoEmision || thumb.dataset.muda === 'true';
      video.load();

      const go = () => {
        if (emisionToken.get(emision) !== token) return;
        video.play()
          .then(() => { screen.classList.add('is-playing'); pintarChapa(); })
          .catch(() => {
            // Rechazado por la política de autoplay: la única forma de que se
            // vea es sin sonido, y el rótulo pasa a decir cómo activarlo.
            if (video.muted) return;
            sonidoEmision = false;
            video.muted = true;
            pintarSonido(emision);
            video.play().then(() => { screen.classList.add('is-playing'); pintarChapa(); }).catch(() => {});
          });
      };
      // Misma regla que en el resto del sitio: play() apaga el póster nada
      // más llamarse, así que se espera a tener frame.
      if (video.readyState >= 2) go();
      else video.addEventListener('loadeddata', go, { once: true });
    }

    /**
     * Deja a la vista qué hace el click: el altavoz de la esquina y, en el
     * rótulo, la acción. En una pieza sin pista de audio no se promete un
     * sonido que no existe.
     */
    function pintarSonido(emision: HTMLElement) {
      const thumb = enAntena(emision);
      const video = monitorDe(emision);
      const marca = emision.querySelector<HTMLElement>('[data-emision-sound]');
      const rotulo = emision.querySelector<HTMLElement>('[data-emision-hint]');
      const expand = emision.querySelector<HTMLElement>('[data-emision-expand]');
      const titulo = thumb?.dataset.title ?? '';
      const muda = thumb?.dataset.muda === 'true';
      const suena = sonidoEmision && !muda;

      if (video) video.muted = !suena;
      marca?.classList.toggle('emision__sound--on', suena);
      marca?.classList.toggle('emision__sound--muda', muda);
      if (rotulo) {
        rotulo.textContent = muda
          ? 'Esta pieza no tiene audio'
          : suena ? 'Pulsa para silenciar' : 'Pulsa para el sonido';
      }
      const screen = pantallaDe(emision);
      screen?.setAttribute(
        'aria-label',
        muda ? `${titulo}: pieza sin audio`
          : suena ? `Silenciar ${titulo}` : `Activar el sonido de ${titulo}`
      );
      screen?.setAttribute('aria-pressed', String(suena));
      expand?.setAttribute('aria-label', `Ver ${titulo} a pantalla completa`);
    }

    function sintonizar(
      emision: HTMLElement,
      thumb: HTMLButtonElement,
      opciones: { sonidoUI?: boolean; forzar?: boolean } = {}
    ) {
      const { sonidoUI = true, forzar = false } = opciones;
      const screen = pantallaDe(emision);
      if (!screen) return;
      emision.querySelectorAll<HTMLButtonElement>('.emision__thumb').forEach((b) => {
        const activa = b === thumb;
        b.classList.toggle('emision__thumb--on', activa);
        b.setAttribute('aria-pressed', String(activa));
      });

      const titulo = thumb.dataset.title ?? '';
      const rotulo = emision.querySelector<HTMLElement>('[data-emision-title]');
      if (rotulo) rotulo.textContent = titulo;
      if (thumb.dataset.poster) screen.style.setProperty('--poster', `url("${thumb.dataset.poster}")`);

      apagarEmision(emision);
      arrancarEmision(emision, forzar);
      pintarSonido(emision);
      if (sonidoUI) playSound('paso');
    }

    document.querySelectorAll<HTMLElement>('[data-emision]').forEach((emision) => {
      const screen = pantallaDe(emision);
      const video = monitorDe(emision);

      // La miniatura pone su pieza en el monitor. El toque vale como gesto,
      // así que donde no hay reproducción automática arranca igualmente.
      emision.querySelectorAll<HTMLButtonElement>('.emision__thumb').forEach((thumb) => {
        thumb.addEventListener('click', () => sintonizar(emision, thumb, { forzar: true }), { signal });
      });

      // Al terminar una pieza, encadenar la siguiente de la parrilla en
      // círculo. Antes el vídeo llevaba `loop`, útil cuando todas iban mudas,
      // pero desde que la pieza entra sonando eso convertía a la cartela con
      // audio en una sintonía corta repitiéndose sin fin. Encadenar además
      // hace que se vean las dieciséis, no solo la primera.
      video?.addEventListener('ended', () => {
        const thumbs = Array.from(
          emision.querySelectorAll<HTMLButtonElement>('.emision__thumb')
        );
        const actual = enAntena(emision);
        if (!actual || !thumbs.length) return;
        const siguiente = thumbs[(thumbs.indexOf(actual) + 1) % thumbs.length];
        if (siguiente) sintonizar(emision, siguiente, { sonidoUI: false, forzar: true });
      }, { signal });

      /**
       * Pulsar el monitor es el sonido: lo activa y lo quita. Si todavía no
       * hay nada reproduciéndose (táctil), el primer toque arranca la pieza
       * ya con sonido, que es lo que se está pidiendo al pulsar.
       */
      const alternarSonido = () => {
        const thumb = enAntena(emision);
        const video = monitorDe(emision);
        if (!thumb || !video) return;
        // Sin pista de audio no hay nada que activar; el rótulo ya lo dice.
        if (thumb.dataset.muda === 'true') return;

        if (!video.getAttribute('src')) {
          sonidoEmision = true;
          arrancarEmision(emision, true);
          pintarSonido(emision);
          return;
        }

        sonidoEmision = !sonidoEmision;
        pintarSonido(emision);
        // El vídeo puede estar pausado si se llegó aquí sin reproducción
        // automática; pedir sonido es también pedir que suene algo.
        if (sonidoEmision && video.paused) video.play().catch(() => {});
      };

      screen?.addEventListener('click', alternarSonido, { signal });
      screen?.addEventListener('keydown', (event) => {
        const key = (event as KeyboardEvent).key;
        if (key !== 'Enter' && key !== ' ') return;
        event.preventDefault();
        alternarSonido();
      }, { signal });

      // Pantalla completa, en su propio botón: el click no debe llegar a la
      // pantalla o además cambiaría el sonido.
      const expand = emision.querySelector<HTMLButtonElement>('[data-emision-expand]');
      expand?.addEventListener('click', (event) => {
        event.stopPropagation();
        const thumb = enAntena(emision);
        if (thumb) openViewer(thumb, expand);
      }, { signal });

      pintarSonido(emision);
    });

    // El monitor no arranca al cargar la página, sino al llegar a la sección:
    // si no, se descargaría un vídeo para quien nunca baja hasta aquí. Y se
    // pausa al salir de pantalla, que muerde CPU aunque no se vea.
    const showcase = document.querySelector('.grafismo-showcase');
    if (showcase) {
      // El mando se enseña solo la primera vez que se llega a la sección y
      // se recoge: un menú que solo aparece al acercarse no se descubre si
      // nadie lo ha visto nunca abierto. Además la flecha de la chapa late
      // hasta el primer gesto real, y si tras un tiempo largo el visitante
      // sigue sin tocarla se repite el peek una vez más.
      let mandoPresentado = false;
      let repePeek = 0;
      mando?.classList.add('canal-mando--pista');

      const emisionIO = new IntersectionObserver((entries) => {
        const visible = document.querySelector<HTMLElement>(
          '.video-showcase:not(.video-showcase--hidden) [data-emision]'
        );
        entries.forEach((entry) => {
          if (entry.isIntersecting && !mandoPresentado) {
            mandoPresentado = true;
            abrirMando(true);
            cierreMando = window.setTimeout(() => abrirMando(false), 3500);
            repePeek = window.setTimeout(() => {
              if (mandoDescubierto) return;
              abrirMando(true);
              cierreMando = window.setTimeout(() => abrirMando(false), 2200);
            }, 12000);
          }
          if (!visible) return;
          if (entry.isIntersecting) reanudarEmision(visible);
          else pausarEmision(visible);
        });
      }, { rootMargin: '0px 0px -15% 0px' });
      emisionIO.observe(showcase);
      signal.addEventListener('abort', () => {
        emisionIO.disconnect();
        window.clearTimeout(repePeek);
      });
    }

    /* ── Visor grande ── */
    const viewer = document.getElementById('gviewer') as HTMLDialogElement | null;
    const viewerVideo = document.getElementById('gviewer-video') as HTMLVideoElement | null;
    const viewerTitle = document.getElementById('gviewer-title');
    const viewerCount = document.getElementById('gviewer-count');
    const viewerSilent = document.getElementById('gviewer-silent');
    const viewerPrev = document.getElementById('gviewer-prev') as HTMLButtonElement | null;
    const viewerNext = document.getElementById('gviewer-next') as HTMLButtonElement | null;
    const viewerClose = document.getElementById('gviewer-close') as HTMLButtonElement | null;

    let viewerList: HTMLElement[] = [];
    let viewerIndex = -1;
    let viewerOpener: HTMLElement | null = null;
    let closeTimer = 0;
    // Cambiar de pieza rápido dejaría varios `loadeddata` pendientes, y el de
    // una pieza ya descartada arrancaría encima de la actual.
    let playToken = 0;

    function playWhenReady(video: HTMLVideoElement) {
      const token = ++playToken;
      const go = () => {
        if (token !== playToken) return;
        video.play().catch(() => {
          // Si la política de autoplay lo rechaza, al menos que se vea.
          video.muted = true;
          video.play().catch(() => {});
        });
      };
      // Misma regla que en el resto del sitio: play() apaga el póster nada
      // más llamarse, así que se espera a tener frame.
      if (video.readyState >= 2) go();
      else video.addEventListener('loadeddata', go, { once: true });
    }

    function showPiece(index: number) {
      if (!viewerVideo || index < 0 || index >= viewerList.length) return;
      viewerIndex = index;
      const thumb = viewerList[index];
      const src = thumb.dataset.src || '';
      if (!src) return;

      // La pista de audio se resuelve al compilar (`data-muda`), así que el
      // aviso ya está puesto antes de que el vídeo cargue un solo byte.
      const muda = thumb.dataset.muda === 'true';

      viewerVideo.pause();
      viewerVideo.poster = thumb.dataset.poster || '';
      viewerVideo.preload = 'auto';
      viewerVideo.src = src;
      viewerVideo.muted = muda;
      // El CSS esconde el control de volumen cuando no hay nada que oír.
      if (muda) viewerVideo.dataset.muda = 'true';
      else delete viewerVideo.dataset.muda;
      viewerVideo.load();
      playWhenReady(viewerVideo);

      if (viewerTitle) viewerTitle.textContent = thumb.dataset.title || '';
      if (viewerCount) viewerCount.textContent = `${index + 1} / ${viewerList.length}`;
      if (viewerSilent) viewerSilent.hidden = !muda;
      const solaPieza = viewerList.length < 2;
      if (viewerPrev) viewerPrev.disabled = solaPieza;
      if (viewerNext) viewerNext.disabled = solaPieza;
    }

    function stepPiece(delta: number) {
      if (viewerList.length < 2) return;
      playSound('paso');
      showPiece((viewerIndex + delta + viewerList.length) % viewerList.length);
    }

    function openViewer(thumb: HTMLElement, opener?: HTMLElement) {
      if (!viewer || !viewerVideo) return;
      window.clearTimeout(closeTimer);

      // Las flechas recorren solo la parrilla del canal abierto.
      const emision = thumb.closest<HTMLElement>('[data-emision]');
      viewerList = emision
        ? Array.from(emision.querySelectorAll<HTMLElement>('.emision__thumb'))
        : [thumb];
      // El foco vuelve a lo que abrió el visor: la miniatura o el monitor.
      viewerOpener = opener ?? thumb;

      // El monitor se calla mientras manda el visor, pero conserva su vídeo
      // para volver a antena al cerrar sin descargarlo otra vez.
      if (emision) pausarEmision(emision);

      if (!viewer.open) viewer.showModal();
      void viewer.offsetWidth; // fuerza reflow para que la transición corra
      viewer.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      playSound('abrir');

      showPiece(viewerList.indexOf(thumb));
      viewerClose?.focus();
    }

    function closeViewer() {
      if (!viewer || !viewer.open) return;
      playToken++;
      playSound('cerrar');
      viewer.classList.remove('is-open');
      document.body.style.overflow = '';

      if (viewerVideo) {
        viewerVideo.pause();
        // Sin esto el vídeo sigue descargando con el visor cerrado.
        viewerVideo.removeAttribute('src');
        viewerVideo.load();
      }

      // Lo último que se ha visto se queda en antena, así el monitor no
      // contradice a lo que el visitante acaba de mirar.
      const vista = viewerList[viewerIndex] as HTMLButtonElement | undefined;
      const emision = vista?.closest<HTMLElement>('[data-emision]');
      if (vista && emision) sintonizar(emision, vista, { sonidoUI: false });

      // El cierre se retrasa para que dé tiempo al fundido: un <dialog>
      // cerrado vuelve a `display: none` de golpe. La transición puede no
      // disparar `transitionend` con movimiento reducido, así que va por reloj.
      const volverA = viewerOpener;
      viewerOpener = null;
      closeTimer = window.setTimeout(() => {
        if (viewer.open) viewer.close();
        volverA?.focus();
      }, 250);
    }

    // Al navegar, el <dialog> se va con el contenido, pero el bloqueo del
    // scroll vive en <body> y se quedaría puesto en la página siguiente.
    document.addEventListener('astro:before-swap', () => {
      window.clearTimeout(closeTimer);
      document.body.style.overflow = '';
    }, { once: true, signal });

    viewerClose?.addEventListener('click', closeViewer, { signal });
    viewerPrev?.addEventListener('click', () => stepPiece(-1), { signal });
    viewerNext?.addEventListener('click', () => stepPiece(1), { signal });
    viewer?.querySelector('[data-gviewer-close]')?.addEventListener('click', closeViewer, { signal });

    // Escape lo gestiona el propio <dialog>, pero cerraría de golpe y sin
    // pausar el vídeo ni soltar el scroll. Se intercepta para pasar por
    // `closeViewer`. El atrapado del foco ya lo hace showModal().
    viewer?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeViewer();
    }, { signal });

    document.addEventListener('keydown', (event) => {
      if (!viewer || !viewer.open) return;
      if (event.key === 'ArrowLeft') { stepPiece(-1); return; }
      if (event.key === 'ArrowRight') stepPiece(1);
    }, { signal });

    /* ── Cabecera carousel ── */
    const cabVideo = document.getElementById('cabecera-video') as HTMLVideoElement;
    const cabThumbs = document.querySelectorAll<HTMLButtonElement>('.cabecera-thumb');
    const cabPrev = document.getElementById('cabecera-prev');
    const cabNext = document.getElementById('cabecera-next');
    const cabFS = document.getElementById('cabecera-fullscreen');

    const cabeceraList: { src: string; poster: string; youtube?: boolean }[] = [
      { src: '/media/grafismo/cabeceras/cabecera-zapatero.mp4', poster: '/media/grafismo/cabeceras/cabecera-zapatero-poster.jpg' },
      { src: '/media/grafismo/cabeceras/personas-bestias.mp4', poster: '/media/grafismo/cabeceras/personas-bestias-poster.jpg' },
      { src: 'vYUjhbAhpTc', poster: '/media/grafismo/cabeceras/midas-alonso-poster.jpg', youtube: true },
    ];
    let cabIndex = 0;
    const cabYoutube = document.getElementById('cabecera-youtube') as HTMLIFrameElement;

    function setCabecera(idx: number) {
      if (idx < 0 || idx >= cabeceraList.length || !cabVideo) return;
      cabIndex = idx;
      const item = cabeceraList[idx];

      if (item.youtube) {
        cabVideo.pause();
        cabVideo.style.display = 'none';
        if (cabYoutube) {
          cabYoutube.src = `https://www.youtube-nocookie.com/embed/${item.src}?rel=0`;
          cabYoutube.classList.remove('cabecera-player__youtube--hidden');
        }
      } else {
        if (cabYoutube) {
          cabYoutube.classList.add('cabecera-player__youtube--hidden');
          cabYoutube.src = 'about:blank';
        }
        cabVideo.style.display = '';
        cabVideo.pause();
        cabVideo.querySelector('source')!.src = item.src;
        cabVideo.poster = item.poster;
        cabVideo.load();
      }

      cabThumbs.forEach((t, i) => t.classList.toggle('cabecera-thumb--active', i === idx));
    }

    cabThumbs.forEach(t => {
      t.addEventListener('click', () => { playSound('paso'); setCabecera(Number(t.dataset.index)); }, { signal });
    });

    cabPrev?.addEventListener('click', () => { playSound('paso'); setCabecera((cabIndex - 1 + cabeceraList.length) % cabeceraList.length); }, { signal });
    cabNext?.addEventListener('click', () => { playSound('paso'); setCabecera((cabIndex + 1) % cabeceraList.length); }, { signal });

    cabFS?.addEventListener('click', () => {
      if (!cabVideo) return;
      if (cabVideo.requestFullscreen) cabVideo.requestFullscreen();
    }, { signal });
  }

  document.addEventListener('astro:page-load', initGrafismo);

  /* ── Particle system ── */
  let particlesAbort: AbortController | null = null;

  function initParticles() {
    // Respect reduced-motion: skip the continuous particle animation entirely
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const canvas = document.getElementById('grafismo-particles') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    // Stop any loop/listeners from a previous visit (they used to stack)
    if (particlesAbort) particlesAbort.abort();
    particlesAbort = new AbortController();
    const { signal } = particlesAbort;

    let w = 0, h = 0;
    let particles: { x: number; y: number; vx: number; vy: number; r: number; a: number; pulse: number; speed: number }[] = [];
    let mouse = { x: -9999, y: -9999 };
    let raf = 0;

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }

    function createParticles() {
      const count = Math.min(Math.floor((w * h) / 12000), 120);
      particles = [];
      for (let i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.3,
          vy: (Math.random() - 0.5) * 0.15 - 0.1,
          r: Math.random() * 1.8 + 0.4,
          a: Math.random() * 0.5 + 0.1,
          pulse: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.02 + 0.008,
        });
      }
    }

    // Connection lines bucketed by alpha: one stroke per bucket instead of
    // one stroke (and one style string) per line — same look, ~100× fewer
    // canvas state changes. Squared distances skip the sqrt for most pairs.
    const LINK_DIST = 100;
    const LINK_DIST_SQ = LINK_DIST * LINK_DIST;
    const LINE_BUCKETS = 5;
    const lineBuckets: Path2D[] = new Array(LINE_BUCKETS);
    const lineBucketStyles: string[] = [];
    for (let b = 0; b < LINE_BUCKETS; b++) {
      const alpha = ((b + 0.5) / LINE_BUCKETS) * 0.08;
      lineBucketStyles.push(`rgba(0, 212, 255, ${alpha.toFixed(3)})`);
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);

      for (const p of particles) {
        // Drift
        p.x += p.vx;
        p.y += p.vy;
        p.pulse += p.speed;

        // Wrap around
        if (p.x < -10) p.x = w + 10;
        if (p.x > w + 10) p.x = -10;
        if (p.y < -10) p.y = h + 10;
        if (p.y > h + 10) p.y = -10;

        // Mouse repulsion (sqrt only when actually inside the radius)
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const distSq = dx * dx + dy * dy;
        if (distSq < 120 * 120 && distSq > 0.0001) {
          const dist = Math.sqrt(distSq);
          const force = (120 - dist) / 120 * 0.8;
          p.x += (dx / dist) * force;
          p.y += (dy / dist) * force;
        }

        // Pulsing alpha
        const alpha = p.a * (0.6 + 0.4 * Math.sin(p.pulse));

        // Draw particle
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(0, 212, 255, ${alpha})`;
        ctx!.fill();

        // Glow for bigger particles
        if (p.r > 1.2) {
          ctx!.beginPath();
          ctx!.arc(p.x, p.y, p.r * 3, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(0, 212, 255, ${alpha * 0.1})`;
          ctx!.fill();
        }
      }

      // Connection lines between nearby particles, batched per alpha bucket
      for (let b = 0; b < LINE_BUCKETS; b++) lineBuckets[b] = new Path2D();
      for (let i = 0; i < particles.length; i++) {
        const pi = particles[i];
        for (let j = i + 1; j < particles.length; j++) {
          const pj = particles[j];
          const dx = pi.x - pj.x;
          if (dx > LINK_DIST || dx < -LINK_DIST) continue; // cheap reject
          const dy = pi.y - pj.y;
          const distSq = dx * dx + dy * dy;
          if (distSq < LINK_DIST_SQ) {
            const closeness = 1 - Math.sqrt(distSq) / LINK_DIST;
            let bucket = Math.floor(closeness * LINE_BUCKETS);
            if (bucket >= LINE_BUCKETS) bucket = LINE_BUCKETS - 1;
            lineBuckets[bucket].moveTo(pi.x, pi.y);
            lineBuckets[bucket].lineTo(pj.x, pj.y);
          }
        }
      }
      ctx!.lineWidth = 0.5;
      for (let b = 0; b < LINE_BUCKETS; b++) {
        ctx!.strokeStyle = lineBucketStyles[b];
        ctx!.stroke(lineBuckets[b]);
      }

      raf = requestAnimationFrame(draw);
    }

    resize();
    createParticles();
    draw();

    window.addEventListener('resize', () => {
      resize();
      createParticles();
    }, { signal });

    document.addEventListener('mousemove', (e) => {
      mouse.x = e.clientX;
      mouse.y = e.clientY;
    }, { passive: true, signal });

    document.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    }, { signal });

    // Cleanup on page transition
    signal.addEventListener('abort', () => cancelAnimationFrame(raf));
    document.addEventListener('astro:before-preparation', () => {
      particlesAbort?.abort();
      particlesAbort = null;
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initParticles);
</script>
