  .christmas-card {
    margin: 0;
    position: relative;
    border: 1px solid var(--grafismo-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--grafismo-surface);
    transition: border-color var(--duration-fast) var(--ease-out),
                transform var(--duration-fast) var(--ease-out);
  }

  .christmas-card:hover {
    border-color: var(--grafismo-primary);
    transform: translateY(-2px);
  }

  .christmas-card img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .christmas-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.25em 0.7em;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.7);
    color: var(--grafismo-primary);
    border: 1px solid var(--grafismo-border);
