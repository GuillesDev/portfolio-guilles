  @media (max-width: 640px) {
    /* En vertical la tira se lee como una lista de canales: una fila por
       canal. En 2x2 el filete encendido medía toda la columna mientras la
       palabra ocupaba media, y se leía descolgado. A todo el ancho, el
       filete pertenece claramente a su fila. */
    .channel-switch {
      grid-template-columns: 1fr;
      gap: 0;
      padding-inline: 0;
      margin-block: var(--space-l);
    }

    /* Saca número y punto REC del envoltorio para colocarlos en los dos
       extremos de la fila. */
