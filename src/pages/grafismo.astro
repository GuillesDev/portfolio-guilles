      font-size: var(--step--2);
    }

    /* El tamaño ya lo fijan .channel-glitch__num y __name con su propio
       clamp; aquí solo hace falta acotar el ancho. */
    .channel-glitch__text {
      max-width: 92vw;
      text-align: center;
    }

    .channel-glitch__name {
      letter-spacing: 0.28em;
      text-indent: 0.28em;
    }

    .cabecera-player__selector {
