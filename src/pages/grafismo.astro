  @media (max-width: 640px) {
    /* En una pantalla de 193 px de alto no cabe una lista centrada dentro
       de la imagen sin taparla entera: el mando se ancla bajo la chapa y
       ocupa lo que necesita. */
    .canal-chapa {
      top: 15px;
      left: 36px;
    }

    .channel-switch {
      inset: 46px auto auto 0;
      justify-content: flex-start;
      width: min(240px, 74vw);
      padding: 0.4rem 0.8rem 0.6rem 2rem;
      background: linear-gradient(to right, rgba(5, 5, 16, 0.95) 70%, transparent);
    }

    .channel-switch__btn {
      padding: 0.34rem 0.5rem;
    }

