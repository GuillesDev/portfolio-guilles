---
import SectionLayout from '../layouts/SectionLayout.astro';
import ProjectCTA from '../components/global/ProjectCTA.astro';
import ChannelEmision from '../components/grafismo/ChannelEmision.astro';
import { hasAudioTrack } from '../lib/hasAudioTrack';

// `process.cwd()` y no `import.meta.url`: el módulo de la página se empaqueta,
// así que su URL en compilación no apunta a `src/pages/`.
const esMuda = (carpeta: string, slug: string) =>
  !hasAudioTrack(`${process.cwd()}/public/media/grafismo/${carpeta}/${slug}.mp4`);

const conAudio = (carpeta: string, piezas: { title: string; slug: string }[]) =>
  piezas.map((pieza) => ({ ...pieza, muda: esMuda(carpeta, pieza.slug) }));

const broadcastPieces = [
  { title: 'Cartela informativa', slug: 'cartela-1' },
  { title: 'Discotecas', slug: 'discotecas' },
  { title: 'Elecciones EE. UU.', slug: 'elecciones-eeuu' },
  { title: 'Eurocopa', slug: 'eurocopa' },
  { title: 'Grafismo editorial', slug: 'graf-1' },
  { title: 'Narcolanchas', slug: 'narcolanchas' },
  { title: 'Aquí la Tierra', slug: 'aqui-la-tierra' },
  { title: 'Aquí la Tierra · pieza 02', slug: 'aqui-la-tierra-2' },
];

const generativePieces = [
  { title: 'Eclipse', slug: 'eclipse' },
  { title: 'Caso Andic', slug: 'caso-andic' },
  { title: 'Che Iglesias', slug: 'che-iglesias' },
  { title: 'Abascal Wars', slug: 'abascal-wars' },
  { title: 'Aforama', slug: 'aforama' },
  { title: 'Begoña desafiante', slug: 'begona-desafiante' },
  { title: 'Hulk Sánchez', slug: 'hulk-sanchez' },
  { title: 'Los Panceta', slug: 'los-panceta' },
  { title: 'Paganos', slug: 'paganos' },
  { title: 'Sánchez en barco', slug: 'sanchez-barco' },
  { title: 'Sánchez esquiador', slug: 'sanchez-esqui' },
  { title: 'Sánchez Lightyear', slug: 'sanchez-lightyear' },
  { title: 'Trileros', slug: 'trileros-sanchez-trump' },
  { title: 'Vox is coming', slug: 'vox-is-coming' },
  { title: 'Yolanda en los Óscar', slug: 'yolanda-oscars' },
  { title: 'Exploración IA 03', slug: 'ia-3' },
];

const broadcastChannel = conAudio('sin-ia', broadcastPieces);
const generativeChannel = conAudio('ia', generativePieces);
---

<SectionLayout
  title="Grafismo en TV | Guillermo López"
  description="Grafismo en directo, motion graphics y gráfica televisiva para las principales cadenas de España."
  theme="grafismo"
>
  <!-- Particle background -->
  <canvas class="grafismo-particles" id="grafismo-particles" aria-hidden="true"></canvas>

  <!-- Hero broadcast -->
  <section class="grafismo-hero">
    <div class="grafismo-hero__overlay">
      <div class="scanline"></div>
    </div>

    <div class="grafismo-hero__content container">
      <div class="grafismo-hero__labels" aria-hidden="true">
        <span class="grafismo-label mono">REC ●</span>
        <span class="grafismo-label mono">LIVE</span>
        <span class="grafismo-label mono">16:9 / 1080p</span>
      </div>

      <h1 class="grafismo-hero__title" data-animate="fade-up">
        Grafismo<br />
        <span class="grafismo-hero__accent">en TV</span>
      </h1>

      <p class="grafismo-hero__subtitle" data-animate="fade-up">
        Llevo más de 5 años haciendo la gráfica que ves al encender la tele:
        rótulos, cabeceras y motion, casi siempre en pleno directo, donde no
        existe el "lo arreglo luego".
      </p>

      <div class="grafismo-hero__timecode mono" aria-hidden="true">
        <span id="timecode">00:00:00:00</span>
      </div>

      <div class="grafismo-hero__frame" aria-hidden="true">
        <div class="frame-corner frame-corner--tl"></div>
        <div class="frame-corner frame-corner--tr"></div>
        <div class="frame-corner frame-corner--bl"></div>
        <div class="frame-corner frame-corner--br"></div>
      </div>
    </div>
  </section>

  <!-- Experience bar -->
  <section class="grafismo-exp section" id="experiencia">
    <div class="container">
      <div class="grafismo-exp__bar" data-animate="fade-up">
        <div class="grafismo-exp__item">
          <span class="grafismo-exp__value">Mediaset</span>
          <span class="grafismo-exp__label mono">Actual</span>
        </div>
        <div class="grafismo-exp__divider"></div>
        <div class="grafismo-exp__item">
          <span class="grafismo-exp__value">RTVE</span>
          <span class="grafismo-exp__label mono">Nacional</span>
        </div>
        <div class="grafismo-exp__divider"></div>
        <div class="grafismo-exp__item">
          <span class="grafismo-exp__value">Movistar+</span>
          <span class="grafismo-exp__label mono">Plataforma</span>
        </div>
        <div class="grafismo-exp__divider"></div>
        <div class="grafismo-exp__item">
          <span class="grafismo-exp__value">5+ años</span>
          <span class="grafismo-exp__label mono">Experiencia</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Channel toggle + Video showcase -->
  <section class="grafismo-showcase section" id="trabajo-seleccionado">
    <div class="container">
      <div class="grafismo-showcase__header">
        <span class="mono grafismo-section-label" data-animate="fade-up">Trabajo seleccionado</span>
        <h2 class="grafismo-section-title" data-animate="title-reveal">
          <span class="title-line"><span class="title-line__inner">Lo que sale en pantalla</span></span>
        </h2>
        <p class="grafismo-section-desc" data-animate="fade-up">
          Casi todo hecho a contrarreloj, con el programa en directo.
        </p>
      </div>

      <!-- Zona de canal: la pantalla y su mando comparten caja, y el mando
           vive dentro de la imagen, como el menú de una tele. La capa mide
           16:9 sobre el ancho de la zona, que es exactamente lo que ocupa el
           monitor, así el mando siempre cae dentro de la pantalla. -->
      <div class="canal-zona">
        <div class="canal-capa">
          <div class="canal-mando" id="canal-mando">
            <button
              class="canal-chapa mono"
              id="canal-chapa"
              type="button"
              aria-expanded="false"
              aria-controls="canal-osd"
            >
              <i aria-hidden="true"></i>
              <b id="canal-chapa-num">CH 01 / 04</b>
              <span id="canal-chapa-nombre">Grafismos</span>
              <em aria-hidden="true">▾</em>
            </button>

            <div class="channel-switch" id="canal-osd" aria-label="Canales">
        <button
          class="channel-switch__btn channel-switch__btn--active"
          data-channel="sin-ia"
          type="button"
          aria-pressed="true"
        >
          <span class="channel-switch__meta">
            <span class="channel-switch__num mono">01</span>
            <span class="channel-switch__signal" aria-hidden="true"></span>
          </span>
          <span class="channel-switch__label">Grafismos</span>
        </button>
        <button class="channel-switch__btn" data-channel="ia" type="button" aria-pressed="false">
          <span class="channel-switch__meta">
            <span class="channel-switch__num mono">02</span>
            <span class="channel-switch__signal" aria-hidden="true"></span>
          </span>
          <span class="channel-switch__label">IA Generativa</span>
        </button>
        <button class="channel-switch__btn" data-channel="cabeceras" type="button" aria-pressed="false">
          <span class="channel-switch__meta">
            <span class="channel-switch__num mono">03</span>
            <span class="channel-switch__signal" aria-hidden="true"></span>
          </span>
          <span class="channel-switch__label">Producciones</span>
        </button>
        <button class="channel-switch__btn" data-channel="christmas" type="button" aria-pressed="false">
          <span class="channel-switch__meta">
            <span class="channel-switch__num mono">04</span>
            <span class="channel-switch__signal" aria-hidden="true"></span>
          </span>
          <span class="channel-switch__label">Corporativo</span>
        </button>
            </div>
          </div>
        </div>

      <!-- Glitch overlay for channel transition -->
      <div class="channel-glitch" id="channel-glitch" aria-hidden="true">
        <div class="channel-glitch__rgb channel-glitch__rgb--r"></div>
        <div class="channel-glitch__rgb channel-glitch__rgb--g"></div>
        <div class="channel-glitch__rgb channel-glitch__rgb--b"></div>
        <div class="channel-glitch__static"></div>
        <div class="channel-glitch__bars"></div>
        <div class="channel-glitch__text mono" id="glitch-channel-text">
          <span class="channel-glitch__num" id="glitch-channel-num">CH 01</span>
          <span class="channel-glitch__name" id="glitch-channel-name">Grafismos</span>
        </div>
      </div>

      <!-- CH 01 -->
      <div class="video-showcase" id="grid-sin-ia">
        <ChannelEmision folder="sin-ia" pieces={broadcastChannel} channel="Grafismos" />
      </div>

      <!-- CH 02 -->
      <div class="video-showcase video-showcase--hidden" id="grid-ia">
        <ChannelEmision folder="ia" pieces={generativeChannel} channel="IA Generativa" />
      </div>

      <!-- Cabeceras grid (CH 03) -->
      <div class="video-showcase video-showcase--hidden" id="grid-cabeceras">
        <div class="cabecera-player">
          <div class="cabecera-player__frame" data-canal-pantalla>
            <div class="cabecera-player__corner cabecera-player__corner--tl"></div>
            <div class="cabecera-player__corner cabecera-player__corner--tr"></div>
            <div class="cabecera-player__corner cabecera-player__corner--bl"></div>
            <div class="cabecera-player__corner cabecera-player__corner--br"></div>

            <video
              id="cabecera-video"
              preload="none"
              playsinline
              controls
              poster="/media/grafismo/cabeceras/cabecera-zapatero-poster.jpg"
            >
              <source data-src="/media/grafismo/cabeceras/cabecera-zapatero.mp4" type="video/mp4" />
            </video>

            <iframe
              id="cabecera-youtube"
              class="cabecera-player__youtube cabecera-player__youtube--hidden"
              width="960"
              height="540"
              src="about:blank"
              title="YouTube video player"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>

            <button class="cabecera-player__fullscreen" id="cabecera-fullscreen" type="button" aria-label="Pantalla completa">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/>
                <line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/>
              </svg>
            </button>
          </div>

          <div class="cabecera-player__selector">
            <button class="cabecera-player__prev" id="cabecera-prev" type="button" aria-label="Anterior">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>

            <div class="cabecera-player__thumbs" id="cabecera-thumbs">
              <button class="cabecera-thumb cabecera-thumb--active" data-index="0" type="button">
                <img src="/media/grafismo/cabeceras/cabecera-zapatero-poster.jpg" alt="Cabecera Zapatero" width="1920" height="1080" loading="lazy" decoding="async" />
                <span class="mono">Cabecera Zapatero</span>
              </button>
              <button class="cabecera-thumb" data-index="1" type="button">
                <img src="/media/grafismo/cabeceras/personas-bestias-poster.jpg" alt="Personas Bestias" width="1920" height="1080" loading="lazy" decoding="async" />
                <span class="mono">Personas Bestias</span>
              </button>
              <button class="cabecera-thumb" data-index="2" type="button">
                {/* Servida desde el propio dominio, no desde img.youtube.com: el
                    <iframe> de abajo ya espera a `about:blank` hasta que se pulsa,
                    y esta miniatura era el único contacto con Google al cargar. */}
                <img src="/media/grafismo/cabeceras/midas-alonso-poster.jpg" alt="Midas Alonso" width="1280" height="720" loading="lazy" decoding="async" />
                <span class="mono">Midas Alonso</span>
              </button>
            </div>

            <button class="cabecera-player__next" id="cabecera-next" type="button" aria-label="Siguiente">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
      </div>
      <!-- Christmas grid (CH 04) -->
      <div class="video-showcase video-showcase--hidden" id="grid-christmas">
        <div class="christmas-intro">
          <span class="mono grafismo-section-label">Diseño corporativo</span>
          <h3 class="christmas-intro__title">Christmas para Producciones Mandarina</h3>
          <p class="christmas-intro__desc">Las felicitaciones de Navidad de la productora, del primer boceto en pantalla a la tarjeta impresa en la mano.</p>
        </div>

        <div class="christmas-pair">
          <figure class="christmas-card">
            <div class="christmas-card__badge mono">Diseño</div>
            <img src="/media/grafismo/christmas/christmas-1.webp" alt="Christmas 1, diseño" width="1400" height="1986" loading="lazy" />
          </figure>
          <figure class="christmas-card christmas-card--photo">
            <div class="christmas-card__badge mono">Impreso</div>
            <img src="/media/grafismo/christmas/foto-christmas-1.webp" alt="Christmas 1, impreso" width="1050" height="1400" loading="lazy" />
          </figure>
        </div>

        <div class="christmas-pair">
          <figure class="christmas-card">
            <div class="christmas-card__badge mono">Diseño</div>
            <img src="/media/grafismo/christmas/christmas-2.webp" alt="Christmas 2, diseño" width="1400" height="1980" loading="lazy" />
          </figure>
          <figure class="christmas-card christmas-card--photo">
            <div class="christmas-card__badge mono">Impreso</div>
            <img src="/media/grafismo/christmas/foto-christmas-2.webp" alt="Christmas 2, impreso" width="1400" height="1867" loading="lazy" />
          </figure>
        </div>
      </div>
      </div>
    </div>
  </section>

  <!-- Tools -->
  <section class="grafismo-tools section" id="herramientas">
    <div class="container">
      <div class="grafismo-tools__header">
        <span class="mono grafismo-section-label" data-animate="fade-up">Herramientas</span>
        <h2 class="grafismo-section-title" data-animate="title-reveal">
          <span class="title-line"><span class="title-line__inner">Stack técnico</span></span>
        </h2>
      </div>

      <div class="grafismo-tools__grid" data-animate="stagger">
        <div class="tool-card">
          <div class="tool-card__icon">
            <img src="/media/logos/Adobe_After_Effects_CC_icon.svg" alt="After Effects" width="48" height="48" loading="lazy" decoding="async" />
          </div>
          <span class="tool-card__name">After Effects</span>
          <span class="tool-card__role mono">Motion & Compositing</span>
        </div>
        <div class="tool-card">
          <div class="tool-card__icon">
            <img src="/media/logos/Adobe_Photoshop_CC_icon.svg" alt="Photoshop" width="48" height="48" loading="lazy" decoding="async" />
          </div>
          <span class="tool-card__name">Photoshop</span>
          <span class="tool-card__role mono">Diseño & Retoque</span>
        </div>
        <div class="tool-card">
          <div class="tool-card__icon">
            <img src="/media/logos/Adobe_Illustrator_CC_icon.svg" alt="Illustrator" width="48" height="48" loading="lazy" decoding="async" />
          </div>
          <span class="tool-card__name">Illustrator</span>
          <span class="tool-card__role mono">Vectorial & Gráfica</span>
        </div>
        <div class="tool-card">
          <div class="tool-card__icon">
            <img src="/media/logos/Adobe_Premiere_Pro_CC_icon.svg" alt="Premiere Pro" width="48" height="48" loading="lazy" decoding="async" />
          </div>
          <span class="tool-card__name">Premiere Pro</span>
          <span class="tool-card__role mono">Edición & Montaje</span>
        </div>
        <div class="tool-card">
          <div class="tool-card__icon">
            <img src="/media/logos/ChatGPT_logo.svg" alt="ChatGPT" width="48" height="48" loading="lazy" decoding="async" />
          </div>
          <span class="tool-card__name">ChatGPT</span>
          <span class="tool-card__role mono">IA Generativa</span>
        </div>
        <div class="tool-card">
          <div class="tool-card__icon">
            <img src="/media/logos/magnific-logo.svg" alt="Magnific" width="48" height="48" loading="lazy" decoding="async" />
          </div>
          <span class="tool-card__name">Magnific</span>
          <span class="tool-card__role mono">IA Generativa</span>
        </div>
      </div>
    </div>
  </section>

  <ProjectCTA
    eyebrow="¿Hablamos?"
    title="¿Necesitas una gráfica que aguante el directo?"
    text="Puedo ayudarte con una cabecera, un paquete de rótulos o un sistema de motion completo, desde la idea hasta la entrega."
    subject="Proyecto de grafismo"
  />

  <!-- Visor grande. Uno solo para toda la página; el JS lo rellena con la
       pieza pulsada.

       Es un <dialog> abierto con showModal() y no un div: `.section-page`
       lleva `isolation: isolate`, así que cualquier z-index de aquí dentro
       solo compite dentro de la página, y el robot, que cuelga de <body>,
       quedaba por encima y se podía pulsar. showModal() lo lleva a la capa
       superior del navegador, que ignora los contextos de apilamiento. -->
  <dialog class="gviewer" id="gviewer" aria-label="Pieza a pantalla completa">
    <div class="gviewer__backdrop" data-gviewer-close></div>

    <div class="gviewer__stage">
      <div class="gviewer__frame">
        <div class="cabecera-player__corner cabecera-player__corner--tl"></div>
        <div class="cabecera-player__corner cabecera-player__corner--tr"></div>
        <div class="cabecera-player__corner cabecera-player__corner--bl"></div>
        <div class="cabecera-player__corner cabecera-player__corner--br"></div>
        <video id="gviewer-video" playsinline controls preload="none"></video>
      </div>

      <div class="gviewer__bar">
        <span class="gviewer__title mono" id="gviewer-title"></span>
        <span class="gviewer__meta">
          <span class="gviewer__silent" id="gviewer-silent" title="Esta pieza no tiene sonido" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M11 5 6 9H2v6h4l5 4z"/>
              <line x1="22" y1="9" x2="16" y2="15"/>
              <line x1="16" y1="9" x2="22" y2="15"/>
            </svg>
            <span class="sr-only">Sin sonido</span>
          </span>
          <span class="gviewer__count mono" id="gviewer-count"></span>
        </span>
      </div>
    </div>

    <button class="gviewer__btn gviewer__btn--close" id="gviewer-close" type="button" aria-label="Cerrar">✕</button>
    <button class="gviewer__btn gviewer__btn--prev" id="gviewer-prev" type="button" aria-label="Pieza anterior">‹</button>
    <button class="gviewer__btn gviewer__btn--next" id="gviewer-next" type="button" aria-label="Pieza siguiente">›</button>
  </div>
</SectionLayout>

<style>
  /* ── Hero Broadcast ── */
  .grafismo-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    padding-top: 80px;
    background: var(--grafismo-bg);
    overflow: hidden;
  }

  .grafismo-hero__overlay {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 212, 255, 0.015) 2px,
        rgba(0, 212, 255, 0.015) 4px
      );
    pointer-events: none;
  }

  .scanline {
    position: absolute;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(0, 212, 255, 0.15), transparent);
    animation: scanline 4s linear infinite;
    opacity: 0.6;
  }

  .grafismo-hero__content {
    position: relative;
    z-index: 1;
    padding-top: var(--space-xl);
    padding-bottom: var(--space-3xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .grafismo-hero__labels {
    display: flex;
    justify-content: center;
    gap: var(--space-m);
    margin-bottom: var(--space-xl);
  }

  .grafismo-label {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--grafismo-primary);
    padding: 0.2em 0.6em;
    border: 1px solid var(--grafismo-border);
    animation: pulse 3s ease-in-out infinite;
  }

  .grafismo-label:first-child {
    color: var(--grafismo-accent);
    border-color: rgba(255, 23, 68, 0.3);
  }

  .grafismo-hero__timecode {
    font-size: var(--step-1);
    color: var(--grafismo-primary);
    opacity: 0.4;
    letter-spacing: 0.15em;
    text-align: center;
    margin-top: var(--space-l);
  }

  .grafismo-hero__title {
    font-size: clamp(3rem, 2rem + 7vw, 8rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.04em;
    color: var(--grafismo-text);
    margin-bottom: var(--space-l);
  }

  @media (max-width: 768px) {
    .grafismo-hero__title {
      font-size: clamp(2rem, 1.2rem + 5.5vw, 3.2rem);
    }

    .grafismo-hero__subtitle {
      font-size: var(--step--1);
      max-width: 30ch;
    }
  }

  .grafismo-hero__accent {
    color: var(--grafismo-primary);
    text-shadow: 0 0 40px rgba(0, 212, 255, 0.3);
  }

  .grafismo-hero__subtitle {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--grafismo-text);
    opacity: 0.65;
    max-width: 50ch;
    text-align: center;
  }

  /* Frame corners */
  .grafismo-hero__frame {
    position: absolute;
    inset: var(--space-l);
    pointer-events: none;
  }

  .frame-corner {
    position: absolute;
    width: 24px;
    height: 24px;
    border-color: var(--grafismo-primary);
    opacity: 0.3;
  }

  .frame-corner--tl { top: 0; left: 0; border-top: 1px solid; border-left: 1px solid; }
  .frame-corner--tr { top: 0; right: 0; border-top: 1px solid; border-right: 1px solid; }
  .frame-corner--bl { bottom: 0; left: 0; border-bottom: 1px solid; border-left: 1px solid; }
  .frame-corner--br { bottom: 0; right: 0; border-bottom: 1px solid; border-right: 1px solid; }

  /* ── Experience Bar ── */
  .grafismo-exp__bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-l);
    padding: var(--space-l);
    border: 1px solid var(--grafismo-border);
    border-radius: var(--radius-md);
    background: var(--grafismo-surface);
    flex-wrap: wrap;
  }

  .grafismo-exp__item {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .grafismo-exp__value {
    font-family: 'Syne Variable', sans-serif;
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--grafismo-text);
  }

  .grafismo-exp__label {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--grafismo-primary);
  }

  .grafismo-exp__divider {
    width: 1px;
    height: 40px;
    background: var(--grafismo-border);
  }

  /* ── Section headings ── */
  .grafismo-section-label {
    display: block;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--grafismo-text);
    opacity: 0.7;
    margin-bottom: var(--space-xs);
    text-align: center;
  }

  .grafismo-section-title {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    color: var(--grafismo-text);
    margin-bottom: var(--space-s);
    text-align: center;
  }

  .grafismo-section-desc {
    color: var(--grafismo-text);
    opacity: 0.6;
    max-width: 55ch;
    line-height: 1.7;
    text-align: center;
    margin-inline: auto;
  }

  /* ── Mando en pantalla ──
     El selector vive dentro del monitor, como el menú de una tele: asoma
     al acercarse a la chapa de canal y se recoge solo. Antes era una tira
     de botones fuera de la imagen; con el monitor grande debajo no
     pertenecía a nada, y ocupaba sitio para no decir nada nuevo.
     Un mando que se esconde corre el riesgo de no encontrarse, así que la
     chapa está siempre puesta, con su flecha, y se abre también pulsándola
     (en táctil no hay otra). Además se enseña sola la primera vez. */
  .canal-zona {
    position: relative;
    margin-top: var(--space-xl);
  }

  /* La capa se ajusta a la pantalla del canal que está a la vista, que mide
     el JS. No todos los canales son un monitor a ancho completo: el
     reproductor de cabeceras es más estrecho y va centrado, y con la capa
     fija en 16:9 desde el borde la chapa se quedaba 75 px fuera de la
     imagen. Sin JS valen los valores por defecto, que son los del monitor. */
  .canal-capa {
    position: absolute;
    top: var(--capa-top, 0px);
    left: var(--capa-left, 0px);
    z-index: 4;
    width: var(--capa-w, 100%);
    height: var(--capa-h, auto);
    aspect-ratio: 16 / 9;
    pointer-events: none;
  }

  .canal-mando {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    align-items: center;
    pointer-events: auto;
  }

  /* Un canal sin pantalla no tiene dónde meter el mando sin taparle algo:
     Corporativo es material impreso y empieza por un bloque de texto
     centrado, así que la chapa se le quedaba encima. Ahí se posa arriba,
     en el flujo, y la lista baja como un desplegable. */
  .canal-zona--dock .canal-capa {
    position: relative;
    width: auto;
    height: auto;
    aspect-ratio: auto;
    margin-bottom: var(--space-s);
  }

  .canal-zona--dock .canal-mando {
    position: relative;
    inset: auto;
    display: inline-flex;
  }

  .canal-zona--dock .canal-chapa {
    position: relative;
    top: auto;
    left: auto;
  }

  .canal-zona--dock .channel-switch {
    inset: calc(100% + 6px) auto auto 0;
    justify-content: flex-start;
    width: min(240px, 74vw);
    padding: 0.45rem 0.9rem 0.6rem;
    border-radius: 4px;
    background: rgba(5, 5, 16, 0.95);
  }

  .canal-chapa {
    position: absolute;
    top: 22px;
    left: 48px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.34rem 0.62rem;
    border: 0;
    border-radius: 4px;
    background: rgba(5, 5, 16, 0.55);
    backdrop-filter: blur(6px);
    color: rgba(240, 240, 240, 0.8);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    white-space: nowrap;
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .canal-chapa:hover,
  .canal-chapa:focus-visible {
    color: #fff;
    outline: none;
  }

  .canal-chapa b {
    font-weight: 400;
    color: var(--grafismo-primary);
  }

  /* El punto rojo solo se enciende con algo de verdad en antena. */
  .canal-chapa i {
    display: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--grafismo-accent);
    box-shadow: 0 0 10px var(--grafismo-accent);
    animation: rec-blink 1.5s ease-in-out infinite;
  }

  .canal-chapa--antena i {
    display: block;
  }

  .canal-chapa em {
    font-style: normal;
    opacity: 0.5;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .canal-mando--abierto .canal-chapa em {
    transform: rotate(180deg);
  }

  /* Pista de descubrimiento: la flecha late hasta el primer gesto real del
     visitante. Se apaga en cuanto abre el mando de verdad. */
  .canal-mando--pista:not(.canal-mando--abierto) .canal-chapa em {
    animation: chapa-latido 1.8s ease-in-out infinite;
  }

  @keyframes chapa-latido {
    0%, 100% { opacity: 0.5; transform: translateY(0); }
    50%      { opacity: 1;   transform: translateY(1px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .canal-mando--pista:not(.canal-mando--abierto) .canal-chapa em {
      animation: none;
      opacity: 1;
    }
  }

  .channel-switch {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    width: min(320px, 42vw);
    padding: 0 1.2rem 0 2.6rem;
    background: linear-gradient(to right, rgba(5, 5, 16, 0.94) 45%, transparent);
    opacity: 0;
    transform: translateX(-14px);
    pointer-events: none;
    transition: opacity 0.28s var(--ease-out), transform 0.28s var(--ease-out);
  }

  .canal-mando--abierto .channel-switch {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .channel-switch__btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.6rem;
    background: transparent;
    border: 0;
    border-left: 2px solid transparent;
    cursor: pointer;
    text-align: left;
    color: var(--grafismo-text);
    opacity: 0.5;
    transition: opacity 0.25s ease, background 0.25s ease;
  }

  .channel-switch__btn:hover,
  .channel-switch__btn:focus-visible {
    opacity: 0.9;
    outline: none;
  }

  .channel-switch__btn--active {
    opacity: 1;
    border-left-color: var(--grafismo-primary);
    background: color-mix(in srgb, var(--grafismo-primary) 7%, transparent);
  }

  .channel-switch__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .channel-switch__num {
    font-size: var(--step--2);
    letter-spacing: 0.18em;
    opacity: 0.55;
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .channel-switch__btn--active .channel-switch__num {
    color: var(--grafismo-primary);
    opacity: 1;
  }

  .channel-switch__signal {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--grafismo-accent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .channel-switch__btn--active .channel-switch__signal {
    opacity: 1;
    box-shadow: 0 0 8px rgba(255, 23, 68, 0.6);
    animation: rec-blink 1.5s ease-in-out infinite;
  }

  @keyframes rec-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.25; }
  }

  .channel-switch__label {
    font-family: 'Syne Variable', sans-serif;
    font-size: var(--step--1);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .channel-switch,
    .canal-chapa em {
      transition: none;
    }

    .channel-switch__btn--active .channel-switch__signal {
      animation: none;
    }
  }

  /* ── Glitch transition overlay ── */
  .channel-glitch {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  .channel-glitch.glitch--active {
    opacity: 1;
    visibility: visible;
    animation: glitch-master 0.7s steps(6) forwards;
  }

  /* RGB chromatic split layers */
  .channel-glitch__rgb {
    position: absolute;
    inset: 0;
    mix-blend-mode: screen;
    opacity: 0;
  }

  .glitch--active .channel-glitch__rgb--r {
    background: rgba(255, 0, 0, 0.15);
    animation: glitch-rgb-r 0.7s steps(3) forwards;
  }

  .glitch--active .channel-glitch__rgb--g {
    background: rgba(0, 255, 0, 0.1);
    animation: glitch-rgb-g 0.7s steps(4) forwards;
  }

  .glitch--active .channel-glitch__rgb--b {
    background: rgba(0, 100, 255, 0.15);
    animation: glitch-rgb-b 0.7s steps(3) forwards;
  }

  @keyframes glitch-rgb-r {
    0%   { opacity: 0; transform: translate(0, 0); }
    10%  { opacity: 1; transform: translate(-8px, 2px); }
    25%  { opacity: 0.8; transform: translate(12px, -3px); }
    40%  { opacity: 1; transform: translate(-5px, 1px); }
    60%  { opacity: 0.6; transform: translate(6px, -1px); }
    80%  { opacity: 0.3; transform: translate(-2px, 0); }
    100% { opacity: 0; transform: translate(0, 0); }
  }

  @keyframes glitch-rgb-g {
    0%   { opacity: 0; transform: translate(0, 0); }
    15%  { opacity: 0.8; transform: translate(6px, -4px); }
    30%  { opacity: 1; transform: translate(-10px, 2px); }
    50%  { opacity: 0.7; transform: translate(4px, 3px); }
    70%  { opacity: 0.4; transform: translate(-3px, -1px); }
    100% { opacity: 0; transform: translate(0, 0); }
  }

  @keyframes glitch-rgb-b {
    0%   { opacity: 0; transform: translate(0, 0); }
    12%  { opacity: 1; transform: translate(10px, 3px); }
    28%  { opacity: 0.9; transform: translate(-8px, -2px); }
    45%  { opacity: 1; transform: translate(5px, -4px); }
    65%  { opacity: 0.5; transform: translate(-4px, 2px); }
    85%  { opacity: 0.2; transform: translate(2px, 0); }
    100% { opacity: 0; transform: translate(0, 0); }
  }

  .channel-glitch__static {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(
        0deg,
        transparent 0px,
        rgba(0, 212, 255, 0.06) 1px,
        transparent 2px
      ),
      repeating-linear-gradient(
        90deg,
        transparent 0px,
        rgba(255, 255, 255, 0.02) 1px,
        transparent 3px
      );
    mix-blend-mode: screen;
  }

  .channel-glitch__static::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='5' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.6'/%3E%3C/svg%3E");
    background-size: 256px 256px;
    opacity: 0;
  }

  .glitch--active .channel-glitch__static::before {
    animation: glitch-noise 0.7s steps(8) forwards;
  }

  @keyframes glitch-noise {
    0%   { opacity: 0; }
    10%  { opacity: 0.9; }
    20%  { opacity: 0.4; }
    35%  { opacity: 1; }
    50%  { opacity: 0.7; }
    65%  { opacity: 0.5; }
    80%  { opacity: 0.2; }
    100% { opacity: 0; }
  }

  .channel-glitch__bars {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 2px,
      rgba(0, 0, 0, 0.25) 2px,
      rgba(0, 0, 0, 0.25) 4px
    );
    opacity: 0;
  }

  .glitch--active .channel-glitch__bars {
    animation: glitch-bars 0.7s steps(4) forwards;
  }

  @keyframes glitch-bars {
    0%   { opacity: 0; transform: translateY(0); }
    15%  { opacity: 0.8; transform: translateY(-30%); }
    30%  { opacity: 1; transform: translateY(15%); }
    50%  { opacity: 0.7; transform: translateY(-10%); }
    70%  { opacity: 0.4; transform: translateY(5%); }
    100% { opacity: 0; transform: translateY(0); }
  }

  /* Channel number text flash */
  .channel-glitch__text {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.12em;
    color: white;
    opacity: 0;
    text-shadow:
      3px 0 rgba(255, 0, 0, 0.7),
      -3px 0 rgba(0, 100, 255, 0.7),
      0 0 40px rgba(0, 212, 255, 0.5);
    white-space: nowrap;
  }

  .channel-glitch__num {
    font-size: clamp(3.5rem, 2.6rem + 5.4vw, 9rem);
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1;
  }

  /* El nombre va mucho más pequeño a propósito: en monoespaciada, "IA
     GENERATIVA" al tamaño del número se saldría del viewport. */
  .channel-glitch__name {
    font-size: clamp(0.8rem, 0.6rem + 0.9vw, 1.5rem);
    font-weight: 500;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--grafismo-primary);
    /* compensa el hueco que deja el letter-spacing al final */
    text-indent: 0.4em;
  }

  .glitch--active .channel-glitch__text {
    animation: glitch-ch-text 0.7s steps(3) forwards;
  }

  @keyframes glitch-ch-text {
    0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.8); }
    12%  { opacity: 1; transform: translate(-48%, -52%) scale(1.05); }
    25%  { opacity: 0.8; transform: translate(-53%, -48%) scale(1); }
    40%  { opacity: 1; transform: translate(-50%, -50%) scale(1.02); }
    55%  { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    75%  { opacity: 0.2; transform: translate(-50%, -50%) scale(0.98); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(1); }
  }

  @keyframes glitch-master {
    0%   { opacity: 0; background: rgba(5, 5, 16, 0.97); }
    8%   { opacity: 1; background: rgba(255, 255, 255, 0.15); }
    16%  { opacity: 1; background: rgba(5, 5, 16, 0.95); }
    25%  { opacity: 1; background: rgba(0, 212, 255, 0.12); }
    35%  { opacity: 1; background: rgba(255, 255, 255, 0.2); }
    45%  { opacity: 1; background: rgba(5, 5, 16, 0.9); }
    55%  { opacity: 0.9; background: rgba(0, 212, 255, 0.08); }
    65%  { opacity: 0.7; background: rgba(5, 5, 16, 0.7); }
    78%  { opacity: 0.4; background: rgba(5, 5, 16, 0.4); }
    90%  { opacity: 0.15; background: rgba(5, 5, 16, 0.2); }
    100% { opacity: 0; visibility: hidden; }
  }

  /* ── Video showcase grid ── */
  .grafismo-showcase__header {
    margin-bottom: var(--space-l);
    text-align: center;
  }

  .video-showcase {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: var(--space-m);
    transition: opacity 0.3s ease;
  }

  .video-showcase--hidden {
    display: none;
  }

  .video-showcase--fade-out {
    opacity: 0;
    pointer-events: none;
  }

  /* ── Cabecera Player (CH 03) ── */
  .cabecera-player {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-l);
    grid-column: 1 / -1;
  }

  .cabecera-player__frame {
    position: relative;
    width: 100%;
    max-width: 960px;
    border: 1px solid var(--grafismo-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    background: #000;
  }

  .cabecera-player__frame video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: contain;
    background: #000;
  }

  .cabecera-player__corner {
    position: absolute;
    width: 20px;
    height: 20px;
    border-color: var(--grafismo-primary);
    z-index: 2;
    pointer-events: none;
    opacity: 0.5;
  }

  .cabecera-player__youtube {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    background: #000;
  }

  .cabecera-player__youtube--hidden {
    display: none;
  }

  .cabecera-player__corner--tl { top: 8px; left: 8px; border-top: 2px solid; border-left: 2px solid; }
  .cabecera-player__corner--tr { top: 8px; right: 8px; border-top: 2px solid; border-right: 2px solid; }
  .cabecera-player__corner--bl { bottom: 8px; left: 8px; border-bottom: 2px solid; border-left: 2px solid; }
  .cabecera-player__corner--br { bottom: 8px; right: 8px; border-bottom: 2px solid; border-right: 2px solid; }

  .cabecera-player__fullscreen {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 3;
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid var(--grafismo-border);
    border-radius: var(--radius-sm);
    color: var(--grafismo-primary);
    padding: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cabecera-player__fullscreen:hover {
    background: rgba(0, 212, 255, 0.15);
    border-color: var(--grafismo-primary);
  }

  .cabecera-player__selector {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    width: 100%;
    max-width: 960px;
  }

  .cabecera-player__prev,
  .cabecera-player__next {
    flex-shrink: 0;
    background: var(--grafismo-surface);
    border: 1px solid var(--grafismo-border);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--grafismo-text);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cabecera-player__prev:hover,
  .cabecera-player__next:hover {
    border-color: var(--grafismo-primary);
    color: var(--grafismo-primary);
    background: rgba(0, 212, 255, 0.08);
  }

  .cabecera-player__thumbs {
    display: flex;
    gap: var(--space-s);
    flex: 1;
    justify-content: center;
  }

  .cabecera-thumb {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    background: none;
    border: 2px solid var(--grafismo-border);
    border-radius: var(--radius-md);
    padding: 4px;
    cursor: pointer;
    transition: all 0.25s ease;
    opacity: 0.5;
  }

  .cabecera-thumb:hover {
    opacity: 0.8;
    border-color: var(--grafismo-primary);
  }

  .cabecera-thumb--active {
    opacity: 1;
    border-color: var(--grafismo-primary);
    box-shadow: 0 0 12px rgba(0, 212, 255, 0.25);
  }

  .cabecera-thumb img {
    width: 160px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(var(--radius-md) - 4px);
  }

  .cabecera-thumb span {
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--grafismo-text);
    opacity: 0.7;
  }

  .cabecera-thumb--active span {
    color: var(--grafismo-primary);
    opacity: 1;
  }

  /* ── Video cards ── */
  /* ── Visor grande ──
     Va en la capa superior por `showModal()`, así que no depende del
     z-index: el robot y el header quedan detrás pase lo que pase. */
  .gviewer {
    /* Reset de los estilos propios de <dialog> */
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100vw;
    max-height: 100svh;
    margin: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: hidden;

    padding: clamp(1rem, 4vw, 3rem);
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }

  /* Un <dialog> abierto vuelve a `display: block` por defecto. */
  .gviewer[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* La capa oscura la pone `.gviewer__backdrop`, que además recoge el click
     para cerrar. El backdrop nativo se queda transparente. */
  .gviewer::backdrop {
    background: transparent;
  }

  .gviewer.is-open {
    opacity: 1;
  }

  .gviewer__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 7, 9, 0.92);
    backdrop-filter: blur(6px);
  }

  .gviewer__stage {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: min(1200px, 100%);
    transform: scale(0.98);
    transition: transform 0.25s var(--ease-out);
  }

  .gviewer.is-open .gviewer__stage {
    transform: scale(1);
  }

  .gviewer__frame {
    position: relative;
    border: 1px solid var(--grafismo-border);
    background: #000;
    line-height: 0;
  }

  .gviewer__frame video {
    display: block;
    /* El alto manda: así una pieza vertical no se sale de pantalla y una
       apaisada tampoco desborda a lo ancho. El descuento cubre el acolchado
       del visor (6rem como mucho), el rótulo y su hueco. */
    max-width: 100%;
    max-height: calc(100svh - 8.5rem);
    width: auto;
    margin: 0 auto;
  }

  /* Chrome agranda sus propios controles según el tamaño del reproductor, y
     a 1158 px de ancho la barra de volumen queda desproporcionada. Estos
     pseudo-elementos solo los entienden Chrome y Safari; en Firefox los
     controles se quedan con su tamaño de siempre, que ya es discreto. */
  .gviewer__frame video::-webkit-media-controls-volume-slider {
    width: 56px;
    max-width: 56px;
    padding-left: 4px;
    padding-right: 4px;
  }

  .gviewer__frame video::-webkit-media-controls-mute-button {
    width: 28px;
    height: 28px;
  }

  /* En una pieza muda el control de volumen no hace nada: fuera entero.
     El contenedor va aparte del deslizador y del botón; si solo se esconden
     esos dos, queda su hueco reservado en la barra. */
  .gviewer__frame video[data-muda='true']::-webkit-media-controls-volume-control-container,
  .gviewer__frame video[data-muda='true']::-webkit-media-controls-volume-slider,
  .gviewer__frame video[data-muda='true']::-webkit-media-controls-mute-button {
    display: none;
    width: 0;
  }

  .gviewer__bar {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .gviewer__title {
    color: var(--grafismo-primary);
    font-weight: 600;
  }

  /* Centrado, no baseline: el icono de silencio es un SVG sin línea base de
     texto, así que con `baseline` se apoyaba por su borde inferior y quedaba
     descuadrado respecto al contador. Centrado, icono y "2 / 8" se alinean. */
  .gviewer__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .gviewer__count {
    color: var(--grafismo-text);
    opacity: 0.55;
    white-space: nowrap;
  }

  /* Muchas piezas de emisión son mudas por naturaleza: el audio lo pone el
     programa. Un icono basta para que el silencio no parezca un fallo. */
  .gviewer__silent {
    display: inline-flex;
    align-items: center;
    color: var(--grafismo-text);
    opacity: 0.45;
  }

  .gviewer__silent svg {
    width: 1.05rem;
    height: 1.05rem;
  }

  .gviewer__silent[hidden] {
    display: none;
  }

  .gviewer__btn {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid var(--grafismo-border);
    background: rgba(12, 14, 17, 0.75);
    color: var(--grafismo-primary);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out),
                background var(--duration-fast) var(--ease-out);
  }

  .gviewer__btn:hover,
  .gviewer__btn:focus-visible {
    border-color: var(--grafismo-primary);
    background: rgba(12, 14, 17, 0.95);
  }

  .gviewer__btn--close {
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
  }

  .gviewer__btn--prev {
    left: clamp(0.5rem, 2vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
  }

  .gviewer__btn--next {
    right: clamp(0.5rem, 2vw, 1.5rem);
    top: 50%;
    transform: translateY(-50%);
  }

  .gviewer__btn[disabled] {
    opacity: 0.25;
    pointer-events: none;
  }

  /* En móvil las flechas laterales pisarían el vídeo: bajan a una fila
     bajo el rótulo, donde el pulgar llega sin tapar la pieza. */
  @media (max-width: 640px) {
    .gviewer__frame video {
      max-height: calc(100svh - 14rem);
    }

    .gviewer__btn {
      width: 2.75rem;
      height: 2.75rem;
    }

    .gviewer__btn--prev,
    .gviewer__btn--next {
      top: auto;
      bottom: clamp(1rem, 4vw, 2rem);
      transform: none;
    }

    .gviewer__btn--prev {
      left: 50%;
      margin-left: -3.25rem;
    }

    .gviewer__btn--next {
      right: 50%;
      margin-right: -3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gviewer,
    .gviewer__stage {
      transition: none;
    }
  }

  /* ── Christmas Cards (CH 04) ── */
  #grid-christmas {
    display: none;
    flex-direction: column;
    gap: var(--space-xl);
    max-width: 960px;
    margin-inline: auto;
  }

  #grid-christmas:not(.video-showcase--hidden) {
