---
import SectionLayout from '../layouts/SectionLayout.astro';
---

<SectionLayout
  title="Fratelli Pazzi | Guillermo López"
  description="La historia real de Fratelli Pazzi: desde el primer boceto del logo hasta la pizzería napolitana funcionando en Las Rozas."
  theme="fratelli"
>
  <!-- Page content -->
  <div class="fratelli-page" id="fratelli-page">
    <canvas class="fratelli-particles" id="fratelli-particles" aria-hidden="true"></canvas>
    <div class="fratelli-page__chalk" aria-hidden="true"></div>

    <!-- Hero -->
    <section class="fratelli-hero">
      <div class="fratelli-hero__chalk" aria-hidden="true"></div>

      <div class="fratelli-hero__content container">
        <h1 class="fratelli-hero__brand hero-anim hero-anim--1">
          <img
            src="/media/fratelli/logos/logo-definitivo.png"
            alt="Fratelli Pazzi"
            width="1400"
            height="1364"
          />
        </h1>

        <p class="fratelli-hero__subtitle hero-anim hero-anim--2">
          Una pizzería real. Una marca construida desde cero.
        </p>

        <a class="fratelli-hero__scroll hero-anim hero-anim--3" href="#identidad" aria-label="Ver la identidad de Fratelli Pazzi">
          <span aria-hidden="true">↓</span>
        </a>
      </div>
    </section>

    <!-- Chapter 01 — Logo -->
    <section class="fratelli-chapter section" id="identidad">
      <div class="container">
        <div class="chapter-header">
          <span class="fratelli-section-label mono" data-animate="fade-up">Identidad</span>
          <h2 class="fratelli-section-title" data-animate="title-reveal">
            <span class="title-line"><span class="title-line__inner">Las versiones del logo</span></span>
          </h2>
        </div>

        <p class="chapter-text" data-animate="fade-up">
          Una identidad capaz de vivir en cualquier formato.
        </p>

        <div class="media-grid media-grid--logos">
          <figure class="media-tile">
            <img src="/media/fratelli/logos/logo-fondo-blanco.jpg" alt="Logo de Fratelli Pazzi sobre fondo blanco" loading="lazy" decoding="async" />
            <figcaption class="mono">Fondo blanco</figcaption>
          </figure>
          <figure class="media-tile">
            <img src="/media/fratelli/logos/logo-definitivo.png" alt="Logo definitivo de Fratelli Pazzi" loading="lazy" decoding="async" />
            <figcaption class="mono">Logo definitivo</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Chapter 02 — Cartel de entrada -->
    <section class="fratelli-chapter section" id="carteleria">
      <div class="container">
        <div class="chapter-header">
          <span class="fratelli-section-label mono" data-animate="fade-up">Cartelería</span>
          <h2 class="fratelli-section-title" data-animate="title-reveal">
            <span class="title-line"><span class="title-line__inner">El cartel de entrada</span></span>
          </h2>
        </div>

      </div><!-- close .container for full-width signage -->

      <div class="signage-fullwidth">
        <figure class="signage-tile signage-tile--hero">
          <img src="/media/fratelli/signage/final/cartel-entrada.jpg" alt="Diseño del cartel de entrada de Fratelli Pazzi" loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>

    <!-- Chapter 03 — Carta, flyers y marca en sala -->
    <section class="fratelli-chapter section" id="marca-en-sala">
      <div class="container">
        <div class="chapter-header">
          <span class="fratelli-section-label mono" data-animate="fade-up">Experiencia</span>
          <h2 class="fratelli-section-title" data-animate="title-reveal">
            <span class="title-line"><span class="title-line__inner">Carta, flyers y marca en sala</span></span>
          </h2>
        </div>

        <div class="media-grid media-grid--brand">
          <figure class="media-tile">
            <img src="/media/fratelli/menu/menu-fratelli.jpg" alt="Carta / menú de Fratelli Pazzi" loading="lazy" decoding="async" />
            <figcaption class="mono">Carta del restaurante</figcaption>
          </figure>
          <figure class="media-tile">
            <img src="/media/fratelli/menu/flyer-cara-delantera.png" alt="Flyer promocional cara delantera" loading="lazy" decoding="async" />
            <figcaption class="mono">Flyer promocional</figcaption>
          </figure>
          <figure class="media-tile">
            <img src="/media/fratelli/menu/flyer-halloween.png" alt="Flyer de Halloween de Fratelli Pazzi" loading="lazy" decoding="async" />
            <figcaption class="mono">Flyer Halloween</figcaption>
          </figure>
          <figure class="media-tile">
            <img src="/media/fratelli/menu/instagram-template.png" alt="Plantilla de Instagram de Fratelli Pazzi" loading="lazy" decoding="async" />
            <figcaption class="mono">Plantilla Instagram</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Chapter 04 — Vídeos para redes -->
    <section class="fratelli-chapter section" id="contenido">
      <div class="container">
        <div class="chapter-header">
          <span class="fratelli-section-label mono" data-animate="fade-up">Contenido</span>
          <h2 class="fratelli-section-title" data-animate="title-reveal">
            <span class="title-line"><span class="title-line__inner">Vídeos para redes</span></span>
          </h2>
        </div>

        <p class="chapter-text" data-animate="fade-up">
          Producto, cocina y ritmo para Instagram y TikTok.
        </p>

        <!-- Featured video — Pizza del Mes -->
        <div class="video-featured" data-animate="fade-up">
          <div class="video-featured__side video-featured__side--left">
            <div class="vf-deco vf-deco--circle"></div>
            <div class="vf-deco vf-deco--line"></div>
            <span class="vf-deco-text mono">Pizza<br/>del Mes</span>
            <div class="vf-deco vf-deco--dots"></div>
          </div>
          <figure class="video-featured__main">
            <video preload="none" playsinline muted poster="/media/fratelli/videos/reel-promo-cabramelizada-v1-poster.jpg">
              <source data-src="/media/fratelli/videos/reel-promo-cabramelizada-v1.web.mp4" type="video/mp4" />
            </video>
            <figcaption class="mono">Pizza del Mes: promo cabramelizada</figcaption>
          </figure>
          <div class="video-featured__side video-featured__side--right">
            <div class="vf-deco vf-deco--line"></div>
            <div class="vf-deco vf-deco--circle"></div>
            <span class="vf-deco-text mono">Fratelli<br/>Pazzi</span>
            <div class="vf-deco vf-deco--dots"></div>
          </div>
        </div>

        <div class="video-grid">
          <figure class="video-card">
            <video preload="none" playsinline muted poster="/media/fratelli/videos/arreglando-horno-fratelli-pazzi-poster.jpg">
              <source data-src="/media/fratelli/videos/arreglando-horno-fratelli-pazzi.web.mp4" type="video/mp4" />
            </video>
            <figcaption class="mono">Horno de leña</figcaption>
          </figure>
          <figure class="video-card">
            <video preload="none" playsinline muted poster="/media/fratelli/videos/crujido-pizza-v2-poster.jpg">
              <source data-src="/media/fratelli/videos/crujido-pizza-v2.web.mp4" type="video/mp4" />
            </video>
            <figcaption class="mono">Crujido pizza</figcaption>
          </figure>
          <figure class="video-card">
            <video preload="none" playsinline muted poster="/media/fratelli/videos/inicial-l-v2-poster.jpg">
              <source data-src="/media/fratelli/videos/inicial-l-v2.web.mp4" type="video/mp4" />
            </video>
            <figcaption class="mono">Intro marca</figcaption>
          </figure>
          <figure class="video-card">
            <video preload="none" playsinline muted poster="/media/fratelli/videos/timelapse-pizza-v2-poster.jpg">
              <source data-src="/media/fratelli/videos/timelapse-pizza-v2.web.mp4" type="video/mp4" />
            </video>
            <figcaption class="mono">Timelapse pizza</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- Chapter 05 — Vídeos promo TV -->
    <section class="fratelli-chapter section" id="promos-local">
      <div class="container">
        <div class="chapter-header">
          <span class="fratelli-section-label mono" data-animate="fade-up">En sala</span>
          <h2 class="fratelli-section-title" data-animate="title-reveal">
            <span class="title-line"><span class="title-line__inner">Promos para las pantallas del local</span></span>
          </h2>
        </div>

        <div class="promo-grid">
          <figure class="promo-card">
            <video preload="none" playsinline muted loop poster="/media/fratelli/videos/promo-1-poster.jpg">
              <source data-src="/media/fratelli/videos/promo-1.mp4" type="video/mp4" />
            </video>
            <figcaption class="mono">Promo 1 para la tele del local</figcaption>
          </figure>
          <figure class="promo-card">
            <video preload="none" playsinline muted loop poster="/media/fratelli/videos/promo-2-poster.jpg">
              <source data-src="/media/fratelli/videos/promo-2.mp4" type="video/mp4" />
            </video>
            <figcaption class="mono">Promo 2 para la tele del local</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="fratelli-cta section">
      <div class="container">
        <div class="fratelli-cta__inner">
          <h2 class="fratelli-cta__title" data-animate="title-reveal">
            <span class="title-line"><span class="title-line__inner">¿Quieres ver una marca así?</span></span>
          </h2>
          <a href="/#contacto" class="fratelli-cta__btn mono" data-animate="fade-up">
            Hablemos de tu marca →
          </a>
        </div>
      </div>
    </section>

  </div><!-- /.fratelli-page -->
</SectionLayout>

<!-- Hover-play script -->
<script>
  function initFratelli() {
    function ensureVideoSource(vid: HTMLVideoElement) {
      const source = vid.querySelector<HTMLSourceElement>('source[data-src]');
      if (!source?.dataset.src || source.getAttribute('src')) return;
      source.src = source.dataset.src;
      vid.load();
    }

    function playVideo(vid: HTMLVideoElement) {
      ensureVideoSource(vid);
      vid.muted = true;
      vid.play().catch(() => {});
    }

    // Hover autoplay for all video containers (featured + cards)
    document.querySelectorAll('.video-card, .video-featured, .promo-card').forEach((container) => {
      const vid = container.querySelector<HTMLVideoElement>('video');
      if (!vid) return;
      container.addEventListener('mouseenter', () => {
        playVideo(vid);
      });
      container.addEventListener('mouseleave', () => {
        vid.pause();
        vid.currentTime = 0;
        vid.muted = true;
      });
      container.addEventListener('click', () => {
        if (vid.paused) {
          playVideo(vid);
          return;
        }
        vid.muted = !vid.muted;
      });
    });
  }

  document.addEventListener('astro:page-load', initFratelli);

  /* ── Fratelli Pizza Particle System ── */
  function initFratelliParticles() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const canvas = document.getElementById('fratelli-particles') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const page = document.getElementById('fratelli-page');
    let w = 0, h = 0;
    let raf = 0;
    let mouse = { x: -9999, y: -9999 };
    let scrollY = 0;
    let pageBottom = Infinity;

    interface Slice {
      x: number; y: number;
      vx: number; vy: number;
      size: number; baseAlpha: number;
      phase: number; speed: number;
      color: [number, number, number];
      crustColor: [number, number, number];
      rotation: number; rotSpeed: number;
      wobbleAmp: number;
    }

    let slices: Slice[] = [];

    // Fratelli palette for the slice body
    const bodyColors: [number, number, number][] = [
      [244, 179, 78],   // baked cheese
      [230, 125, 64],   // tomato edge
      [255, 216, 112],  // mozzarella highlight
      [238, 151, 69],   // toasted dough
    ];

    // Crust is always a warm brown/golden tone
    const crustColors: [number, number, number][] = [
      [204, 139, 64],
      [176, 104, 48],
      [226, 164, 82],
    ];

    function resize() {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    }

    function updatePageBounds() {
      if (page) {
        const rect = page.getBoundingClientRect();
        pageBottom = rect.bottom;
      }
    }

    function createSlices() {
      const count = Math.min(Math.max(Math.floor((w * h) / 76000), 14), 26);
      slices = [];
      for (let i = 0; i < count; i++) {
        slices.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.08,
          vy: -(Math.random() * 0.1 + 0.025),
          size: Math.random() * 20 + 16,
          baseAlpha: Math.random() * 0.075 + 0.025,
          phase: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.008 + 0.003,
          color: bodyColors[Math.floor(Math.random() * bodyColors.length)],
          crustColor: crustColors[Math.floor(Math.random() * crustColors.length)],
          rotation: Math.random() * Math.PI * 2,
          rotSpeed: (Math.random() - 0.5) * 0.008,
          wobbleAmp: Math.random() * 0.5 + 0.15,
        });
      }
    }

    function drawPizzaSlice(x: number, y: number, size: number, rot: number, bodyRgb: [number,number,number], crustRgb: [number,number,number], alpha: number) {
      const c = ctx!;
      const angle = Math.PI / 3; // 60° sector

      c.save();
      c.translate(x, y);
      c.rotate(rot);
      c.globalAlpha = alpha;

      // Slice body (sector)
      c.beginPath();
      c.moveTo(0, 0);
      c.arc(0, 0, size, -angle / 2, angle / 2);
      c.closePath();
      const [br, bg, bb] = bodyRgb;
      c.fillStyle = `rgb(${br}, ${bg}, ${bb})`;
      c.fill();

      // Crust arc (thicker outer edge)
      const crustWidth = size * 0.18;
      c.beginPath();
      c.arc(0, 0, size, -angle / 2, angle / 2);
      c.strokeStyle = `rgb(${crustRgb[0]}, ${crustRgb[1]}, ${crustRgb[2]})`;
      c.lineWidth = crustWidth;
      c.lineCap = 'round';
      c.stroke();

      c.globalAlpha = 1;
      c.restore();
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);

      // Don't draw if we've scrolled past the page into footer
      updatePageBounds();
      const visible = pageBottom > 0;
      if (!visible) {
        raf = requestAnimationFrame(draw);
        return;
      }

      for (const s of slices) {
        s.phase += s.speed;
        s.x += s.vx + Math.sin(s.phase * 2.5) * s.wobbleAmp * 0.25;
        s.y += s.vy;
        s.rotation += s.rotSpeed;

        // Wrap
        if (s.y < -40) { s.y = h + 40; s.x = Math.random() * w; }
        if (s.x < -40) s.x = w + 40;
        if (s.x > w + 40) s.x = -40;

        // Mouse attraction
        const dx = mouse.x - s.x;
        const dy = mouse.y - s.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < 200 && dist > 0) {
          const force = (200 - dist) / 200 * 0.12;
          s.x += (dx / dist) * force;
          s.y += (dy / dist) * force;
          // Spin faster near mouse
          s.rotation += (dx > 0 ? 1 : -1) * force * 0.02;
        }

        // Scroll parallax with continuous wrapping. Larger slices travel a
        // little faster, so the field keeps depth without ever disappearing.
        const scrollSpeed = 0.1 + (s.size / 36) * 0.12;
        const parallax = scrollY * scrollSpeed;
        const verticalSpan = h + 80;
        const drawY = ((s.y - parallax + 40) % verticalSpan + verticalSpan) % verticalSpan - 40;
        const drawX = s.x + Math.sin(scrollY * 0.002 + s.phase) * 10;

        // Fade out particles near bottom of page (near footer)
        let fadeAlpha = 1;
        if (pageBottom < h) {
          const fromBottom = pageBottom - drawY;
          if (fromBottom < 80) fadeAlpha = Math.max(0, fromBottom / 80);
        }

        // Pulsing alpha
        const alpha = s.baseAlpha * (0.6 + 0.4 * Math.sin(s.phase)) * fadeAlpha;
        if (alpha <= 0) continue;

        drawPizzaSlice(drawX, drawY, s.size, s.rotation, s.color, s.crustColor, alpha);
      }

      raf = requestAnimationFrame(draw);
    }

    resize();
    createSlices();
    draw();

    window.addEventListener('resize', () => { resize(); createSlices(); });

    document.addEventListener('mousemove', (ev) => {
      mouse.x = ev.clientX;
      mouse.y = ev.clientY;
    });

    document.addEventListener('mouseleave', () => {
      mouse.x = -9999;
      mouse.y = -9999;
    });

    window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });

    document.addEventListener('astro:before-preparation', () => {
      cancelAnimationFrame(raf);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initFratelliParticles);

</script>

<style>
  /* Page */
  .fratelli-page {
    position: relative;
    isolation: isolate;
    background: var(--fratelli-bg);
    overflow: clip;
  }

  .fratelli-particles {
    position: fixed;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .fratelli-page__chalk {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      radial-gradient(circle, rgba(245, 239, 213, 0.18) 0 0.55px, transparent 0.9px),
      radial-gradient(circle, rgba(245, 239, 213, 0.11) 0 0.5px, transparent 0.85px),
      repeating-linear-gradient(112deg, transparent 0 10px, rgba(245, 239, 213, 0.016) 10px 11px);
    background-size:
      6px 6px,
      9px 9px,
      100% 17px;
    background-position:
      0 0,
      4px 3px,
      center;
    mix-blend-mode: screen;
    opacity: 0.24;
  }

  .fratelli-hero,
  .fratelli-chapter,
  .fratelli-cta {
    position: relative;
    z-index: 2;
  }

  .signage-fullwidth {
    position: relative;
    z-index: 2;
  }

  /* ── Hero ── */
  .fratelli-hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    background: transparent;
    isolation: isolate;
    overflow: hidden;
  }

  .fratelli-hero__chalk {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse at 16% 28%, rgba(245, 239, 213, 0.1), transparent 30%),
      radial-gradient(ellipse at 82% 68%, rgba(245, 239, 213, 0.07), transparent 34%),
      radial-gradient(circle, rgba(245, 239, 213, 0.2) 0 0.55px, transparent 0.9px),
      radial-gradient(circle, rgba(245, 239, 213, 0.13) 0 0.5px, transparent 0.85px),
      repeating-linear-gradient(112deg, transparent 0 9px, rgba(245, 239, 213, 0.018) 9px 10px);
    background-size:
      100% 100%,
      100% 100%,
      5px 5px,
      8px 8px,
      100% 15px;
    background-position:
      center,
      center,
      0 0,
      3px 2px,
      center;
    mix-blend-mode: screen;
    opacity: 0.42;
  }

  .fratelli-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-top: calc(88px + var(--space-l));
    padding-bottom: var(--space-l);
    text-align: center;
  }

  /* Hero staggered entrance */
  .hero-anim {
    opacity: 0;
    transform: translateY(24px);
    animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-anim--1 { animation-delay: 0.15s; }
  .hero-anim--2 { animation-delay: 0.3s; }
  .hero-anim--3 { animation-delay: 0.45s; }

  @keyframes hero-fade-up {
    to { opacity: 1; transform: translateY(0); }
  }

  .fratelli-hero__brand {
    width: clamp(19rem, min(58vw, 62vh), 39rem);
    margin: 0;
  }

  .fratelli-hero__brand img {
    display: block;
    width: 100%;
    height: auto;
  }

  .fratelli-hero__subtitle {
    max-width: 32ch;
    margin-top: clamp(-1.25rem, -1.6vw, -0.35rem);
    margin-bottom: var(--space-m);
    color: var(--fratelli-text);
    font-size: clamp(1rem, 0.9rem + 0.45vw, 1.25rem);
    font-weight: 550;
    line-height: 1.5;
    text-align: center;
  }

  .fratelli-hero__scroll {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--fratelli-text);
    border: 1px solid rgba(245, 239, 213, 0.35);
    border-radius: 50%;
    font-size: 1.15rem;
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .fratelli-hero__scroll:hover {
    color: var(--fratelli-bg);
    background: var(--fratelli-highlight);
    border-color: var(--fratelli-highlight);
    transform: translateY(3px);
  }

  #identidad {
    scroll-margin-top: 84px;
  }

  /* ── Section headings ── */
  .fratelli-section-label {
    display: block;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--fratelli-text);
    opacity: 0.7;
    margin-bottom: var(--space-xs);
    text-align: center;
  }

  .fratelli-section-title {
    font-size: var(--step-4);
    letter-spacing: -0.03em;
    color: var(--fratelli-text);
    margin-bottom: var(--space-s);
    text-align: center;
  }

  .fratelli-chapter.section {
    padding-top: var(--space-xl);
  }

  /* ── Chapters ── */
  .chapter-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
    text-align: center;
  }

  .chapter-text {
    color: var(--fratelli-text);
    opacity: 0.75;
    line-height: 1.7;
    max-width: 65ch;
    margin-bottom: var(--space-xl);
    text-align: center;
    margin-inline: auto;
  }

  /* ── Media grid ── */
  .media-grid {
    display: grid;
    gap: var(--space-m);
  }

  .media-grid--logos {
    grid-template-columns: repeat(2, 1fr);
  }

  .media-grid--brand {
    grid-template-columns: repeat(4, 1fr);
  }

  /* ── Signage full-width ── */
  .signage-fullwidth {
