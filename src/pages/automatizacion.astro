---
import SectionLayout from '../layouts/SectionLayout.astro';
import { automatizacionVisualisers } from '../data/projects';
import { social } from '../data/site';

const cases = automatizacionVisualisers.map((item) => ({
  name: item.title.replace('Plantilla ', ''),
  video: item.video,
  poster: item.poster,
}));
---

<SectionLayout
  title="Automatización | Guillermo López"
  description="Grafismo que se monta solo y procesos que convierten tareas repetidas en flujos conectados."
  theme="automatizacion"
>
  <div class="automation-page">
    <noscript>
      <style is:inline>
        .gen,
        .flow {
          opacity: 1 !important;
          transform: none !important;
        }

        .pzone {
          display: none !important;
        }
      </style>
    </noscript>
    <div class="auto-bg" aria-hidden="true"></div>

    <!-- El primer encargo se escribe solo y genera las piezas -->
    <section class="auto-hero">
      <div class="container auto-hero__inner">
        <span class="auto-kicker mono">Automatización</span>
        <h1>
          <span>Lo repetitivo,</span>
          <em>automático.</em>
        </h1>
        <p class="auto-hero__sub">Se pide una vez. Se hace solo para siempre.</p>

        <div class="pzone" id="auto-zone-master">
          <div class="pzone__in">
            <div
              class="prompt"
              data-text="Guille, necesito todas las versiones de las cartelas para esta tarde."
            >
              <span class="prompt__text mono"
                ><span class="caret" aria-hidden="true"></span></span
              >
              <span class="prompt__send" aria-hidden="true">↑</span>
            </div>
            <p class="prompt__state mono" aria-hidden="true"></p>
          </div>
        </div>

        <div class="gen-stack">
          {cases.map((item) => (
            <figure class="gen">
              <figcaption class="gen__name">
                <strong>{item.name}</strong>
                <span class="mono">✓ generado</span>
              </figcaption>
              <div class="gen__media">
                <video
                  class="gen__video"
                  preload="none"
                  playsinline
                  muted
                  loop
                  poster={item.poster}
                >
                  <source data-src={item.video} type="video/mp4" />
                </video>
              </div>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- Fratelli: segundo encargo -->
    <section class="auto-block section" id="empresas">
      <div class="container">
        <header class="auto-head">
          <span class="auto-kicker mono">Fratelli Pazzi</span>
          <h2>De un mensaje<br />a una reserva.</h2>
        </header>

        <div class="pzone" id="auto-zone-fratelli">
          <div class="pzone__in">
            <div
              class="prompt"
              data-text="Guille, el WhatsApp de la pizzería no da abasto con las reservas."
            >
              <span class="prompt__text mono"
                ><span class="caret" aria-hidden="true"></span></span
              >
              <span class="prompt__send" aria-hidden="true">↑</span>
            </div>
            <p class="prompt__state mono" aria-hidden="true"></p>
          </div>
        </div>

        <div class="flow" id="automation-flow">
          <div class="phone">
            <div class="phone__bar">
              <span class="phone__avatar" aria-hidden="true">FP</span>
              <strong>Fratelli Pazzi</strong>
            </div>
            <div
              class="phone__messages"
              id="automation-chat-messages"
              aria-label="Conversación de ejemplo con el sistema de reservas"
            ></div>
            <div class="phone__input mono" aria-hidden="true">
              <span>Escribe un mensaje…</span>
              <b>→</b>
            </div>
          </div>

          <ol class="flow__steps" aria-label="Acciones que ejecuta el sistema">
            <span class="flow__rail" aria-hidden="true"><i></i></span>
            <li class="flow__step" data-stage="0">
              <span class="flow__dot" aria-hidden="true"></span>
              Mensaje recibido
            </li>
            <li class="flow__step" data-stage="1">
              <span class="flow__dot" aria-hidden="true"></span>
              Mesa libre
            </li>
            <li class="flow__step" data-stage="2">
              <span class="flow__dot" aria-hidden="true"></span>
              Reserva guardada
            </li>
            <li class="flow__step" data-stage="3">
              <span class="flow__dot" aria-hidden="true"></span>
              Equipo avisado
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- El último prompt lo escribe el visitante -->
    <section class="auto-cta section">
      <div class="container">
        <span class="auto-kicker mono">Menos tareas manuales</span>
        <h2>Este prompt es tuyo.</h2>
        <p>Los dos de arriba ya funcionan solos. Escribe el siguiente.</p>
        <form
          class="prompt prompt--live"
          id="auto-cta-form"
          data-email={social.email}
        >
          <input
            type="text"
            id="auto-cta-input"
            name="proceso"
            placeholder="Guille, necesito…"
            autocomplete="off"
            aria-label="Cuéntame qué quieres automatizar"
          />
          <button class="prompt__send" type="submit" aria-label="Enviar">↑</button>
        </form>
        <p class="auto-cta__hint mono">se abre tu correo con el proceso ya escrito</p>
      </div>
    </section>
  </div>
</SectionLayout>

<script is:inline>
  (() => {
    const SCRIPT = [
      { from: 'user', text: 'Hola, ¿podemos reservar este viernes?', stage: 0 },
      { from: 'bot', text: 'Claro. ¿Para cuántas personas y a qué hora?', stage: 0 },
      { from: 'user', text: 'Para 4, sobre las 21:30.', stage: 1 },
      { from: 'bot', text: 'Hay mesa disponible. ¿A qué nombre la dejo?', stage: 1 },
      { from: 'user', text: 'A nombre de Guillermo.', stage: 2 },
      { from: 'bot', text: 'Perfecto. Reserva confirmada para 4 a las 21:30.', stage: 3 },
    ];

    const reduced = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let timers = [];
    let chatTimer = 0;
    let detachScroll;

    const later = (fn, ms) => {
      timers.push(window.setTimeout(fn, ms));
    };

    function loadVideo(video) {
      const source = video.querySelector('source[data-src]');
      if (source?.dataset.src && !source.getAttribute('src')) {
        source.setAttribute('src', source.dataset.src);
        video.load();
      }
    }

    /* ── Conversación sincronizada con las cuatro acciones ── */
    function setStage(stage) {
      document.querySelectorAll('.flow__step').forEach((step) => {
        const value = Number(step.dataset.stage);
        step.classList.toggle('is-done', value < stage);
        step.classList.toggle('is-active', value === stage);
      });
      const rail = document.querySelector('.flow__rail i');
      if (rail) {
        rail.style.setProperty(
          '--flow-progress',
          `${(Math.max(0, stage) / 3) * 100}%`,
        );
      }
    }

    function addMessage(box, message) {
      const element = document.createElement('div');
      element.className = `bubble bubble--${message.from}`;
      element.textContent = message.text;
      box.appendChild(element);
      box.scrollTop = box.scrollHeight;
    }

    function runChat(box) {
      window.clearTimeout(chatTimer);
      box.replaceChildren();
      setStage(-1);
      let index = 0;

      const step = () => {
        if (!box.isConnected) return;
        if (index >= SCRIPT.length) {
          chatTimer = window.setTimeout(() => runChat(box), 4600);
          return;
        }

        const message = SCRIPT[index++];
        setStage(message.stage);

        if (message.from === 'bot') {
          const typing = document.createElement('div');
          typing.className = 'bubble bubble--bot bubble--typing';
          typing.innerHTML = '<i></i><i></i><i></i>';
          box.appendChild(typing);
          box.scrollTop = box.scrollHeight;
          chatTimer = window.setTimeout(() => {
            typing.remove();
            addMessage(box, message);
            chatTimer = window.setTimeout(step, 1250);
          }, 850);
          return;
        }

        addMessage(box, message);
        chatTimer = window.setTimeout(step, 1050);
      };

      step();
    }

    /* ── El prompt se escribe solo, se envía y el resultado nace ── */
    function typePrompt(prompt, done) {
      const textEl = prompt.querySelector('.prompt__text');
      const full = prompt.dataset.text || '';
      prompt.classList.add('is-typing');
      textEl.innerHTML = '<span class="caret" aria-hidden="true"></span>';
      const caret = textEl.querySelector('.caret');
      let i = 0;
      const tick = () => {
        if (!textEl.isConnected) return;
        caret.insertAdjacentText('beforebegin', full[i]);
        i += 1;
        if (i < full.length) later(tick, 24 + Math.random() * 40);
        else later(done, 350);
      };
      later(tick, 500);
    }

    function sendPrompt(prompt, zone, reveal) {
      prompt.classList.remove('is-typing');
      prompt.classList.add('is-sent');
      const state = zone.querySelector('.prompt__state');
      if (state) {
        state.textContent = '⏺ generando…';
        state.classList.add('is-gen');
      }
      later(() => zone.classList.add('is-out'), 950);
      later(reveal, 1300);
    }

    function revealGens() {
      document.querySelectorAll('.gen').forEach((gen, i) => {
        later(() => {
          gen.classList.add('is-in');
          const video = gen.querySelector('video');
          if (video) {
            loadVideo(video);
            if (!reduced()) video.play().catch(() => {});
          }
        }, i * 520);
      });
    }

    function revealFlow() {
      document.getElementById('automation-flow')?.classList.add('is-in');
      const box = document.getElementById('automation-chat-messages');
      if (box && box.dataset.ready !== '1') {
        box.dataset.ready = '1';
        runChat(box);
      }
    }

    /* ── Vídeos: pausa fuera del viewport ── */
    function initVideoPause() {
      const videos = document.querySelectorAll('.gen__video');
      if (!videos.length) return;
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target;
            if (!video.closest('.gen')?.classList.contains('is-in')) return;
            if (entry.isIntersecting) {
              if (!reduced()) video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        },
        { rootMargin: '150px 0px', threshold: 0.1 },
      );
      videos.forEach((video) => {
        if (video.dataset.pauseReady === '1') return;
        video.dataset.pauseReady = '1';
        observer.observe(video);
      });
    }

    function initCta() {
      const form = document.getElementById('auto-cta-form');
      if (!form || form.dataset.ready === '1') return;
      form.dataset.ready = '1';
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const text = (document.getElementById('auto-cta-input')?.value || '').trim();
        const subject = text
          ? `Quiero automatizar: ${text}`
          : 'Quiero automatizar un proceso';
        window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}`;
      });
    }

    function initAll() {
      const page = document.querySelector('.automation-page');
      if (!page || page.dataset.ready === '1') return;
      page.dataset.ready = '1';

      initCta();
      initVideoPause();

      const zones = [
        { zone: document.getElementById('auto-zone-master'), reveal: revealGens },
        { zone: document.getElementById('auto-zone-fratelli'), reveal: revealFlow },
      ].filter((entry) => entry.zone);

      if (reduced()) {
        zones.forEach(({ zone }) => {
          const prompt = zone.querySelector('.prompt');
          prompt.querySelector('.prompt__text').textContent =
            prompt.dataset.text || '';
          prompt.classList.add('is-sent');
        });
        document.querySelectorAll('.gen').forEach((gen) => {
          gen.classList.add('is-in');
          const video = gen.querySelector('video');
          if (video) loadVideo(video);
        });
        document.getElementById('automation-flow')?.classList.add('is-in');
        const box = document.getElementById('automation-chat-messages');
        if (box && box.dataset.ready !== '1') {
          box.dataset.ready = '1';
          SCRIPT.forEach((message) => addMessage(box, message));
          setStage(3);
        }
        return;
      }

      // Disparo por posición en vez de IntersectionObserver: un scroll rápido
      // o una ancla pueden saltarse el elemento entre frame y frame.
      const pending = new Set(zones);
      let ticking = false;

      const check = () => {
        const limit = window.innerHeight * 0.8;
        pending.forEach((entry) => {
          if (entry.zone.getBoundingClientRect().top < limit) {
            pending.delete(entry);
            typePrompt(entry.zone.querySelector('.prompt'), () =>
              sendPrompt(entry.zone.querySelector('.prompt'), entry.zone, entry.reveal),
            );
          }
        });
        if (!pending.size) detachScroll?.();
      };

      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          ticking = false;
          check();
        });
      };

      detachScroll?.();
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      detachScroll = () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      };

      check();
      later(check, 400);
      later(check, 1200);
    }

    initAll();
    document.addEventListener('astro:page-load', initAll);
    document.addEventListener('astro:before-swap', () => {
      timers.forEach((timer) => window.clearTimeout(timer));
      timers = [];
      window.clearTimeout(chatTimer);
      detachScroll?.();
      detachScroll = undefined;
    });
  })();
</script>

<style>
  .automation-page {
    --accent: var(--auto-accent);
    --muted: var(--auto-text-secondary);
    --line: var(--auto-border);
    --overshoot: cubic-bezier(0.22, 1.3, 0.36, 1);
    overflow-x: clip;
  }

  .auto-kicker {
    display: inline-block;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: var(--step--2);
  }

  /* ═══════════ FONDO: retícula + brillos que respiran ═══════════ */

  .auto-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--auto-text) 7%, transparent) 1px,
      transparent 1px
    );
    background-size: 26px 26px;
    mask-image: radial-gradient(130% 100% at 50% 40%, #000 40%, transparent 100%);
  }

  .auto-bg::before,
  .auto-bg::after {
    content: '';
    position: absolute;
    width: 55vmax;
    height: 55vmax;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 13%, transparent),
      transparent 65%
    );
    animation:
      auto-drift 20s ease-in-out infinite alternate,
      auto-pulse 4.5s ease-in-out infinite alternate;
  }

  .auto-bg::before {
    top: -18vmax;
    left: -12vmax;
  }

  .auto-bg::after {
    right: -16vmax;
    bottom: -20vmax;
    animation-duration: 29s, 6.5s;
    animation-direction: alternate-reverse, alternate;
    animation-delay: 0s, 1.6s;
  }

  @keyframes auto-drift {
    to {
      transform: translate(9vmax, 7vmax) scale(1.18);
    }
  }

  @keyframes auto-pulse {
    from {
      opacity: 0.4;
    }

    to {
      opacity: 1;
    }
  }

  /* ═══════════ BARRA DE PROMPT ═══════════ */

  .prompt {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: min(100%, 720px);
    margin-inline: auto;
    padding: var(--space-s) var(--space-s) var(--space-s) var(--space-m);
    border: 1px solid var(--line);
    border-radius: 18px;
    background: var(--auto-surface);
    text-align: left;
    transition:
      border-color var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }

  .prompt.is-typing,
  .prompt--live {
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .prompt.is-sent {
    border-color: var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent);
  }

  .prompt__text {
    flex: 1;
    min-height: 1.5em;
    font-size: clamp(0.95rem, 2.2vw, 1.12rem);
    word-break: break-word;
  }

  .prompt__text :global(.caret) {
    display: inline-block;
    width: 0.55em;
    height: 1.15em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: caret-blink 1s steps(1) infinite;
  }

  @keyframes caret-blink {
    50% {
      opacity: 0;
    }
  }

  .prompt__send {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.07);
    color: var(--muted);
    font-size: 1.1rem;
    transition:
      background var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .prompt.is-typing .prompt__send {
    color: var(--auto-text);
  }

  .prompt.is-sent .prompt__send,
  .prompt--live .prompt__send {
    background: var(--accent);
    color: var(--auto-bg);
  }

  .prompt.is-sent .prompt__send {
    transform: scale(0.88);
  }

  .prompt__state {
    margin-top: var(--space-xs);
    min-height: 1.2em;
    text-align: center;
    color: var(--muted);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .prompt__state.is-gen {
    color: #e3b341;
  }

  /* La zona del prompt se funde y colapsa cuando el encargo está enviado */
  .pzone {
    display: grid;
    grid-template-rows: 1fr;
    width: 100%;
    transition:
      opacity 550ms var(--ease-out),
      transform 550ms var(--ease-out),
      grid-template-rows 650ms var(--ease-out) 120ms;
  }

  .pzone__in {
    min-height: 0;
    overflow: hidden;
    padding-bottom: 4px;
  }

  .pzone.is-out {
    opacity: 0;
    transform: translateY(-16px);
    grid-template-rows: 0fr;
    pointer-events: none;
  }

  /* ═══════════ HERO ═══════════ */

  .auto-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    padding-block: var(--space-2xl);
  }

  .auto-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .auto-hero h1 {
    display: grid;
    justify-items: center;
    margin-block: var(--space-xs) var(--space-s);
    /* --step-5 no baja de 4.21rem y parte el titular en móvil */
    font-size: clamp(2.6rem, 10.5vw, 5.26rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .auto-hero h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .auto-hero__sub {
    max-width: 34ch;
    margin-bottom: var(--space-xl);
    color: var(--muted);
    font-size: var(--step-0);
  }

  /* ═══════════ RESULTADOS ═══════════ */

  .gen-stack {
    display: grid;
    gap: var(--space-2xl);
    width: 100%;
    padding-top: var(--space-2xs);
  }

  /* Ocultos por defecto y revelados por JS. Si fuera al revés (visibles y
     ocultados al arrancar el JS), al entrar por transición de Astro se
     pintarían unos frames antes de que el script corra. El <noscript> de
     arriba los muestra cuando no hay JS. */
  .gen {
    width: 100%;
    max-width: 900px;
    margin-inline: auto;
    text-align: left;
    opacity: 0;
    transform: translateY(90px) scale(0.94);
    transition:
      opacity 700ms ease,
      transform 950ms var(--overshoot);
  }

  .gen.is-in {
    opacity: 1;
    transform: none;
  }

  .gen__name {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-s);
    margin-bottom: var(--space-xs);
  }

  .gen__name strong {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .gen__name span {
    color: var(--accent);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .gen__media {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--auto-surface);
  }

  .gen__video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* ═══════════ CABECERAS ═══════════ */

  .auto-head {
    margin-bottom: var(--space-xl);
    text-align: center;
  }

  .auto-head h2 {
    margin-top: var(--space-2xs);
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  /* ═══════════ FLUJO DE NEGOCIO ═══════════ */

  .flow {
    display: grid;
    gap: var(--space-xl);
    width: min(100%, 900px);
    margin-inline: auto;
    margin-top: var(--space-l);
    opacity: 0;
    transform: translateY(70px) scale(0.97);
    transition:
      opacity 700ms ease,
      transform 950ms var(--overshoot);
  }

  .flow.is-in {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 900px) {
    .flow {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
      align-items: center;
    }
  }

  .phone {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--auto-surface);
  }

  .phone__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-s);
    border-bottom: 1px solid var(--line);
  }

  .phone__avatar {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--auto-bg);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .phone__messages {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-height: 19rem;
    max-height: 19rem;
    padding: var(--space-s);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* Las burbujas las crea el JS, así que no llevan el atributo de scope de
     Astro. Se estilan con :global() colgando del contenedor, que sí lo lleva. */
  .phone__messages :global(.bubble) {
    max-width: 82%;
    padding: 0.6em 0.9em;
