---
import SectionLayout from '../layouts/SectionLayout.astro';
import ProjectCTA from '../components/global/ProjectCTA.astro';
import { automatizacionVisualisers } from '../data/projects';

const caseNotes = [
  'Texto, color y timing cambian desde un único control.',
  'El dato entra y el recurso de apoyo queda listo para directo.',
  'Variables y colores construyen cada gráfico sin rehacer la pieza.',
];

const automationCases = automatizacionVisualisers.map((item, index) => ({
  ...item,
  note: caseNotes[index],
}));
---

<SectionLayout
  title="Automatización | Guillermo López"
  description="Grafismo que se monta solo y sistemas que convierten tareas repetidas en flujos claros, conectados y medibles."
  theme="automatizacion"
>
  <div class="automation-page">
    <section class="auto-hero">
      <div class="container auto-hero__content">
        <div class="auto-hero__copy">
          <span class="auto-kicker mono">Automatización</span>
          <h1>
            <span>Lo repetitivo,</span>
            <em>automático.</em>
          </h1>
          <p>Grafismo que se monta solo. Sistemas que gestionan trabajo real.</p>
        </div>

        <div class="auto-hero__systems" aria-label="Dos formas de automatizar">
          <a class="system-window system-window--broadcast" href="#after-effects">
            <header>
              <span class="system-window__signal" aria-hidden="true"></span>
              <strong>After Effects</strong>
              <small class="mono">plantilla activa</small>
            </header>
            <div class="broadcast-preview" aria-hidden="true">
              <div class="broadcast-preview__controls">
                <span>TITULAR</span>
                <strong>ÚLTIMA HORA</strong>
                <span>COLOR</span>
                <i></i>
              </div>
              <div class="broadcast-preview__output">
                <span class="mono">OUTPUT</span>
                <strong>ÚLTIMA<br />HORA</strong>
                <small>render listo</small>
              </div>
              <div class="broadcast-preview__timeline">
                <span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
            <footer>
              <span>Una plantilla</span>
              <strong>todas las versiones →</strong>
            </footer>
          </a>

          <a class="system-window system-window--business" href="#empresas">
            <header>
              <span class="system-window__signal" aria-hidden="true"></span>
              <strong>Negocio</strong>
              <small class="mono">flujo conectado</small>
            </header>
            <div class="route-preview" aria-hidden="true">
              <div class="route-preview__line"></div>
              <div class="route-preview__step">
                <span></span>
                <small>WhatsApp</small>
                <strong>Mensaje</strong>
              </div>
              <div class="route-preview__step">
                <span></span>
                <small>Reglas</small>
                <strong>Decisión</strong>
              </div>
              <div class="route-preview__step">
                <span></span>
                <small>Agenda</small>
                <strong>Reserva</strong>
              </div>
              <div class="route-preview__step">
                <span></span>
                <small>Equipo</small>
                <strong>Aviso</strong>
              </div>
            </div>
            <footer>
              <span>Un mensaje</span>
              <strong>todo el flujo →</strong>
            </footer>
          </a>
        </div>
      </div>
    </section>

    <section class="automation-cases section" id="after-effects">
      <div class="container">
        <header class="section-intro">
          <span class="auto-kicker mono">After Effects</span>
          <h2>Un máster.<br />Todas las versiones.</h2>
          <p>Controles simples por delante. Expresiones, lógica y composición por detrás.</p>
        </header>

        <div class="case-reel">
          {automationCases.map((item) => (
            <article class="automation-case">
              <div class="automation-case__media">
                <video
                  class="automation-case__video"
                  preload="none"
                  playsinline
                  muted
                  loop
                  poster={item.poster}
                >
                  <source data-src={item.video} type="video/mp4" />
                </video>
                <span class="automation-case__status mono">
                  <i aria-hidden="true"></i>
                  Sistema activo
                </span>
              </div>
              <div class="automation-case__caption">
                <h3>{item.title.replace('Plantilla ', '')}</h3>
                <p>{item.note}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="translation-band" aria-label="Del dato al resultado">
      <div class="container translation-band__inner">
        <div>
          <span class="mono">ENTRADA</span>
          <strong>Texto · datos · variables</strong>
        </div>
        <div class="translation-band__connection" aria-hidden="true">
          <i></i>
          <span></span>
        </div>
        <div>
          <span class="mono">SALIDA</span>
          <strong>Grafismo listo para emitir</strong>
        </div>
      </div>
    </section>

    <section class="business section" id="empresas">
      <div class="container">
        <header class="section-intro section-intro--business">
          <span class="auto-kicker mono">Un caso real</span>
          <h2>De un mensaje<br />a una reserva.</h2>
          <p>El cliente solo ve una conversación. El sistema se ocupa del resto.</p>
        </header>

        <div class="business-story">
          <div class="chat-demo">
            <div class="chat-demo__bar">
              <div>
                <span class="chat-demo__avatar" aria-hidden="true">FP</span>
                <div>
                  <strong>Fratelli Pazzi</strong>
                  <small>Disponible por WhatsApp</small>
                </div>
              </div>
              <span class="chat-demo__live mono">EN LÍNEA</span>
            </div>
            <div
              class="chat-demo__messages"
              id="automation-chat-messages"
              aria-label="Conversación de ejemplo con el asistente de reservas de Fratelli Pazzi"
            ></div>
            <div class="chat-demo__input mono" aria-hidden="true">
              <span>Escribe un mensaje…</span>
              <b>→</b>
            </div>
          </div>

          <div class="journey" aria-label="Acciones ejecutadas por la automatización">
            <div class="journey__head">
              <span class="auto-kicker mono">Lo que ocurre detrás</span>
              <strong>Una conversación.<br />Cuatro acciones conectadas.</strong>
            </div>

            <div class="journey__flow">
              <div class="journey__rail" aria-hidden="true"><i></i></div>
              <div class="journey__item" data-stage="0">
                <span class="journey__dot" aria-hidden="true"></span>
                <div>
                  <strong>Mensaje recibido</strong>
                  <small>La petición entra por WhatsApp.</small>
                </div>
                <b class="mono">RECIBIDO</b>
              </div>
              <div class="journey__item" data-stage="1">
                <span class="journey__dot" aria-hidden="true"></span>
                <div>
                  <strong>Disponibilidad comprobada</strong>
                  <small>El sistema consulta fecha, hora y personas.</small>
                </div>
                <b class="mono">LIBRE</b>
              </div>
              <div class="journey__item" data-stage="2">
                <span class="journey__dot" aria-hidden="true"></span>
                <div>
                  <strong>Reserva guardada</strong>
                  <small>Los datos quedan registrados en la agenda.</small>
                </div>
                <b class="mono">GUARDADA</b>
              </div>
              <div class="journey__item" data-stage="3">
                <span class="journey__dot" aria-hidden="true"></span>
                <div>
                  <strong>Equipo avisado</strong>
                  <small>Sala recibe la información sin copiar nada.</small>
                </div>
                <b class="mono">ENVIADO</b>
              </div>
            </div>

            <div class="journey__result">
              <span class="mono">RESULTADO</span>
              <strong>Reserva confirmada</strong>
              <small>sin cambiar de herramienta</small>
            </div>
          </div>
        </div>
      </div>
    </section>

    <ProjectCTA
      eyebrow="Menos tareas manuales"
      title="¿Qué repites cada semana?"
      text="Cuéntamelo y vemos si puede ocurrir solo."
      subject="Quiero automatizar un proceso"
      label="Contarme el proceso"
    />
  </div>
</SectionLayout>

<script is:inline>
  (() => {
    const SCRIPT = [
      { from: 'user', text: 'Hola, ¿podemos reservar este viernes?', stage: 0 },
      { from: 'bot', text: 'Claro. ¿Para cuántas personas y a qué hora?', stage: 0 },
      { from: 'user', text: 'Para 4, sobre las 21:30.', stage: 1 },
      { from: 'bot', text: 'Hay mesa disponible. ¿A qué nombre la dejo?', stage: 1 },
      { from: 'user', text: 'A nombre de Guillermo.', stage: 2 },
      { from: 'bot', text: 'Perfecto. Reserva confirmada para 4 a las 21:30.', stage: 3 },
    ];

    let chatTimer = 0;
    let chatObserver;

    function setJourneyStage(stage) {
      document.querySelectorAll('.journey__item').forEach((item) => {
        const itemStage = Number(item.dataset.stage);
        item.classList.toggle('is-complete', itemStage < stage);
        item.classList.toggle('is-active', itemStage === stage);
      });
      const rail = document.querySelector('.journey__rail i');
      if (rail) rail.style.setProperty('--journey-progress', `${Math.max(0, stage) / 3 * 100}%`);
    }

    function addChatMessage(box, message) {
      const element = document.createElement('div');
      element.className = `chat-message chat-message--${message.from}`;
      element.textContent = message.text;
      box.appendChild(element);
      box.scrollTop = box.scrollHeight;
    }

    function runChat(box) {
      window.clearTimeout(chatTimer);
      box.replaceChildren();
      setJourneyStage(-1);
      let index = 0;

      const step = () => {
        if (!box.isConnected) return;
        if (index >= SCRIPT.length) {
          chatTimer = window.setTimeout(() => runChat(box), 4200);
          return;
        }

        const message = SCRIPT[index++];
        setJourneyStage(message.stage);

        if (message.from === 'bot') {
          const typing = document.createElement('div');
          typing.className = 'chat-message chat-message--bot chat-message--typing';
          typing.innerHTML = '<i></i><i></i><i></i>';
          box.appendChild(typing);
          box.scrollTop = box.scrollHeight;
          chatTimer = window.setTimeout(() => {
            typing.remove();
            addChatMessage(box, message);
            chatTimer = window.setTimeout(step, 1250);
          }, 850);
          return;
        }

        addChatMessage(box, message);
        chatTimer = window.setTimeout(step, 1050);
      };

      step();
    }

    function initAutomationChat() {
      const box = document.getElementById('automation-chat-messages');
      if (!box || box.dataset.ready === '1') return;
      box.dataset.ready = '1';

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        SCRIPT.forEach((message) => addChatMessage(box, message));
        setJourneyStage(3);
        return;
      }

      chatObserver?.disconnect();
      chatObserver = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        chatObserver.disconnect();
        runChat(box);
      }, { threshold: 0.28 });
      chatObserver.observe(box);
    }

    function initAutomationVideos() {
      const videos = document.querySelectorAll('.automation-case__video');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (entry.isIntersecting) {
            const source = video.querySelector('source[data-src]');
            if (source?.dataset.src && !source.getAttribute('src')) {
              source.setAttribute('src', source.dataset.src);
              video.load();
            }
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      }, { rootMargin: '180px 0px', threshold: 0.08 });
      videos.forEach((video) => {
        if (video.dataset.automationReady === '1') return;
        video.dataset.automationReady = '1';
        observer.observe(video);
      });
    }

    initAutomationChat();
    initAutomationVideos();
    document.addEventListener('astro:page-load', () => {
      initAutomationChat();
      initAutomationVideos();
    });
  })();
</script>

<style>
  .automation-page {
    --auto-accent: #39d353;
    --auto-soft: rgba(57, 211, 83, 0.12);
    position: relative;
    overflow: clip;
    background:
      radial-gradient(circle at 10% 12%, rgba(57, 211, 83, 0.07), transparent 28rem),
      radial-gradient(circle at 88% 58%, rgba(57, 211, 83, 0.05), transparent 30rem),
      #090d11;
  }

  .automation-page::before {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    content: '';
    opacity: 0.24;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(to bottom, #000, transparent 88%);
  }

  .automation-page > * {
    position: relative;
    z-index: 1;
  }

  .auto-kicker {
    display: block;
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
    color: var(--auto-accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .auto-hero {
    display: grid;
    min-height: min(920px, 94svh);
    padding: clamp(8.5rem, 13vw, 11.5rem) 0 clamp(4.5rem, 8vw, 7rem);
  }

  .auto-hero__content {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(500px, 1.18fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .auto-hero h1 {
    margin: 0;
    color: #f4f7f5;
    font-size: clamp(4.6rem, 8.7vw, 9.6rem);
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.075em;
  }

  .auto-hero h1 span,
  .auto-hero h1 em {
    display: block;
  }

  .auto-hero h1 em {
    color: var(--auto-accent);
    font-style: normal;
  }

  .auto-hero__copy > p {
    max-width: 33rem;
    margin-top: 2rem;
    color: rgba(244, 247, 245, 0.58);
    font-size: clamp(1rem, 1.5vw, 1.25rem);
    line-height: 1.65;
  }

  .auto-hero__systems {
    display: grid;
    gap: 1rem;
  }

  .system-window {
    position: relative;
    display: block;
    min-width: 0;
    overflow: hidden;
    color: #edf5ef;
    background:
      linear-gradient(145deg, rgba(57, 211, 83, 0.08), transparent 52%),
      rgba(13, 19, 23, 0.94);
    border: 1px solid rgba(114, 255, 136, 0.15);
    border-radius: 1.1rem;
    text-decoration: none;
    transition:
      transform 280ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 280ms ease,
      box-shadow 280ms ease;
  }

  .system-window:hover {
    border-color: rgba(114, 255, 136, 0.42);
    box-shadow: 0 22px 65px rgba(0, 0, 0, 0.28);
    transform: translateY(-4px);
  }

  .system-window header,
  .system-window footer {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1rem;
  }

  .system-window header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .system-window footer {
    justify-content: space-between;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.48);
    font-size: 0.76rem;
  }

  .system-window footer strong {
    color: #d9f8df;
    font-weight: 600;
  }

  .system-window header strong {
    font-size: 0.82rem;
  }

  .system-window header small {
    margin-left: auto;
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .system-window__signal {
    width: 0.48rem;
    height: 0.48rem;
    background: var(--auto-accent);
    border-radius: 50%;
    box-shadow: 0 0 0.75rem rgba(57, 211, 83, 0.75);
    animation: auto-signal 1.8s ease-in-out infinite;
  }

  .broadcast-preview {
    position: relative;
    display: grid;
    grid-template-columns: 0.74fr 1.26fr;
    gap: 0.8rem;
    min-height: 11.25rem;
    padding: 1rem 1rem 2.4rem;
  }

  .broadcast-preview__controls,
  .broadcast-preview__output {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.26);
    border-radius: 0.7rem;
  }

  .broadcast-preview__controls {
    gap: 0.45rem;
    color: rgba(255, 255, 255, 0.42);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.54rem;
    letter-spacing: 0.08em;
  }

  .broadcast-preview__controls strong {
    overflow: hidden;
    color: #fff;
    font-family: inherit;
    font-size: 0.67rem;
    text-overflow: ellipsis;
  }

  .broadcast-preview__controls i {
    width: 1.3rem;
    height: 1.3rem;
    background: var(--auto-accent);
    border-radius: 0.22rem;
  }

  .broadcast-preview__output {
    position: relative;
    overflow: hidden;
    background:
      linear-gradient(120deg, rgba(57, 211, 83, 0.18), transparent 62%),
      #11191d;
  }

  .broadcast-preview__output::after {
    position: absolute;
    inset: auto -12% -40% 34%;
    height: 100%;
    content: '';
    background: var(--auto-accent);
    opacity: 0.12;
    transform: skewX(-18deg);
  }

  .broadcast-preview__output span,
  .broadcast-preview__output small {
    position: relative;
    z-index: 1;
    color: rgba(255, 255, 255, 0.42);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
  }

  .broadcast-preview__output strong {
    position: relative;
    z-index: 1;
    margin: 0.3rem 0;
    color: #f2fff5;
    font-size: clamp(1rem, 2vw, 1.7rem);
    line-height: 0.86;
    letter-spacing: -0.05em;
  }

  .broadcast-preview__timeline {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    left: 1rem;
    display: grid;
    grid-template-columns: 1.2fr 0.5fr 1.8fr 0.8fr 1.1fr;
    gap: 0.2rem;
    height: 0.42rem;
  }

  .broadcast-preview__timeline span {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 999px;
  }

  .broadcast-preview__timeline span:nth-child(3) {
    background: var(--auto-accent);
    box-shadow: 0 0 0.9rem rgba(57, 211, 83, 0.42);
  }

  .route-preview {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    min-height: 10rem;
    padding: 1.25rem 1.2rem;
  }

  .route-preview__line {
    position: absolute;
    top: calc(50% - 0.95rem);
    right: 13%;
    left: 13%;
    height: 1px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.12);
  }

  .route-preview__line::after {
    position: absolute;
    inset: 0;
    content: '';
    background: linear-gradient(90deg, transparent, var(--auto-accent), transparent);
    transform: translateX(-100%);
    animation: route-flow 3s ease-in-out infinite;
  }

  .route-preview__step {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    min-width: 0;
    text-align: center;
  }

  .route-preview__step > span {
    width: 0.72rem;
    height: 0.72rem;
    margin-bottom: 0.45rem;
    background: #10171b;
    border: 2px solid var(--auto-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 0.35rem rgba(57, 211, 83, 0.08);
  }

  .route-preview__step small {
    overflow: hidden;
    max-width: 100%;
    color: rgba(255, 255, 255, 0.38);
    font-size: 0.54rem;
    text-overflow: ellipsis;
  }

  .route-preview__step strong {
    font-size: clamp(0.6rem, 1vw, 0.76rem);
  }

  .section-intro {
    max-width: 62rem;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
  }

  .section-intro h2 {
    max-width: 14ch;
    margin: 0;
    color: #f1f5f2;
    font-size: clamp(3.2rem, 7.3vw, 7.6rem);
    line-height: 0.88;
    letter-spacing: -0.065em;
  }

  .section-intro > p {
    max-width: 38rem;
    margin-top: 1.6rem;
    color: rgba(239, 245, 241, 0.56);
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.65;
  }

  .automation-cases {
    padding-top: clamp(5rem, 10vw, 10rem);
  }

  .case-reel {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .automation-case {
    grid-column: span 6;
    min-width: 0;
  }

  .automation-case:last-child {
    grid-column: 3 / span 8;
    margin-top: clamp(1rem, 3vw, 2.5rem);
  }

  .automation-case__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #11171a;
    border-radius: clamp(0.85rem, 1.5vw, 1.35rem);
  }

  .automation-case__media::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: '';
    background: linear-gradient(to top, rgba(4, 8, 10, 0.45), transparent 40%);
  }

  .automation-case__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .automation-case:hover .automation-case__video {
    transform: scale(1.025);
  }

  .automation-case__status {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.55rem;
    color: rgba(255, 255, 255, 0.72);
    background: rgba(6, 10, 12, 0.72);
    border-radius: 999px;
    backdrop-filter: blur(10px);
    font-size: 0.55rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .automation-case__status i {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--auto-accent);
    border-radius: 50%;
    box-shadow: 0 0 0.55rem var(--auto-accent);
  }

  .automation-case__caption {
    display: grid;
    grid-template-columns: minmax(0, 0.55fr) minmax(12rem, 0.45fr);
    gap: 1.5rem;
    align-items: start;
    padding: 1.25rem 0.25rem 0;
  }

  .automation-case__caption h3 {
    margin: 0;
    color: #f3f7f4;
    font-size: clamp(1.65rem, 2.8vw, 2.8rem);
