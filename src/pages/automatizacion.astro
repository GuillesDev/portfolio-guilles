---
import SectionLayout from '../layouts/SectionLayout.astro';
import ProjectCTA from '../components/global/ProjectCTA.astro';
import { automatizacionVisualisers } from '../data/projects';

const cases = automatizacionVisualisers.map((item) => ({
  name: item.title.replace('Plantilla ', ''),
  video: item.video,
  poster: item.poster,
  holo: item.video.replace('.mp4', '-holo.mp4'),
}));
---

<SectionLayout
  title="Automatización | Guillermo López"
  description="Grafismo que se monta solo y procesos que convierten tareas repetidas en flujos conectados."
  theme="automatizacion"
>
  <div class="automation-page">
    <section class="auto-hero">
      <div class="auto-hero__stage" aria-hidden="true">
        {cases.map((item, index) => (
          <video
            class="auto-hero__clip"
            data-hero-clip={index}
            preload="none"
            playsinline
            muted
            loop
            poster={item.poster}
          >
            <source data-src={item.holo} type="video/mp4" />
          </video>
        ))}
        <span class="auto-hero__scrim"></span>
      </div>

      <div class="container auto-hero__inner">
        <span class="auto-kicker mono">Automatización</span>
        <h1>
          <span>Lo repetitivo,</span>
          <em>automático.</em>
        </h1>
        <p>Grafismo que se monta solo. Sistemas que gestionan trabajo real.</p>
        <nav class="auto-hero__jump" aria-label="Ir a un bloque">
          <a href="#after-effects">After Effects</a>
          <a href="#empresas">Negocio</a>
        </nav>
      </div>
    </section>

    <section class="auto-block section" id="after-effects">
      <div class="container">
        <header class="auto-head">
          <span class="auto-kicker mono">After Effects</span>
          <h2>Un máster.<br />Todas las versiones.</h2>
        </header>
      </div>

      <div class="case-stack">
        {cases.map((item) => (
          <figure class="case">
            <div class="case__media">
              <video
                class="case__video"
                preload="none"
                playsinline
                muted
                loop
                poster={item.poster}
              >
                <source data-src={item.video} type="video/mp4" />
              </video>
            </div>
            <figcaption class="case__name">{item.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="auto-block section" id="empresas">
      <div class="container">
        <header class="auto-head">
          <span class="auto-kicker mono">Fratelli Pazzi</span>
          <h2>De un mensaje<br />a una reserva.</h2>
        </header>

        <div class="flow">
          <div class="phone">
            <div class="phone__bar">
              <span class="phone__avatar" aria-hidden="true">FP</span>
              <strong>Fratelli Pazzi</strong>
            </div>
            <div
              class="phone__messages"
              id="automation-chat-messages"
              aria-label="Conversación de ejemplo con el sistema de reservas"
            ></div>
            <div class="phone__input mono" aria-hidden="true">
              <span>Escribe un mensaje…</span>
              <b>→</b>
            </div>
          </div>

          <ol class="flow__steps" aria-label="Acciones que ejecuta el sistema">
            <span class="flow__rail" aria-hidden="true"><i></i></span>
            <li class="flow__step" data-stage="0">
              <span class="flow__dot" aria-hidden="true"></span>
              Mensaje recibido
            </li>
            <li class="flow__step" data-stage="1">
              <span class="flow__dot" aria-hidden="true"></span>
              Mesa libre
            </li>
            <li class="flow__step" data-stage="2">
              <span class="flow__dot" aria-hidden="true"></span>
              Reserva guardada
            </li>
            <li class="flow__step" data-stage="3">
              <span class="flow__dot" aria-hidden="true"></span>
              Equipo avisado
            </li>
          </ol>
        </div>
      </div>
    </section>

    <ProjectCTA
      eyebrow="Menos tareas manuales"
      title="¿Qué repites cada semana?"
      text="Cuéntamelo y vemos si puede ocurrir solo."
      subject="Quiero automatizar un proceso"
      label="Contarme el proceso"
    />
  </div>
</SectionLayout>

<script is:inline>
  (() => {
    const SCRIPT = [
      { from: 'user', text: 'Hola, ¿podemos reservar este viernes?', stage: 0 },
      { from: 'bot', text: 'Claro. ¿Para cuántas personas y a qué hora?', stage: 0 },
      { from: 'user', text: 'Para 4, sobre las 21:30.', stage: 1 },
      { from: 'bot', text: 'Hay mesa disponible. ¿A qué nombre la dejo?', stage: 1 },
      { from: 'user', text: 'A nombre de Guillermo.', stage: 2 },
      { from: 'bot', text: 'Perfecto. Reserva confirmada para 4 a las 21:30.', stage: 3 },
    ];

    const reduced = () =>
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let chatTimer = 0;
    let chatObserver;
    let heroTimer = 0;

    function loadVideo(video) {
      const source = video.querySelector('source[data-src]');
      if (source?.dataset.src && !source.getAttribute('src')) {
        source.setAttribute('src', source.dataset.src);
        video.load();
      }
    }

    /* ── Hero: los tres clips se turnan con fundido ── */
    function initHero() {
      const clips = Array.from(document.querySelectorAll('.auto-hero__clip'));
      if (!clips.length || clips[0].dataset.heroReady === '1') return;
      clips.forEach((clip) => {
        clip.dataset.heroReady = '1';
      });

      loadVideo(clips[0]);
      clips[0].classList.add('is-active');

      if (reduced() || clips.length < 2) return;

      let index = 0;
      const advance = () => {
        const next = (index + 1) % clips.length;
        loadVideo(clips[next]);
        clips[next].classList.add('is-active');
        clips[next].play().catch(() => {});
        clips[index].classList.remove('is-active');
        const leaving = clips[index];
        window.setTimeout(() => {
          if (!leaving.classList.contains('is-active')) leaving.pause();
        }, 1200);
        index = next;
      };

      clips[0].play().catch(() => {});
      window.clearInterval(heroTimer);
      heroTimer = window.setInterval(advance, 5200);
    }

    /* ── Vídeos de plantilla: cargan y se pausan según viewport ── */
    function initCaseVideos() {
      const videos = document.querySelectorAll('.case__video');
      if (!videos.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target;
            if (entry.isIntersecting) {
              loadVideo(video);
              if (!reduced()) video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        },
        { rootMargin: '200px 0px', threshold: 0.1 },
      );

      videos.forEach((video) => {
        if (video.dataset.caseReady === '1') return;
        video.dataset.caseReady = '1';
        observer.observe(video);
      });
    }

    /* ── Conversación sincronizada con las cuatro acciones ── */
    function setStage(stage) {
      document.querySelectorAll('.flow__step').forEach((step) => {
        const value = Number(step.dataset.stage);
        step.classList.toggle('is-done', value < stage);
        step.classList.toggle('is-active', value === stage);
      });
      const rail = document.querySelector('.flow__rail i');
      if (rail) {
        rail.style.setProperty(
          '--flow-progress',
          `${(Math.max(0, stage) / 3) * 100}%`,
        );
      }
    }

    function addMessage(box, message) {
      const element = document.createElement('div');
      element.className = `bubble bubble--${message.from}`;
      element.textContent = message.text;
      box.appendChild(element);
      box.scrollTop = box.scrollHeight;
    }

    function runChat(box) {
      window.clearTimeout(chatTimer);
      box.replaceChildren();
      setStage(-1);
      let index = 0;

      const step = () => {
        if (!box.isConnected) return;
        if (index >= SCRIPT.length) {
          chatTimer = window.setTimeout(() => runChat(box), 4600);
          return;
        }

        const message = SCRIPT[index++];
        setStage(message.stage);

        if (message.from === 'bot') {
          const typing = document.createElement('div');
          typing.className = 'bubble bubble--bot bubble--typing';
          typing.innerHTML = '<i></i><i></i><i></i>';
          box.appendChild(typing);
          box.scrollTop = box.scrollHeight;
          chatTimer = window.setTimeout(() => {
            typing.remove();
            addMessage(box, message);
            chatTimer = window.setTimeout(step, 1250);
          }, 850);
          return;
        }

        addMessage(box, message);
        chatTimer = window.setTimeout(step, 1050);
      };

      step();
    }

    function initChat() {
      const box = document.getElementById('automation-chat-messages');
      if (!box || box.dataset.ready === '1') return;
      box.dataset.ready = '1';

      if (reduced()) {
        SCRIPT.forEach((message) => addMessage(box, message));
        setStage(3);
        return;
      }

      chatObserver?.disconnect();
      chatObserver = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          chatObserver.disconnect();
          runChat(box);
        },
        { threshold: 0.28 },
      );
      chatObserver.observe(box);
    }

    function initAll() {
      initHero();
      initCaseVideos();
      initChat();
    }

    initAll();
    document.addEventListener('astro:page-load', initAll);
    document.addEventListener('astro:before-swap', () => {
      window.clearInterval(heroTimer);
      window.clearTimeout(chatTimer);
    });
  })();
</script>

<style>
  .automation-page {
    --accent: var(--auto-accent);
    --muted: var(--auto-text-secondary);
    --line: var(--auto-border);
    overflow-x: clip;
  }

  .auto-kicker {
    display: inline-block;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: var(--step--2);
  }

  /* ═══════════ HERO ═══════════ */

  .auto-hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(92svh, 780px);
    padding-block: var(--space-3xl) var(--space-2xl);
    isolation: isolate;
    overflow: hidden;
  }

  .auto-hero__stage {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .auto-hero__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }

  .auto-hero__clip.is-active {
    opacity: 1;
  }

  .auto-hero__scrim {
    position: absolute;
    inset: 0;
    /* Viñeteado simétrico: el contraste para el texto lo da la base, no un
       degradado lateral, que hacía leer el vídeo como desplazado a la derecha. */
    background:
      linear-gradient(
        to top,
        var(--auto-bg) 3%,
        rgba(13, 17, 23, 0.8) 34%,
        rgba(13, 17, 23, 0.42) 72%,
        rgba(13, 17, 23, 0.5) 100%
      ),
      radial-gradient(
        125% 95% at 50% 42%,
        transparent 28%,
        rgba(13, 17, 23, 0.58) 100%
      );
  }

  .auto-hero__inner {
    position: relative;
  }

  .auto-hero h1 {
    display: grid;
    margin-block: var(--space-xs) var(--space-s);
    /* --step-5 no baja de 4.21rem y parte el titular en móvil */
    font-size: clamp(2.6rem, 10.5vw, 5.26rem);
    line-height: 0.94;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .auto-hero h1 em {
    font-style: normal;
    color: var(--accent);
  }

  .auto-hero p {
    max-width: 34ch;
    color: var(--muted);
    font-size: var(--step-0);
  }

  .auto-hero__jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-l);
  }

  .auto-hero__jump a {
    padding: 0.55em 1.1em;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(22, 27, 34, 0.65);
    backdrop-filter: blur(6px);
    font-size: var(--step--1);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .auto-hero__jump a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* ═══════════ CABECERAS ═══════════ */

  .auto-head {
    margin-bottom: var(--space-xl);
  }

  .auto-head h2 {
    margin-top: var(--space-2xs);
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }

  /* ═══════════ PLANTILLAS ═══════════ */

  .case-stack {
    display: grid;
    gap: var(--space-xl);
    width: 100%;
    max-width: 1600px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .case__media {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--auto-surface);
  }

  .case__video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .case__name {
    margin-top: var(--space-xs);
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  @media (min-width: 900px) {
    .case-stack {
      gap: var(--space-2xl);
    }

    .case {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: var(--space-m);
    }

    .case__name {
      margin: 0 0 var(--space-2xs);
      writing-mode: vertical-rl;
      font-size: var(--step-2);
      color: var(--muted);
    }
  }

  /* ═══════════ FLUJO DE NEGOCIO ═══════════ */

  .flow {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 900px) {
    .flow {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: var(--space-2xl);
      align-items: center;
    }
  }

  .phone {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--auto-surface);
  }

  .phone__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-xs) var(--space-s);
    border-bottom: 1px solid var(--line);
  }

  .phone__avatar {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--auto-bg);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .phone__messages {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    min-height: 19rem;
    max-height: 19rem;
    padding: var(--space-s);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  /* Las burbujas las crea el JS, así que no llevan el atributo de scope de
     Astro. Se estilan con :global() colgando del contenedor, que sí lo lleva. */
  .phone__messages :global(.bubble) {
    max-width: 82%;
    padding: 0.6em 0.9em;
    border-radius: var(--radius-md);
    font-size: var(--step--1);
    line-height: 1.45;
    animation: bubble-in 320ms var(--ease-out) both;
  }

  .phone__messages :global(.bubble--user) {
    align-self: flex-end;
    background: rgba(255, 255, 255, 0.07);
    border-bottom-right-radius: var(--radius-sm);
  }

  .phone__messages :global(.bubble--bot) {
    align-self: flex-start;
    background: var(--accent);
    color: var(--auto-bg);
    border-bottom-left-radius: var(--radius-sm);
  }

  .phone__messages :global(.bubble--typing) {
    display: flex;
    gap: 0.28rem;
    padding: 0.85em 0.9em;
  }

  .phone__messages :global(.bubble--typing i) {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
    animation: typing 1s ease-in-out infinite;
  }

  .phone__messages :global(.bubble--typing i:nth-child(2)) {
    animation-delay: 0.15s;
  }

  .phone__messages :global(.bubble--typing i:nth-child(3)) {
    animation-delay: 0.3s;
  }

  .phone__input {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xs) var(--space-s);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--step--2);
  }

  /* ── Los cuatro estados ── */

  .flow__steps {
    position: relative;
    display: grid;
    gap: var(--space-m);
    padding-left: var(--space-m);
  }

  .flow__rail {
    position: absolute;
    top: 0.6rem;
    bottom: 0.6rem;
    left: 0.3rem;
    width: 1px;
    background: var(--line);
  }

  .flow__rail i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    height: var(--flow-progress, 0%);
    background: var(--accent);
    transition: height var(--duration-slow) var(--ease-out);
  }

  .flow__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: calc(var(--space-m) * -1);
    padding-left: var(--space-m);
    color: var(--muted);
    font-size: var(--step-0);
    transition: color var(--duration-base) var(--ease-out);
  }

  .flow__dot {
    position: absolute;
    left: 0;
    width: 0.65rem;
    height: 0.65rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--auto-bg);
    transition:
      background var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .flow__step.is-done,
  .flow__step.is-active {
    color: var(--auto-text);
  }

  .flow__step.is-done .flow__dot,
  .flow__step.is-active .flow__dot {
    background: var(--accent);
    border-color: var(--accent);
  }

  .flow__step.is-active .flow__dot {
    transform: scale(1.35);
    box-shadow: 0 0 0 4px rgba(57, 211, 83, 0.16);
  }

  @keyframes bubble-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @keyframes typing {
    50% {
      opacity: 1;
      transform: translateY(-2px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .auto-hero__clip,
    .flow__rail i,
    .flow__dot,
    .flow__step {
      transition: none;
    }

    .phone__messages :global(.bubble),
    .phone__messages :global(.bubble--typing i) {
      animation: none;
    }
  }
</style>
