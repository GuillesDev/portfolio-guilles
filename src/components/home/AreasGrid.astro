---
import SectionHeading from '../global/SectionHeading.astro';
import AreaCard from './AreaCard.astro';
---

<section class="areas section" id="areas">
  <div class="container">
    <SectionHeading
      label="Portfolio"
      title="Lo que hago"
      align="center"
    />

    <div class="areas__grid" data-animate="stagger">
      <AreaCard
        title="Grafismo en TV"
        description="Rótulos, cabeceras y motion para directo."
        href="/grafismo"
        theme="grafismo"
        label="Broadcast"
        image="/media/grafismo/sin-ia/eurocopa-poster.jpg"
        video="/media/grafismo/sin-ia/eurocopa.mp4"
      />
      <AreaCard
        title="Automatización"
        description="Sistemas que eliminan tareas repetitivas."
        href="/automatizacion"
        theme="automatizacion"
        label="Sistemas"
        image="/media/automatizacion/cartelas-si-poster.jpg"
        video="/media/automatizacion/cartelas-si-holo.mp4"
      />
      <AreaCard
        title="Desarrollo Web"
        description="Diseño y desarrollo de productos digitales."
        href="/desarrollo"
        theme="desarrollo"
        label="Digital"
        image="/media/blackgum/cinematic-reveal-poster.jpg"
        video="/media/blackgum/cinematic-reveal.mp4"
      />
      <AreaCard
        title="Fratelli Pazzi"
        description="Una marca construida dentro de un negocio real."
        href="/fratelli-pazzi"
        theme="fratelli"
        label="Negocio"
        image="/media/fratelli/videos/timelapse-pizza-v2-poster.jpg"
        video="/media/fratelli/videos/timelapse-pizza-v2.web.mp4"
      />
    </div>
  </div>
</section>

<style>
  .areas {
    padding-top: var(--space-l);
  }

  .areas__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-m);
  }

  @media (max-width: 768px) {
    .areas__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
