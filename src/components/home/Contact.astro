---
import Button from '../global/Button.astro';
import { social } from '../../data/site';

const projectMail = `mailto:${social.email}?subject=${encodeURIComponent('Proyecto · Portfolio Guillermo López')}&body=${encodeURIComponent('Hola Guillermo,\n\nTe escribo porque necesito ayuda con:\n\n[ ] Grafismo / motion\n[ ] Automatización\n[ ] Desarrollo web\n[ ] Marca y contenido\n\nContexto del proyecto:\n\nPlazo aproximado:\n\nGracias.')}`;
---

<section class="contact section" id="contacto">
  <div class="container">
    <div class="contact__inner">
      <span class="contact__label mono" data-animate="fade-up">Contacto</span>

      <h2 class="contact__title" data-animate="title-reveal">
        <span class="title-line"><span class="title-line__inner">Cuéntame qué necesitas</span></span>
      </h2>

      <p class="contact__text" data-animate="fade-up">
        Grafismo, motion o automatización. Cuéntame el proyecto y vemos si encaja.
      </p>

      <div class="contact__services" data-animate="fade-up" aria-label="Servicios">
        <span>Grafismo y motion</span>
        <span>Automatización</span>
        <span>Desarrollo web</span>
        <span>Marca y contenido</span>
      </div>

      <div class="contact__actions" data-animate="fade-up">
        <Button href={projectMail} variant="primary" size="lg">
          Contar mi proyecto
        </Button>
        <Button href={social.linkedin} variant="secondary" size="lg" external>
          LinkedIn
        </Button>
        <Button href="/cv/guillermo-lopez-cv.pdf" variant="ghost" size="md" download>
          Descargar CV ↓
        </Button>
      </div>

      <div class="contact__email mono" data-animate="fade-up">
        {social.email}
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
  }

  .contact::before {
    content: '';
    position: absolute;
    bottom: -40%;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    height: 80%;
    background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.10) 0%, transparent 70%);
    pointer-events: none;
  }

  .contact__inner {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .contact__label {
    display: inline-block;
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-m);
  }

  .contact__title {
    font-size: var(--step-4);
    color: var(--color-primary);
    margin-bottom: var(--space-m);
  }

  .contact__text {
    font-size: var(--step-0);
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-xl);
    margin-inline: auto;
  }

  .contact__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-s);
    flex-wrap: wrap;
    margin-bottom: var(--space-l);
  }

  .contact__services {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: calc(var(--space-xl) * -0.45) auto var(--space-l);
  }

  .contact__services span {
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: var(--step--2);
  }

  .contact__email {
    font-size: var(--step--1);
    color: var(--color-text-secondary);
    letter-spacing: 0.02em;
  }

  @media (max-width: 640px) {
    .contact__actions {
      flex-direction: column;
    }
  }
</style>
