---
import Button from '../global/Button.astro';
---

<section class="hero">
  <div class="hero__bg">
    <video
      class="hero__reel"
      id="hero-reel"
      muted
      playsinline
      preload="none"
    ></video>
    <div class="hero__reel-overlay"></div>
    <div class="hero__gradient"></div>
    <div class="hero__grid"></div>
  </div>

  <div class="hero__content container">
    <h1 class="hero__title" id="hero-title">
      <span class="hero__line"><span class="hero__line-inner">Guillermo</span></span>
      <span class="hero__line"><span class="hero__line-inner hero__title-accent">López</span></span>
    </h1>

    <div class="hero__actions" data-animate="fade-up">
      <Button href="#areas" variant="primary" size="lg">Ver portfolio</Button>
      <Button href="/cv/guillermo-lopez-cv.pdf" variant="secondary" size="lg" download>
        Descargar CV ↓
      </Button>
    </div>

    <div class="hero__proof" data-animate="fade-up" aria-label="Experiencia destacada">
      <span class="hero__proof-label mono">Experiencia con</span>
      <span>Mediaset</span>
      <span>RTVE</span>
      <span>Movistar+</span>
      <span>Producciones Mandarina</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  /* Background effects */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__reel {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s ease;
  }

  .hero__reel.is-playing {
    opacity: 0.2;
  }

  .hero__reel-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 80% 70% at 50% 50%,
      transparent 0%,
      var(--color-bg) 75%
    );
    z-index: 1;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(59, 130, 246, 0.18) 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 20% 60%, rgba(59, 130, 246, 0.07) 0%, transparent 50%),
      radial-gradient(ellipse 60% 40% at 80% 80%, rgba(59, 130, 246, 0.10) 0%, transparent 50%);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: 3;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black, transparent);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, black, transparent);
  }

  /* Content */
  .hero__content {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--space-3xl) + 80px);
    padding-bottom: var(--space-3xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__title {
    font-size: clamp(3rem, 11.3vw, 10.25rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: var(--color-primary);
    margin-bottom: var(--space-m);
    max-width: 100%;
  }

  .hero__line {
    display: block;
    overflow: hidden;
    /* Breathing room so descenders and the accent gradient don't get clipped */
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }

  .hero__line-inner {
    display: inline-block;
    transform: translateY(112%);
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line-inner {
      transform: none;
    }
  }

  .hero__title-accent {
    background: linear-gradient(135deg, #FAFAFA 20%, var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    gap: var(--space-s);
    flex-wrap: wrap;
  }

  .hero__proof {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin-top: var(--space-l);
    color: rgba(255, 255, 255, 0.62);
    font-size: var(--step--2);
  }

  .hero__proof-label {
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .hero__proof span:not(.hero__proof-label) {
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .hero__content {
      padding-top: calc(var(--space-2xl) + 60px);
    }

    .hero__title {
      font-size: clamp(2.4rem, 14vw, 4.5rem);
      line-height: 0.95;
      letter-spacing: -0.04em;
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__proof {
      max-width: 30ch;
      margin-top: var(--space-m);
    }

    .hero__reel.is-playing {
      opacity: 0.14;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  function initHeroIntro() {
    const title = document.getElementById('hero-title');
    if (!title) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const lines = title.querySelectorAll('.hero__line-inner');

    if (reduced) {
      gsap.set(lines, { clearProps: 'transform' });
      return;
    }

    // The CSS sets translateY(112%) as the pre-JS hidden state; GSAP parses that
    // into a px-based `y`, so reset it explicitly and animate yPercent instead.
    gsap.fromTo(
      lines,
      { y: 0, yPercent: 112 },
      { yPercent: 0, duration: 1.1, ease: 'power4.out', stagger: 0.12, delay: 0.15 }
    );
  }

  document.addEventListener('astro:page-load', initHeroIntro);

  function initHeroReel() {
    // Respect reduced-motion: keep the static gradient background, skip the video reel
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const video = document.getElementById('hero-reel') as HTMLVideoElement | null;
    if (!video) return;
    const heroVideo: HTMLVideoElement = video;

    // Curated lightweight reel: keep the hero expressive without cycling
    // through the multi-megabyte showcase masters.
    const videos = [
      '/media/grafismo/ia/abascal-wars.mp4',
      '/media/grafismo/ia/begona-desafiante.mp4',
      '/media/grafismo/ia/hulk-sanchez.mp4',
      '/media/grafismo/ia/los-panceta.mp4',
      '/media/grafismo/ia/personas-bestias.mp4',
      '/media/grafismo/ia/sanchez-esqui.mp4',
      '/media/grafismo/ia/trileros-sanchez-trump.mp4',
    ];

    let index = Math.floor(Math.random() * videos.length);

    function playNext() {
      // Fade out
      heroVideo.classList.remove('is-playing');

      setTimeout(() => {
        heroVideo.src = videos[index];
        index = (index + 1) % videos.length;

        heroVideo.load();
        heroVideo.play().then(() => {
          heroVideo.classList.add('is-playing');
        }).catch(() => {});
      }, 1500); // wait for fade-out
    }

    heroVideo.addEventListener('ended', playNext);

    // Start first video
    heroVideo.src = videos[index];
    index = (index + 1) % videos.length;
    heroVideo.load();
    heroVideo.play().then(() => {
      heroVideo.classList.add('is-playing');
    }).catch(() => {});
  }

  document.addEventListener('astro:page-load', initHeroReel);
</script>
