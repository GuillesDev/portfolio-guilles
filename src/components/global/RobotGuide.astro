---
/**
 * RobotGuide — persistent robot mascot that guides visitors through the
 * portfolio. Lives fixed at the bottom-right corner on every page, follows
 * the cursor with its gaze, celebrates as you scroll and complains if you
 * click (hit) it. Its eyes and chest light tint themselves with each page's
 * palette so it blends into every section. When it first appears it makes a
 * rocket entrance and waves hello. On /desarrollo it stays offstage until
 * you scroll past the hero (its big twin lives there).
 * Runs everywhere ≥320px: compact + lighter rendering (no MSAA, capped DPR)
 * under 1025px, where the grafismo chair setup also falls back to the normal
 * tour bubble. Respects prefers-reduced-motion; Three.js loads lazily.
 */
---

<div class="rg rg--offstage" id="robot-guide" transition:persist="robot-guide">
  <div
    class="rg__mount"
    id="rg-mount"
    title="Pregúntame sobre Guille"
    role="button"
    tabindex="0"
    aria-label="Abrir el asistente de Guillermo"
    aria-controls="rg-chat"
    aria-expanded="false"
  ></div>
  <div class="rg__work-pop" id="rg-work-pop">No me molestes, estoy trabajando.</div>
  <section class="rg__chat" id="rg-chat" aria-label="Asistente de Guillermo" hidden>
    <header class="rg__chat-head">
      <div>
        <span class="rg__chat-status" aria-hidden="true"></span>
        <strong>Pregúntame</strong>
      </div>
      <div class="rg__chat-actions">
        <button
          class="rg__chat-close rg__chat-mute"
          id="rg-chat-mute"
          type="button"
          aria-pressed="false"
          aria-label="Silenciar la voz del robot"
          title="Silenciar la voz del robot"
        >
          <span aria-hidden="true"></span>
        </button>
        <button
          class="rg__chat-close rg__chat-clear"
          id="rg-chat-clear"
          type="button"
          aria-label="Limpiar la conversación"
          title="Limpiar la conversación"
        >↺</button>
        <button class="rg__chat-close" id="rg-chat-close" type="button" aria-label="Cerrar asistente">×</button>
      </div>
    </header>

    <div class="rg__chat-messages" id="rg-chat-messages" aria-live="polite">
      <div class="rg__chat-message rg__chat-message--bot">
        Hola, soy el bot de Guille. Pregúntame por su trabajo, experiencia o cómo contactar con él.
      </div>
    </div>

    <div class="rg__chat-prompts" id="rg-chat-prompts" aria-label="Preguntas sugeridas">
      <button type="button" data-rg-question="¿Qué hace Guille?">Qué hace</button>
      <button type="button" data-rg-question="¿Qué experiencia tiene?">Experiencia</button>
      <button type="button" data-rg-question="¿Cómo contacto con él?">Contacto</button>
    </div>

    <form class="rg__chat-form" id="rg-chat-form">
      <label class="rg__sr-only" for="rg-chat-input">Haz una pregunta sobre Guillermo</label>
      <input
        id="rg-chat-input"
        name="question"
        type="text"
        maxlength="180"
        autocomplete="off"
        placeholder="Escribe una pregunta…"
      />
      <button type="submit" aria-label="Enviar pregunta">→</button>
    </form>
  </section>
</div>

<script>
  import { navigate } from 'astro:transitions/client';

  // ── Robot guide singleton (survives View Transitions via transition:persist) ──
  const MESSAGES: Record<string, { sel: string; html: string }[]> = {
    '/': [
      { sel: '.hero', html: '¡Hola! 👋 Soy el bot de Guille. Haz scroll, que te enseño esto.' },
      { sel: '.value', html: 'Resumen: diseña, automatiza y construye. Todo en una persona.' },
      { sel: '.areas', html: 'Sus cuatro mundos. Pícale a cualquiera, yo te sigo.' },
      { sel: '.about', html: '5+ años de grafismo en directo: Mediaset, RTVE, Movistar+…' },
      { sel: '.contact', html: '¿Te cuadra? Escríbele. O sigue el tour: <a href="/grafismo">Grafismo →</a>' },
    ],
