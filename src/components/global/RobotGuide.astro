        text: '¡Hola! Soy el robot de este portfolio. Puedo contarte sobre el grafismo de televisión de Guille, sus automatizaciones, sus webs o Fratelli Pazzi. ¿Por dónde empezamos?',
        href: '/#areas',
        action: 'Ver sus áreas',
      };
    }
    if (/^(que tal|que tal estas|como estas|como te va|como va|como andas|todo bien|que tal todo|como estamos)$/.test(plain)) {
      return {
        text: 'Muy bien, gracias por preguntar. Aquí sigo, enseñando el trabajo de Guille. ¿Te interesa más el grafismo de televisión, las automatizaciones o el desarrollo web?',
        href: '/#areas',
        action: 'Ver sus áreas',
      };
    }
    if (/^(gracias|muchas gracias|mil gracias|ok gracias|vale gracias|genial gracias|perfecto gracias)$/.test(plain)) {
      return {
        text: 'A ti. Si te queda cualquier duda sobre su trabajo, pregúntame.',
      };
    }
    if (/^(adios|hasta luego|hasta pronto|nos vemos|chao|chau|bye|me voy|hasta la vista)$/.test(plain)) {
      return {
        text: '¡Hasta luego! Si quieres contarle un proyecto, Guille está a un correo de distancia.',
        href: '/#contacto',
        action: 'Ir a Contacto',
      };
    }
    if (/(que eres|quien eres|eres una ia|eres un bot|eres un robot|eres humano|eres real|como te llamas|cual es tu nombre)/.test(q)) {
      return {
        text: 'Soy el robot guía de este portfolio: una IA pequeña que conoce el trabajo de Guille y te lleva a la parte que te interese.',
      };
    }
    if (/(que puedes hacer|que sabes hacer|para que sirves|que puedo preguntar|en que puedes ayudar|como funcionas)/.test(q)) {
      return {
        text: 'Puedo contarte cuatro cosas: grafismo para televisión, automatizaciones, desarrollo web y Fratelli Pazzi. Y te llevo a la sección que quieras ver.',
        href: '/#areas',
        action: 'Ver sus áreas',
      };
    }
    if (/(chiste|una broma|hazme reir|algo gracioso|cuentame algo divertido)/.test(q)) {
      const jokes = [
        'Te contaría un chiste sobre After Effects, pero todavía se está renderizando.',
        'Un render y yo nos parecemos: los dos llegamos al 99 % y ahí nos quedamos un rato.',
        'Los grafistas no juegan al escondite: siempre los delatan las capas sin nombrar.',
