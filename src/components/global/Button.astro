---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
  download?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  download = false,
} = Astro.props;

const Tag = href ? 'a' : 'button';
// `download` va como cadena vacía, no como `true`: al ser <Tag> dinámico, Astro
// no lo trata como atributo booleano y escribía download="true", que es el
// nombre con el que el navegador guardaba el archivo. El CV se descargaba
// llamándose "true".
const externalAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`]}
  download={download ? '' : undefined}
  {...externalAttrs}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    font-family: 'JetBrains Mono', monospace;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
    white-space: nowrap;
  }

  /* Sizes */
  .btn--sm {
    font-size: var(--step--2);
    padding: 0.5em 1.2em;
  }

  .btn--md {
    font-size: var(--step--1);
    padding: 0.75em 1.8em;
  }

  .btn--lg {
    font-size: var(--step-0);
    padding: 0.9em 2.2em;
  }

  /* Variants */
  .btn--primary {
    background: var(--color-primary);
    color: var(--color-bg);
    border-radius: var(--radius-sm);
  }

  .btn--primary:hover {
    background: var(--color-accent);
    color: #fff;
    transform: translateY(-1px);
  }

  .btn--secondary {
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .btn--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-text-secondary);
    padding-inline: 0;
  }

  .btn--ghost:hover {
    color: var(--color-primary);
  }
</style>

<script>
  import { playSound } from '../../lib/uiSound';

  function initMagneticButtons() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) return;

    document.querySelectorAll<HTMLElement>('.btn').forEach((btn) => {
      if (btn.dataset.magnetic) return;
      btn.dataset.magnetic = '1';

      btn.addEventListener('mousemove', (event) => {
        const rect = btn.getBoundingClientRect();
        const x = event.clientX - rect.left - rect.width / 2;
        const y = event.clientY - rect.top - rect.height / 2;
        btn.style.transform = `translate(${x * 0.12}px, ${y * 0.3}px)`;
      });

      btn.addEventListener('mouseleave', () => {
        btn.style.transform = '';
      });
    });
  }

  // Aparte del magnético: el click debe sonar en cualquier dispositivo, no
  // solo con ratón fino. El principal es una acción afirmativa ("enviar"),
  // el resto un clic neutro. Los botones son contenido de página: sus
  // listeners mueren en cada swap, así que no se acumulan.
  function initButtonSounds() {
    document.querySelectorAll<HTMLElement>('.btn').forEach((btn) => {
      if (btn.dataset.sndBound) return;
      btn.dataset.sndBound = '1';
      const sonido = btn.classList.contains('btn--primary') ? 'enviar' : 'nav';
      btn.addEventListener('click', () => playSound(sonido));
    });
  }

  document.addEventListener('astro:page-load', () => {
    initMagneticButtons();
    initButtonSounds();
  });
</script>
