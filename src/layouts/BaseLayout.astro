---
import '@fontsource-variable/inter';
import '@fontsource-variable/syne';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';
import '../styles/animations.css';
import { site, social } from '../data/site';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import RobotGuide from '../components/global/RobotGuide.astro';
import RobotLoader from '../components/global/RobotLoader.astro';
import { ViewTransitions } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = site.title,
  description = site.description,
  ogImage = site.ogImage,
} = Astro.props;

// Sin barra final, como los enlaces del menú y el sitemap. Al compilar, Astro
// da las rutas como "/grafismo/" y Vercel sirve las dos formas: una URL
// canónica distinta de la enlazada confunde a los buscadores.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalURL = new URL(canonicalPath, site.url);
const ogImageURL = new URL(ogImage, site.url).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName,
  alternateName: site.name,
  url: site.url,
  email: social.email,
  jobTitle: 'Grafista, automatización con IA, desarrollo web y gestión de marca',
  sameAs: [social.linkedin],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- View Transitions -->
    <ViewTransitions />
    <!-- La marca se lee antes del primer pintado para evitar un destello al navegar. -->
    <script is:inline>
      try {
        if (!sessionStorage.getItem('gl-loader-seen') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('gl-intro');
          window.__glLoaderState = 'pending';
          window.__glLoaderStart = performance.now();
        }
      } catch (_) { /* La página queda visible si el almacenamiento está bloqueado. */ }
    </script>
  </head>
  <body>
    <RobotLoader />

    <div class="gl-page" id="gl-page">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <RobotGuide />

    <!-- GSAP -->
    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      function initAnimations() {
        // Kill old ScrollTrigger instances to prevent duplicates across View Transitions
        ScrollTrigger.getAll().forEach(st => st.kill());
        ScrollTrigger.refresh();

        // Respect reduced-motion: reveal everything statically, skip scroll/parallax animations
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          gsap.utils.toArray<HTMLElement>('[data-animate], [data-parallax]').forEach((el) => {
            gsap.set(el, { clearProps: 'all', opacity: 1, x: 0, y: 0, scale: 1 });
          });
          return;
        }

        // Fade up elements
        gsap.utils.toArray<HTMLElement>('[data-animate="fade-up"]').forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, y: 40 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Stagger elements inside containers
        gsap.utils.toArray<HTMLElement>('[data-animate="stagger"]').forEach((container) => {
          const children = container.children;
          gsap.fromTo(
            children,
            { opacity: 0, y: 30 },
            {
              opacity: 1,
              y: 0,
              duration: 0.6,
              stagger: 0.15,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: container,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Masked line reveal for section titles (pre-wrapped in .title-line spans)
        gsap.utils.toArray<HTMLElement>('[data-animate="title-reveal"]').forEach((el) => {
          const inners = el.querySelectorAll('.title-line__inner');
          if (!inners.length) return;
          // The CSS hidden state is translateY(112%); reset the parsed px `y`
          // and animate yPercent so the tween lands exactly at 0.
          gsap.fromTo(
            inners,
            { y: 0, yPercent: 112 },
            {
              yPercent: 0,
              duration: 1,
              ease: 'power4.out',
              stagger: 0.1,
              scrollTrigger: {
                trigger: el,
                start: 'top 88%',
                once: true,
              },
            }
          );
        });

        // Scale in
        gsap.utils.toArray<HTMLElement>('[data-animate="scale-in"]').forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, scale: 0.92 },
            {
              opacity: 1,
              scale: 1,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Slide in left
        gsap.utils.toArray<HTMLElement>('[data-animate="slide-left"]').forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, x: -50 },
            {
              opacity: 1,
              x: 0,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Slide in right
        gsap.utils.toArray<HTMLElement>('[data-animate="slide-right"]').forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, x: 50 },
            {
              opacity: 1,
              x: 0,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: {
                trigger: el,
                start: 'top 85%',
                once: true,
              },
            }
          );
        });

        // Parallax
        gsap.utils.toArray<HTMLElement>('[data-parallax]').forEach((el) => {
          const speed = parseFloat(el.dataset.parallax || '0.2');
          gsap.to(el, {
            yPercent: speed * 100,
            ease: 'none',
            scrollTrigger: {
              trigger: el,
              start: 'top bottom',
              end: 'bottom top',
              scrub: true,
            },
          });
        });
      }

      // Scroll to hash target after View Transitions (fixes /#contacto)
      function handleHashScroll() {
        const hash = window.location.hash;
        if (hash) {
          const target = document.querySelector(hash);
          if (target) {
            // Wait a tick for layout to settle after View Transition
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                target.scrollIntoView({ behavior: 'smooth' });
              });
            });
          }
        }
      }

      // Init on page load and after view transitions
      document.addEventListener('astro:page-load', () => {
        initAnimations();
        handleHashScroll();
      });
    </script>

    <style is:global>
      .gl-page { opacity: 1; }
      html.gl-intro .gl-page { opacity: 0; visibility: hidden; }
      html.gl-intro.gl-loader--flight .gl-page,
      .gl-page--visible { opacity: 1 !important; visibility: visible !important; }
      html.gl-intro.gl-loader--flight .gl-page { transition: opacity 0.65s ease; }
    </style>
  </body>
</html>
