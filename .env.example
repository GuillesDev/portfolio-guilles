# NVIDIA Build / NIM
# Keep the real value only in .env locally and in Vercel Environment Variables.
NVIDIA_API_KEY=nvapi-your-key-here

# Optional: an extra NVIDIA model that joins the race of models
# (see DEFAULT_MODELS in src/pages/api/robot-chat.ts).
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
